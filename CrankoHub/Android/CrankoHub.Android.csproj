<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Versão Android do CrankoHub (.NET MAUI Blazor Hybrid).
    Usa o núcleo (Core: telas, modelos e serviços) e o wwwroot do projeto Windows (por link);
    só a janela (BlazorWebView do MAUI) e as partes de plataforma são trocadas (pasta Plataforma).
    Distribuído como APK no GitHub Releases (fora da Play Store).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CrankoHub</RootNamespace>
    <AssemblyName>CrankoHub</AssemblyName>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

    <Version>1.0.0</Version>
    <Product>CrankoHub</Product>
    <Authors>Diego Ottani</Authors>
    <Company>CrankosEnterprise</Company>
    <Description>Painel pessoal de parâmetros: dieta, carro e mais.</Description>

    <ApplicationTitle>CrankoHub</ApplicationTitle>
    <ApplicationId>com.crankosenterprise.crankohub</ApplicationId>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- O Android compara versões por um número inteiro: 1.2.3 vira 10203 -->
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse($(Version)).Major), 10000)), $([MSBuild]::Multiply($([System.Version]::Parse($(Version)).Minor), 100)))), $([System.Math]::Max($([System.Version]::Parse($(Version)).Build), 0))))</ApplicationVersion>
  </PropertyGroup>

  <!-- Publicação: um APK só (todas as arquiteturas), assinado com a chave passada pelo CI -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">true</AndroidKeyStore>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <!-- Reduz as capas do Entretenimento (Core/Services/Entretenimento/CapasService.cs) -->
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Barras "/" no Link: no Linux (CI) a "\" não é separador e o Resizetizer leria "Resources\Splash\splash" como nome -->
    <MauiIcon Include="icone-frente.png" Link="Resources/AppIcon/appicon.png" Color="#101C40" ForegroundScale="0.8" />
    <MauiSplashScreen Include="icone-frente.png" Link="Resources/Splash/splash.png" Color="#101C40" BaseSize="160,160" />
  </ItemGroup>

  <!-- Telas, modelos, regras e serviços compartilhados -->
  <ItemGroup>
    <ProjectReference Include="..\Core\CrankoHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Peças da versão Linux que servem igual aqui -->
    <Compile Include="..\Linux\Plataforma\ArquivosDoApp.cs" Link="Plataforma\%(Filename)%(Extension)" />

    <!-- O index.html é o da pasta Android/wwwroot (com autostart="false"): o da versão Windows trava no "Carregando…" -->
    <Content Include="..\wwwroot\**\*" Exclude="..\wwwroot\index.html" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
