<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- allowBackup=false: a sessão da conta e os dados não vão para o backup do Google -->
	<application android:allowBackup="false" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:label="CrankoHub"></application>
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<!-- Avisos de vencimento (Android 13+) -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Atualização: abre o instalador com o APK novo baixado do GitHub Releases -->
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	<!-- Modo Carro: onde estacionou e a busca de destino perto de você (GPS) -->
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<!-- Modo Carro, Bluetooth do carro (CarroBluetoothService): reconhecer a central e listar os pareados -->
	<uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
	<uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
	<!-- Barra da música por cima do Maps/Waze (BarraCarroService) e abrir o Modo Carro sozinho quando o carro conecta -->
	<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
	<!-- A barra roda num serviço em primeiro plano ("Modo Carro ativo"); com a localização, guarda onde estacionou com o app atrás do Maps -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
	<!-- Guardar onde estacionou sem o Modo Carro ativo (opcional) -->
	<uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
	<!-- O Android não atrasar o aviso do Bluetooth do carro (pedido nas Configurações) -->
	<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
	<!-- Modo Carro: abrir Waze, Maps e Spotify (visibilidade de pacotes no Android 11+) -->
	<queries>
		<package android:name="com.waze" />
		<package android:name="com.google.android.apps.maps" />
		<package android:name="com.spotify.music" />
	</queries>
</manifest>
