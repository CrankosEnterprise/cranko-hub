<Window x:Class="CrankoHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:CrankoHub"
        x:Name="janela"
        Title="CrankoHub"
        Height="820" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icone.ico"
        Background="#E9EBEF">

    <!-- Sem a barra de título do Windows: a página ocupa a janela inteira e desenha a própria barra
         (semáforo, menu em cápsula, ações). Arrastar, maximizar e redimensionar vêm da página (JanelaService). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="raiz">
        <blazor:BlazorWebView x:Name="blazorWebView"
                              HostPage="wwwroot\index.html"
                              Services="{DynamicResource services}"
                              BlazorWebViewInitializing="AoInicializarWebView"
                              BlazorWebViewInitialized="AoWebViewPronto">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:Main}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
