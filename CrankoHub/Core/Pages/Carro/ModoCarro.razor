@namespace CrankoHub.Pages
@page "/carro/modo"
@layout LayoutCarro
@* Modo Carro: tela rápida para escolher o app (Google Maps ou Waze) e o destino. Ao escolher, o CrankoHub abre o app já
   navegando e liga o aviso de radar por cima dele (Android/Plataforma/RadarCarroService.cs) até sair do Modo Carro.
   Só funciona no Android (IModoCarroService); no Windows/Linux a página explica isso. *@
@implements IDisposable
@inject IModoCarroService Modo
@inject BuscaLugares Busca
@inject ICarroBluetoothService Bluetooth
@inject ArmazenamentoService Store
@inject ToastService Toast
@inject NavigationManager Nav

@{
    var app = AppsCarro.NavegacaoValida(Store.Dados.Config.AppNavegacaoCarro);
}

<div class="modo-carro">
    <header class="mc-status">
        <b class="mc-hora">@DateTime.Now.ToString("HH:mm")</b>
        <span class="mc-titulo">Modo Carro @if (Modo.Ativo) {<span class="mc-selo">ativo</span>}</span>
        @if (Modo.Ativo)
        {
            <button class="mc-btn" type="button" @onclick="Encerrar">@Icones.Fechar<span>Sair do Modo Carro</span></button>
        }
        <button class="mc-btn" type="button" aria-label="Voltar para o Carro" @onclick="Voltar">@Icones.Sair<span class="mc-some-estreito">Voltar</span></button>
    </header>

    @if (!Modo.Disponivel)
    {
        <section class="mc-card">
            <h2>Só no celular</h2>
            <p class="mc-texto-2">O Modo Carro avisa dos radares por cima do Google Maps ou do Waze do Android. Abra o CrankoHub no celular para usar.</p>
        </section>
    }
    else
    {
        var faltam = Bluetooth.Permissoes().Where(p => p.Id is PermissoesCarro.Sobrepor or PermissoesCarro.Localizacao && p.Ativada == false).ToList();
        @if (faltam.Count > 0)
        {
            <section class="mc-card mc-faltam">
                <h2>Falta liberar para o aviso de radar</h2>
                @foreach (var p in faltam)
                {
                    <PermissaoLinha @key="p.Id" Permissao="p" AoAtivar="Bluetooth.Ativar" Lista="true" />
                }
            </section>
        }

        <div class="mc-apps" role="radiogroup" aria-label="App de navegação">
            @foreach (var a in AppsCarro.Navegacao)
            {
                var opcao = a;
                <button type="button" role="radio" aria-checked="@(opcao == app)" class="mc-app @(opcao == app ? "ativa" : "")" @onclick="() => EscolherApp(opcao)">
                    @Icones.Navegacao<span>@AppsCarro.Nome(opcao)</span>
                </button>
            }
        </div>

        <section class="mc-card mc-destino">
            <label class="mc-busca">
                <span class="mc-busca-icone">@Icones.Busca</span>
                <input class="mc-busca-campo" type="search" placeholder="Para onde?" autocomplete="off" enterkeyhint="search"
                       value="@_termo" @oninput="Digitou" aria-label="Para onde?" />
                @if (_termo.Length > 0)
                {
                    <button class="mc-limpar" type="button" aria-label="Limpar a busca" @onclick="Limpar">@Icones.Fechar</button>
                }
            </label>
            <div class="mc-lugares">
                @if (string.IsNullOrWhiteSpace(_termo))
                {
                    @if (Busca.Recentes.Count == 0)
                    {
                        <p class="mc-texto-2">Digite um endereço, um lugar ou um estabelecimento.</p>
                    }
                    else
                    {
                        <small class="mc-lugares-titulo">Recentes</small>
                        @foreach (var l in Busca.Recentes)
                        {
                            var lugar = l;
                            <button class="mc-lugar" type="button" @onclick="() => Ir(lugar)"><b>@lugar.Nome</b><span>@lugar.Detalhe</span></button>
                        }
                    }
                }
                else if (_procurando && _resultados.Count == 0)
                {
                    <p class="mc-texto-2">Procurando…</p>
                }
                else if (_resultados.Count == 0)
                {
                    <p class="mc-texto-2">@(_erro ?? (_termo.Trim().Length < 3 ? "Continue digitando…" : "Nada encontrado. Tente com a cidade, ex.: \"Rua Augusta, São Paulo\"."))</p>
                }
                else
                {
                    @foreach (var l in _resultados)
                    {
                        var lugar = l;
                        <button class="mc-lugar" type="button" @onclick="() => Ir(lugar)"><b>@lugar.Nome</b><span>@lugar.Detalhe</span></button>
                    }
                }
            </div>
        </section>

        <button class="mc-btn primario mc-so-abrir" type="button" @onclick="() => Ir(null)">@Icones.Navegacao<span>Abrir o @AppsCarro.Nome(app) sem destino</span></button>
    }
</div>

@code {
    private string _termo = "";
    private string? _erro;
    private bool _procurando;
    private List<LugarBusca> _resultados = [];
    private CancellationTokenSource? _busca;
    private PosicaoCarro? _perto;
    private System.Threading.Timer? _relogio;

    protected override async Task OnInitializedAsync()
    {
        if (!Modo.Disponivel) return;
        Modo.Mudou += Redesenhar;
        Bluetooth.Mudou += Redesenhar; // voltou das telas do Android: o estado das permissões muda
        _relogio = new System.Threading.Timer(_ => Redesenhar(), null, TimeSpan.FromSeconds(20), TimeSpan.FromSeconds(20));
        _perto = await Modo.PosicaoRapida();
    }

    private void Redesenhar() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Modo.Mudou -= Redesenhar;
        Bluetooth.Mudou -= Redesenhar;
        _relogio?.Dispose();
        _busca?.Cancel();
    }

    private void EscolherApp(string app)
    {
        Store.Dados.Config.AppNavegacaoCarro = app;
        Store.Salvar();
    }

    // Procura enquanto digita, esperando uma pausa de 450 ms (não pesa o serviço gratuito)
    private async Task Digitou(ChangeEventArgs e)
    {
        _termo = e.Value?.ToString() ?? "";
        _busca?.Cancel();
        _erro = null;
        if (_termo.Trim().Length < 3)
        {
            _resultados = [];
            _procurando = false;
            return;
        }
        var busca = _busca = new CancellationTokenSource();
        _procurando = true;
        try
        {
            await Task.Delay(450, busca.Token);
            _resultados = await Busca.Buscar(_termo.Trim(), _perto, busca.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            _resultados = [];
            _erro = "Não foi possível buscar agora. Confira a internet.";
        }
        _procurando = false;
    }

    private void Limpar()
    {
        _busca?.Cancel();
        _termo = "";
        _resultados = [];
        _procurando = false;
        _erro = null;
    }

    /// <summary>Abre o Maps/Waze navegando até o lugar (null = só abre o app) e liga o aviso de radar.</summary>
    private void Ir(LugarBusca? lugar)
    {
        var app = AppsCarro.NavegacaoValida(Store.Dados.Config.AppNavegacaoCarro);
        if (lugar is not null) Busca.GuardarRecente(lugar);
        if (!Modo.Navegar(app, lugar))
        {
            Toast.Erro($"O {AppsCarro.Nome(app)} não está instalado neste celular.");
            return;
        }
        Limpar();
    }

    private void Encerrar()
    {
        Modo.Sair();
        Nav.NavigateTo("carro");
    }

    private void Voltar() => Nav.NavigateTo("carro");
}
