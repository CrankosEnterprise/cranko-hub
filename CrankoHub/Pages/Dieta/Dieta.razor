@namespace CrankoHub.Pages
@page "/dieta"
@inject ArmazenamentoService Store
@inject ToastService Toast
@inject IDialogoService Dialogo

@{
    var perfil = Store.Dados.Dieta.Perfil;
    var rs = DietaCalculos.Ordenados(Store.Dados.Dieta.Registros);
    var first = rs.FirstOrDefault();
    var last = rs.LastOrDefault();
    var meta = perfil.Meta;
    var perdendo = meta is null || first is null || meta < first.Peso;
    var slope = DietaCalculos.Tendencia(rs);
    double? semana = slope * 7;

    var previsao = Vazio;
    var previsaoSub = "Precisa de 3+ registros em 30 dias";
    if (last is not null && meta is not null)
    {
        var falta = meta.Value - last.Peso;
        if (Math.Abs(falta) < 0.05) { previsao = "Atingida!"; previsaoSub = "Parabéns, meta alcançada"; }
        else if (slope is double s && s != 0 && Math.Sign(s) == Math.Sign(falta))
        {
            var dias = falta / s;
            if (dias <= 3650)
            {
                previsao = DataCurtaAno(last.Data.AddDays((int)Math.Floor(dias)));
                previsaoSub = $"em ~{Math.Round(dias):0} dias no ritmo atual";
            }
            else previsaoSub = "Mais de 10 anos no ritmo atual";
        }
        else if (slope is not null) previsaoSub = "O ritmo atual não leva à meta";
    }
    else if (meta is null) previsaoSub = "Defina uma meta de peso";

    double? progresso = first is not null && last is not null && meta is not null && first.Peso != meta
        ? Math.Clamp((first.Peso - last.Peso) / (first.Peso - meta.Value) * 100, 0, 100) : null;
    var ed = Editando();

    // Gráfico de peso
    var corte = _periodo > 0 && last is not null ? last.Data.AddDays(-_periodo) : DateOnly.MinValue;
    var seriesPeso = new List<SerieLinha>
    {
        new("Peso", Modulo.CorDe(Store.Dados.Config, Modulo.Dieta), rs.Where(r => r.Data >= corte).Select(r => new PontoLinha(r.Data, r.Peso, r.Obs)).ToList(), Area: true),
        new("Média 7 dias", "var(--text-2)", DietaCalculos.MediaMovel(rs).Where(p => p.X >= corte).ToList(), Markers: false, Tracejada: true),
    };
    var gordura = _medida == "gordura";
    var pontosMedida = rs.Where(r => (gordura ? r.Gordura : r.Cintura) is not null)
        .Select(r => new PontoLinha(r.Data, (gordura ? r.Gordura : r.Cintura)!.Value)).ToList();
}

@{
    var rotuloMeta = meta is not null ? $"Meta: {Num(meta)} kg" : "Definir meta";
    var cor = Modulo.CorDe(Store.Dados.Config, Modulo.Dieta);
    var variacaoTotal = first is not null && rs.Count > 1 ? last!.Peso - first.Peso : (double?)null;
    var faltaMeta = last is not null && meta is not null ? Math.Abs(last.Peso - meta.Value) : (double?)null;
    const double raio = 38, circ = 2 * Math.PI * raio;
}

@* Cabeçalho no padrão do Carro e das Assinaturas: o peso atual é o título *@
<CabecalhoPagina Sobre="@(last is not null ? $"Último registro em {DataBR(last.Data)}" : "Nenhum registro ainda")"
                 Titulo="@(last is not null ? $"{Num(last.Peso)} kg" : null)" />

<AcoesTopo>
    <button class="btn" type="button" title="@rotuloMeta" aria-label="@rotuloMeta" @onclick="AbrirMeta">@Icones.Alvo<span class="rotulo">@rotuloMeta</span></button>
    <button class="btn primary" type="button" title="Registrar peso" aria-label="Registrar peso" @onclick="AbrirNovoRegistro">@Icones.Mais<span class="rotulo">Registrar peso</span></button>
    @* Configurações só da Dieta (as gerais do app ficam em Configurações, no menu) *@
    <button class="icon-btn" type="button" title="Configurações da Dieta" aria-label="Configurações da Dieta" @onclick="AbrirConfig">@Icones.Engrenagem</button>
</AcoesTopo>

@*
    Visão da Dieta (mesmo desenho da Visão geral do Carro): bloco grande com os números e a evolução do peso,
    coluna com a meta, a variação semanal e as medidas, e o histórico embaixo.
*@
<div class="carro-visao dieta-visao">
    <section class="card cv-hero brilho" style="--c:@cor">
        <div class="cv-numeros">
            <div>
                <span class="rot">Variação total</span>
                <div class="cv-v">@(variacaoTotal is double vt ? ComSinal(vt) : Vazio)<small>kg</small></div>
                @if (variacaoTotal is double vt2 && Math.Abs(vt2) >= 0.05)
                {
                    <span class="cv-delta @((vt2 < 0) == perdendo ? "bom" : "ruim")">desde @DataBR(first!.Data)</span>
                }
                else
                {
                    <span class="rot">@(variacaoTotal is not null ? "desde " + DataBR(first!.Data) : "precisa de 2+ registros")</span>
                }
            </div>
            <div>
                <span class="rot">Ritmo</span>
                <div class="cv-v">@(semana is not null ? ComSinal(semana.Value, 2) : Vazio)<small>kg/sem</small></div>
                <span class="rot">@(semana is not null ? "tendência dos últimos 30 dias" : "precisa de mais registros")</span>
            </div>
            <div>
                <span class="rot">Falta p/ meta</span>
                <div class="cv-v">@(faltaMeta is not null ? Num(faltaMeta) : Vazio)<small>kg</small></div>
                <span class="rot">@(progresso is not null ? Num(progresso, 0) + "% do caminho" : "defina uma meta")</span>
            </div>
            <div>
                <span class="rot">Previsão da meta</span>
                <div class="cv-v">@previsao</div>
                <span class="rot">@previsaoSub</span>
            </div>
        </div>
        <div class="dv-graf-cab">
            <Legenda Itens="@(rs.Count > 0 ? seriesPeso.Select(s => new ItemLegenda(s.Name, s.Color)).ToList() : [])" />
            <div class="chips">
                @foreach (var (dias, rotulo) in Periodos)
                {
                    <button type="button" class="chip @(_periodo == dias ? "active" : "")" @onclick="() => _periodo = dias">@rotulo</button>
                }
            </div>
        </div>
        <div class="dv-graf">
            <GraficoLinha Series="seriesPeso" Altura="280" Formato="FormatoNumero.Kg" Rotulo="Evolução do peso"
                          Referencias="@(meta is not null && rs.Count > 0 ? [new ReferenciaLinha(meta.Value, $"Meta {Num(meta)} kg")] : [])"
                          MsgVazia="Adicione seu primeiro peso para ver o gráfico." />
        </div>
    </section>

    <div class="cv-lado">
        <section class="card cv-tanque brilho" style="--c:@cor">
            <div class="cv-anel">
                <svg viewBox="0 0 92 92" aria-hidden="true">
                    <circle cx="46" cy="46" r="@raio" class="cv-anel-fundo" />
                    @if (progresso is double pg)
                    {
                        <circle cx="46" cy="46" r="@raio" class="cv-anel-valor" style="stroke:@cor"
                                stroke-dasharray="@($"{(circ * pg / 100).ToString(System.Globalization.CultureInfo.InvariantCulture)} {circ.ToString(System.Globalization.CultureInfo.InvariantCulture)}")" />
                    }
                </svg>
                <b>@(progresso is null ? "—" : Num(progresso, 0) + "%")</b>
            </div>
            <div>
                <span class="rot">Meta</span>
                @if (meta is not null)
                {
                    <div class="cv-tanque-km">@Num(meta) kg</div>
                    <span class="rot">@(faltaMeta is double f ? (f < 0.05 ? "meta atingida!" : $"faltam {Num(f)} kg") : "registre seu peso")@(first is not null ? $" · início {Num(first.Peso)} kg" : "")</span>
                }
                else
                {
                    <div class="cv-tanque-km">—</div>
                    <span class="rot">Sem meta definida</span>
                }
                <button type="button" class="b-link dv-meta-link" @onclick="AbrirMeta">@(meta is not null ? "Alterar meta" : "Definir meta")</button>
            </div>
        </section>

        <section class="card">
            <div class="b-cab"><span class="b-ic" style="--c:@cor">@Icones.Balanca</span>Variação semanal<span class="b-dir">últimas 12 semanas</span></div>
            <GraficoBarras Dados="DietaCalculos.Semanal(rs)" Nome="Variação" Altura="180" Cor="@cor"
                           FormatoY="new FormatoNumero(1)" Formato="@(new FormatoNumero(1, " kg", Sinal: true))"
                           MsgVazia="Precisa de registros em pelo menos 2 semanas." />
        </section>

        <section class="card cv-docs">
            <div class="b-cab"><span class="b-ic" style="--c:#34C759">@Icones.Alvo</span>Medidas
                <div class="chips mini dv-chips-dir">
                    <button type="button" class="chip @(gordura ? "active" : "")" @onclick="@(() => _medida = "gordura")">% Gordura</button>
                    <button type="button" class="chip @(!gordura ? "active" : "")" @onclick="@(() => _medida = "cintura")">Cintura</button>
                </div>
            </div>
            <GraficoLinha Altura="180" Formato="@(new FormatoNumero(1, gordura ? "%" : " cm"))"
                          Series="@([new SerieLinha(gordura ? "% Gordura" : "Cintura", "#34C759", pontosMedida, Area: true)])"
                          MsgVazia="@($"Sem registros de {(gordura ? "% de gordura" : "cintura")} ainda.")" />
        </section>
    </div>

    <section class="card cv-tabela">
        <div class="b-cab"><span class="b-ic" style="--c:@cor">@Icones.Dados</span>Histórico<span class="b-dir">@rs.Count @Plural(rs.Count, "registro", "registros")</span></div>
        @if (rs.Count > 0)
        {
            <div class="dv-tabela">
                <table class="tabela-limpa">
                    <thead><tr><th>Data</th><th class="num">Peso</th><th class="num">Variação</th><th class="num">Gordura</th><th class="num">Cintura</th><th class="dv-obs">Observação</th><th></th></tr></thead>
                    <tbody>
                        @for (var i = rs.Count - 1; i >= 0; i--)
                        {
                            var r = rs[i];
                            var anterior = i > 0 ? rs[i - 1] : null;
                            <tr @key="r.Id">
                                <td>@DataBR(r.Data)</td>
                                <td class="num"><b>@Num(r.Peso) kg</b></td>
                                <td class="num">@if (anterior is not null) { <Delta Valor="r.Peso - anterior.Peso" Unidade=" kg" BomQuandoCai="perdendo" /> } else { <span class="muted">—</span> }</td>
                                <td class="num">@(r.Gordura is not null ? Num(r.Gordura) + "%" : Vazio)</td>
                                <td class="num">@(r.Cintura is not null ? Num(r.Cintura) + " cm" : Vazio)</td>
                                <td class="dv-obs">@r.Obs</td>
                                <td><div class="row-actions">
                                    <button type="button" title="Editar" @onclick="() => Editar(r)">@Icones.Editar</button>
                                    <button type="button" class="del" title="Excluir" @onclick="() => Excluir(r)">@Icones.Excluir</button>
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="b-vazio">Nenhum registro ainda. Toque em "Registrar peso" no topo.</p>
        }
    </section>
</div>

@* ---- Registro de peso (novo / editar) ---- *@
@if (_registroAberto)
{
    <div class="modal-backdrop" @onclick="FecharRegistro">
        <form class="card modal" autocomplete="off" @onclick:stopPropagation="true" @onsubmit="SalvarRegistro">
            <div><h2>@(ed is not null ? "Editar registro" : "Registrar peso")</h2><p class="muted">Só o peso é obrigatório. Um registro por dia.</p></div>
            <div class="form-grid">
                <label class="field"><span>Data</span><input type="date" required @bind="_fData"></label>
                <label class="field"><span>Peso (kg) *</span><input inputmode="decimal" required placeholder="ex.: 82,5" autofocus @bind="_fPeso"></label>
                <label class="field"><span>% Gordura corporal</span><input inputmode="decimal" placeholder="opcional" @bind="_fGordura"></label>
                <label class="field"><span>Cintura (cm)</span><input inputmode="decimal" placeholder="opcional" @bind="_fCintura"></label>
                <label class="field full"><span>Observação</span><input maxlength="140" placeholder="treino, refeição livre, como se sentiu..." @bind="_fObs"></label>
            </div>
            <div class="form-actions">
                <button class="btn" type="button" @onclick="FecharRegistro">Cancelar</button>
                <button class="btn primary" type="submit">@(ed is not null ? "Salvar alterações" : "Registrar")</button>
            </div>
        </form>
    </div>
}

@* ---- Meta de peso ---- *@
@if (_metaAberta)
{
    <div class="modal-backdrop" @onclick="() => _metaAberta = false">
        <form class="card modal" autocomplete="off" @onclick:stopPropagation="true" @onsubmit="SalvarMeta">
            <div><h2>Meta de peso</h2><p class="muted">Usada no progresso, no gráfico e na previsão.</p></div>
            <label class="field"><span>Peso meta (kg)</span><input inputmode="decimal" placeholder="ex.: 78" autofocus @bind="_fMeta"></label>
            @if (progresso is not null)
            {
                <div class="progress" role="progressbar" aria-label="Progresso até a meta" aria-valuenow="@Math.Round(progresso.Value)" aria-valuemin="0" aria-valuemax="100">
                    <div style="width:@(progresso.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                </div>
                <div class="progress-legend"><span>Início <b>@Num(first!.Peso) kg</b></span><span><b>@Num(progresso, 0)%</b> concluído</span><span>Meta <b>@Num(meta) kg</b></span></div>
            }
            <div class="form-actions">
                <button class="btn" type="button" @onclick="() => _metaAberta = false">Cancelar</button>
                <button class="btn primary" type="submit">Salvar meta</button>
            </div>
        </form>
    </div>
}

@* ---- Configurações da Dieta (engrenagem no topo) ---- *@
@if (_configAberta)
{
    <div class="modal-backdrop" @onclick="() => _configAberta = false">
        <form class="card modal" autocomplete="off" @onclick:stopPropagation="true" @onsubmit="SalvarConfig">
            <div><h2>@Icones.Engrenagem Configurações da Dieta</h2><p class="muted">Valem só para esta seção. As do app ficam em Configurações, no menu.</p></div>
            <label class="check full"><input type="checkbox" @bind="_fLembrar"> Lembrar de me pesar no Início ("Precisa de atenção")</label>
            @if (_fLembrar)
            {
                <label class="field"><span>Avisar depois de quantos dias sem registro</span>
                    <input type="number" inputmode="numeric" min="1" max="365" required @bind="_fDiasLembrete"></label>
                @if (_fDiasLembrete is >= 1 and <= 365)
                {
                    <p class="muted">Ex.: com @_fDiasLembrete @Plural(_fDiasLembrete, "dia", "dias"), um peso registrado hoje volta a ser lembrado em @DataBR(Hoje.AddDays(_fDiasLembrete)).</p>
                }
            }
            <div class="form-actions">
                <button class="btn" type="button" @onclick="() => _configAberta = false">Cancelar</button>
                <button class="btn primary" type="submit">Salvar</button>
            </div>
        </form>
    </div>
}

@code {
    private static readonly (int Dias, string Rotulo)[] Periodos = [(30, "30 dias"), (90, "90 dias"), (365, "1 ano"), (0, "Tudo")];

    // Preferências de visualização mantidas enquanto o app estiver aberto
    private static int _periodo = 90;          // período do gráfico de peso (dias, 0 = tudo)
    private static string _medida = "gordura"; // gráfico de medidas: "gordura" | "cintura"

    private string? _editId;
    private bool _registroAberto, _metaAberta;

    private DateOnly? _fData = Hoje;
    private string _fPeso = "", _fGordura = "", _fCintura = "", _fObs = "";
    private string _fMeta = "";

    private bool _configAberta, _fLembrar;
    private int _fDiasLembrete;

    private List<RegistroPeso> Registros => Store.Dados.Dieta.Registros;

    private RegistroPeso? Editando() => _editId is null ? null : Registros.FirstOrDefault(r => r.Id == _editId);

    /// <summary>dieta?novo=1 abre direto a janela de registrar peso (botão Registrar do Início).</summary>
    [SupplyParameterFromQuery(Name = "novo")] public string? NovoDoLink { get; set; }

    private string? _novoDoLink;

    protected override void OnParametersSet()
    {
        if (NovoDoLink == _novoDoLink) return;
        _novoDoLink = NovoDoLink;
        if (NovoDoLink is not null) AbrirNovoRegistro();
    }

    private void AbrirNovoRegistro()
    {
        LimparFormulario();
        _registroAberto = true;
    }

    private void FecharRegistro()
    {
        _registroAberto = false;
        LimparFormulario();
    }

    private void AbrirMeta()
    {
        _fMeta = InVal(Store.Dados.Dieta.Perfil.Meta, 1);
        _metaAberta = true;
    }

    private void AbrirConfig()
    {
        var dias = Store.Dados.Dieta.Perfil.DiasLembretePeso;
        _fLembrar = dias > 0;
        _fDiasLembrete = dias > 0 ? dias : PerfilDieta.PadraoDiasLembretePeso;
        _configAberta = true;
    }

    private void SalvarConfig()
    {
        if (_fLembrar && _fDiasLembrete is not (>= 1 and <= 365)) { Toast.Erro("Informe de 1 a 365 dias."); return; }
        Store.Dados.Dieta.Perfil.DiasLembretePeso = _fLembrar ? _fDiasLembrete : 0;
        Store.Salvar();
        _configAberta = false;
        Toast.Ok(_fLembrar ? $"Lembrete depois de {_fDiasLembrete} {Plural(_fDiasLembrete, "dia", "dias")} sem registro." : "Lembrete de pesar desligado.");
    }

    private void LimparFormulario()
    {
        _editId = null;
        _fData = Hoje;
        _fPeso = _fGordura = _fCintura = _fObs = "";
    }

    private void Editar(RegistroPeso r)
    {
        _editId = r.Id;
        _fData = r.Data;
        _fPeso = InVal(r.Peso, 1);
        _fGordura = InVal(r.Gordura, 1);
        _fCintura = InVal(r.Cintura, 1);
        _fObs = r.Obs ?? "";
        _registroAberto = true;
    }

    private async Task Excluir(RegistroPeso r)
    {
        if (!await Dialogo.Confirmar($"Excluir o registro de {DataBR(r.Data)} ({Num(r.Peso)} kg)?")) return;
        Registros.Remove(r);
        Store.Salvar();
        Toast.Ok("Registro excluído.");
    }

    private void SalvarRegistro()
    {
        if (_fData is not DateOnly data) { Toast.Erro("Informe a data."); return; }
        var peso = Pf(_fPeso);
        var gordura = Pf(_fGordura);
        var cintura = Pf(_fCintura);
        if (peso is not (>= 20 and <= 400)) { Toast.Erro("Informe um peso válido (20 a 400 kg)."); return; }
        if (gordura is not null && gordura is not (> 0 and < 80)) { Toast.Erro("% de gordura inválida."); return; }

        void Preencher(RegistroPeso r)
        {
            r.Data = data;
            r.Peso = peso.Value;
            r.Gordura = gordura;
            r.Cintura = cintura;
            r.Obs = string.IsNullOrWhiteSpace(_fObs) ? null : _fObs.Trim();
        }

        var ed = Editando();
        var mesmoDia = Registros.FirstOrDefault(r => r.Data == data && r.Id != _editId);
        if (ed is not null)
        {
            if (mesmoDia is not null) { Toast.Erro("Já existe um registro nessa data."); return; }
            Preencher(ed);
            Toast.Ok("Registro atualizado.");
        }
        else if (mesmoDia is not null)
        {
            Preencher(mesmoDia);
            Toast.Ok("Já havia um registro nesse dia — ele foi atualizado.");
        }
        else
        {
            var novo = new RegistroPeso { Id = ArmazenamentoService.NovoId() };
            Preencher(novo);
            Registros.Add(novo);
            Toast.Ok("Peso registrado!");
        }
        FecharRegistro();
        Store.Salvar();
    }

    private void SalvarMeta()
    {
        var meta = Pf(_fMeta);
        if (meta is not null && meta is not (>= 20 and <= 400)) { Toast.Erro("Meta de peso inválida."); return; }
        Store.Dados.Dieta.Perfil.Meta = meta;
        Store.Salvar();
        _metaAberta = false;
        Toast.Ok(meta is null ? "Meta removida." : "Meta salva.");
    }
}
