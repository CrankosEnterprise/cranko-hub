@namespace CrankoHub.Pages
@page "/assinaturas"
@inject ArmazenamentoService Store
@inject ToastService Toast
@inject IDialogoService Dialogo

@*
    Assinaturas (protótipo "Fusão"): o total por mês no título; à esquerda a rosca de para onde vai o dinheiro e as
    próximas cobranças; à direita os dias de cobrança do mês, um cartão por serviço (clicar edita) e as cobranças
    previstas mês a mês. Cada serviço tem a cor da sua marca (AssinaturasCalculos.CorDe).
*@
@{
    var hoje = Hoje;
    var todas = Lista;
    var ativas = todas.Where(a => a.Ativa).ToList();
    var pausadas = todas.Count - ativas.Count;
    var porMes = ativas.Sum(AssinaturasCalculos.PorMes);
    var ed = Editando();
    var categorias = AssinaturasCalculos.CategoriasSugeridas.Union(todas.Select(a => a.Categoria).OfType<string>()).Distinct().Order().ToList();
    var porValor = ativas.OrderByDescending(AssinaturasCalculos.PorMes).ThenBy(a => a.Nome).ToList();

    // Próximas cobranças: a primeira de cada serviço nos próximos 60 dias
    var proximas = AssinaturasCalculos.CobrancasAte(ativas, hoje, 60)
        .GroupBy(c => c.Assinatura).Select(g => g.First()).OrderBy(c => c.Data).ThenBy(c => c.Assinatura.Nome).Take(4).ToList();

    // Dias de cobrança do mês atual (do dia 1 ao último)
    var inicioMes = new DateOnly(hoje.Year, hoje.Month, 1);
    var diasNoMes = DateTime.DaysInMonth(hoje.Year, hoje.Month);
    var cobrancasMes = AssinaturasCalculos.CobrancasAte(ativas, inicioMes, diasNoMes - 1);
    var nomeMes = Formatacao.NomeDoMes(hoje.Month);

    // Cobranças previstas mês a mês (do mês atual em diante)
    var meses = Enumerable.Range(0, 12).Select(i => inicioMes.AddMonths(i)).ToList();
    var cobrancasAno = AssinaturasCalculos.CobrancasAte(ativas, hoje, meses[^1].AddMonths(1).DayNumber - 1 - hoje.DayNumber);
    var previsaoMensal = meses.Select(m =>
    {
        var doMes = cobrancasAno.Where(c => c.Data.Year == m.Year && c.Data.Month == m.Month).ToList();
        var rotulo = MesLabel(m.Year, m.Month);
        return new BarraDado(rotulo.Split('/')[0], doMes.Sum(c => c.Assinatura.Valor), $"{rotulo} · {doMes.Count} {Plural(doMes.Count, "cobrança", "cobranças")}");
    }).ToList();

    var cartoes = (_mostrarPausadas ? todas.Where(a => !a.Ativa) : porValor).ToList();
    const double raio = 92, circ = 2 * Math.PI * raio;
}

<CabecalhoPagina Sobre="@($"{ativas.Count} {Plural(ativas.Count, "serviço ativo", "serviços ativos")}{(pausadas > 0 ? $" · {pausadas} {Plural(pausadas, "pausado", "pausados")}" : "")}")"
                 Titulo="@($"{Money(porMes)} por mês")" />

<AcoesTopo>
    @if (pausadas > 0)
    {
        <button class="btn @(_mostrarPausadas ? "ligado" : "")" type="button" aria-pressed="@_mostrarPausadas" title="Mostrar as assinaturas pausadas ou canceladas"
                @onclick="() => _mostrarPausadas = !_mostrarPausadas">@Icones.Pausar<span class="rotulo">Pausadas (@pausadas)</span></button>
    }
    <button class="btn primary" type="button" title="Nova assinatura" aria-label="Nova assinatura" @onclick="AbrirNova">@Icones.Mais<span class="rotulo">Nova assinatura</span></button>
</AcoesTopo>

<div class="assin-grade">
    <section class="card as-rosca brilho" style="--c:@Modulo.CorDe(Store.Dados.Config, Modulo.Assinaturas)">
        <div class="b-cab"><span class="b-ic">@Icones.Dinheiro</span>Para onde vai o dinheiro</div>
        <div class="as-rosca-svg">
            <svg viewBox="0 0 230 230" aria-hidden="true">
                <circle cx="115" cy="115" r="@raio" class="as-rosca-fundo" />
                @{ var acumulado = 0.0; }
                @foreach (var a in porValor)
                {
                    var fatia = porMes > 0 ? AssinaturasCalculos.PorMes(a) / porMes : 0;
                    var traco = Math.Max(0, circ * fatia - (porValor.Count > 1 ? 4 : 0));
                    <circle cx="115" cy="115" r="@raio" class="as-fatia" style="stroke:@AssinaturasCalculos.CorDe(a)"
                            stroke-dasharray="@($"{Inv(traco)} {Inv(circ)}")" stroke-dashoffset="@Inv(-circ * acumulado)"><title>@a.Nome · @Money(AssinaturasCalculos.PorMes(a))/mês</title></circle>
                    acumulado += fatia;
                }
            </svg>
            <div class="as-rosca-centro">
                <span>Por ano</span>
                <b>@Num(porMes * 12, 0)</b>
                <span>reais</span>
            </div>
        </div>
        <div class="as-prox">
            <div class="as-prox-titulo">Próximas cobranças</div>
            @if (proximas.Count > 0)
            {
                @foreach (var (a, data) in proximas)
                {
                    var (prazo, _) = AssinaturasCalculos.Prazo(data.DayNumber - hoje.DayNumber);
                    <button type="button" class="as-prox-item" @onclick="() => Editar(a)">
                        <span class="as-logo mini" style="--c:@AssinaturasCalculos.CorDe(a)">@AssinaturasCalculos.InicialDe(a)</span>
                        <span class="as-prox-nome">@a.Nome</span>
                        <span class="as-prox-dia">dia @data.Day@(data.DayNumber - hoje.DayNumber <= 1 ? $" · {prazo}" : "")</span>
                        <b>@Money(a.Valor)</b>
                    </button>
                }
            }
            else
            {
                <p class="b-vazio">Nenhuma cobrança nos próximos 60 dias.</p>
            }
        </div>
    </section>

    <div class="as-direita">
        <section class="card">
            <div class="b-cab"><span class="b-ic" style="--c:@Modulo.CorDe(Store.Dados.Config, Modulo.Assinaturas)">@Icones.Agenda</span>Cobranças de @nomeMes<span class="b-dir">Hoje é dia @hoje.Day</span></div>
            <div class="as-mes">
                @for (var dia = 1; dia <= diasNoMes; dia++)
                {
                    var d = dia;
                    var doDia = cobrancasMes.Where(x => x.Data.Day == d).ToList();
                    <div class="as-dia @(d == hoje.Day ? "hoje" : d < hoje.Day ? "passou" : "")"
                         title="@(doDia.Count > 0 ? string.Join(", ", doDia.Select(x => $"{x.Assinatura.Nome} {Money(x.Assinatura.Valor)}")) : null)">
                        @d
                        @if (doDia.Count > 0)
                        {
                            <span class="as-pontos">@foreach (var x in doDia.Take(3)) { <i style="--c:@AssinaturasCalculos.CorDe(x.Assinatura)"></i> }</span>
                        }
                    </div>
                }
            </div>
        </section>

        <div class="as-cartoes">
            @foreach (var a in cartoes)
            {
                var proximaData = AssinaturasCalculos.ProximaCobranca(a, hoje);
                var dias = proximaData.DayNumber - hoje.DayNumber;
                var corA = AssinaturasCalculos.CorDe(a);
                <button type="button" class="as-cartao @(a.Ativa ? "" : "pausada")" style="--c:@corA" @key="a.Id" @onclick="() => Editar(a)" title="Editar @a.Nome">
                    <span class="as-cartao-topo">
                        <span class="as-logo" style="--c:@corA">@AssinaturasCalculos.InicialDe(a)</span>
                        @if (!a.Ativa)
                        {
                            <span class="pilula">Pausada</span>
                        }
                        else if (dias <= 1)
                        {
                            <span class="pilula atencao">@(dias == 0 ? "Hoje" : "Amanhã")</span>
                        }
                        else
                        {
                            <span class="pilula">@(CicloCobranca.Buscar(a.Ciclo).Meses == 1 ? $"Dia {proximaData.Day}" : DataCurta(proximaData))</span>
                        }
                    </span>
                    <b class="as-cartao-nome">@a.Nome</b>
                    <span class="as-cartao-sub">@CicloCobranca.Buscar(a.Ciclo).Nome · @AssinaturasCalculos.CategoriaDe(a)</span>
                    <span class="as-cartao-valor">@Money(a.Valor)<small>@Sufixo(a.Ciclo)</small></span>
                </button>
            }
            @if (!_mostrarPausadas && todas.Count == 0)
            {
                <button type="button" class="as-cartao novo" @onclick="AbrirNova">
                    <span class="as-novo-mais">@Icones.Mais</span>
                    <b>Nova assinatura</b>
                    <span class="as-cartao-sub">@(todas.Count == 0 ? "Comece pelo streaming ou pela academia" : "Adicionar outro serviço")</span>
                </button>
            }
        </div>

        <section class="card">
            <div class="b-cab"><span class="b-ic" style="--c:@Modulo.CorDe(Store.Dados.Config, Modulo.Assinaturas)">@Icones.Dinheiro</span>Cobranças previstas<span class="b-dir">@Money(previsaoMensal.Sum(b => b.Value)) nos próximos 12 meses</span></div>
            <GraficoBarras RealcarPrimeiro="true" Dados="previsaoMensal" Nome="Cobranças" Altura="210" Cor="@Modulo.CorDe(Store.Dados.Config, Modulo.Assinaturas)"
                           FormatoY="@(new FormatoNumero(0, Prefixo: "R$ "))" Formato="FormatoNumero.Real"
                           MsgVazia="As cobranças de cada mês aparecem aqui." />
        </section>
    </div>
</div>

@* ---- Nova / editar assinatura ---- *@
@if (_formAberto)
{
    <div class="modal-backdrop" @onclick="Fechar">
        <form class="card modal modal-medio" autocomplete="off" @onclick:stopPropagation="true" @onsubmit="Salvar">
            <div><h2>@(ed is not null ? "Editar assinatura" : "Nova assinatura")</h2><p class="muted">Informe a data de uma cobrança — as próximas são calculadas pelo ciclo.</p></div>
            <div class="form-grid">
                <label class="field"><span>Nome *</span><input maxlength="60" required placeholder="ex.: Netflix" autofocus @bind="_fNome"></label>
                <label class="field"><span>Valor (R$) *</span><input inputmode="decimal" required placeholder="ex.: 44,90" @bind="_fValor" @bind:event="oninput"></label>
                <label class="field"><span>Ciclo</span>
                    <select @bind="_fCiclo">
                        @foreach (var c in CicloCobranca.Todos)
                        {
                            <option value="@c.Chave">@c.Nome</option>
                        }
                    </select></label>
                <label class="field"><span>Próxima cobrança *</span><input type="date" required @bind="_fVencimento"></label>
                <label class="field"><span>Categoria</span>
                    <select @bind="_fCategoriaSel">
                        <option value="">@AssinaturasCalculos.SemCategoria</option>
                        @foreach (var c in categorias)
                        {
                            <option value="@c">@c</option>
                        }
                        <option value="@OutraCategoria">Outra...</option>
                    </select></label>
                <label class="field"><span>Forma de pagamento</span><input maxlength="40" placeholder="ex.: Cartão Nubank, Pix" @bind="_fPagamento"></label>
                @if (_fCategoriaSel == OutraCategoria)
                {
                    <label class="field full"><span>Nome da categoria</span><input maxlength="40" placeholder="ex.: Delivery" autofocus @bind="_fCategoriaNova"></label>
                }
                <label class="field full"><span>Observação</span><input maxlength="140" placeholder="plano família, login de quem, como cancelar..." @bind="_fObs"></label>
                <label class="check"><input type="checkbox" @bind="_fAtiva"> Assinatura ativa</label>
            </div>
            @if (Pf(_fValor) is > 0 and var valor)
            {
                var ciclo = CicloCobranca.Buscar(_fCiclo);
                <div class="preview">
                    <span>Equivale a <b>@Money(ciclo.PorMes(valor))/mês</b> · <b>@Money(ciclo.PorMes(valor) * 12)/ano</b></span>
                </div>
            }
            <div class="form-actions">
                @if (ed is not null)
                {
                    <button class="btn danger" type="button" style="margin-right:auto" @onclick="() => Excluir(ed)">@Icones.Excluir Excluir</button>
                }
                <button class="btn" type="button" @onclick="Fechar">Cancelar</button>
                <button class="btn primary" type="submit">@(ed is not null ? "Salvar alterações" : "Adicionar assinatura")</button>
            </div>
        </form>
    </div>
}

@code {
    private const string OutraCategoria = "__outra";

    // Mostrar as pausadas no lugar das ativas (mantido enquanto o app estiver aberto)
    private static bool _mostrarPausadas;

    /// <summary>assinaturas?novo=1 abre direto a janela de nova assinatura (botão Registrar do Início).</summary>
    [SupplyParameterFromQuery(Name = "novo")] public string? NovoDoLink { get; set; }

    private string? _novoDoLink;

    protected override void OnParametersSet()
    {
        if (NovoDoLink == _novoDoLink) return;
        _novoDoLink = NovoDoLink;
        if (NovoDoLink is not null) AbrirNova();
    }

    // "/mês", "/ano", "/semana" ou "/trimestre"...
    private static string Sufixo(string ciclo) => CicloCobranca.Buscar(ciclo) switch
    {
        { Dias: 7 } => "/semana",
        { Meses: 1 } => "/mês",
        { Meses: 12 } => "/ano",
        { Meses: 3 } => "/trimestre",
        { Meses: 6 } => "/semestre",
        var c => "/" + c.Nome.ToLowerInvariant(),
    };

    // Número com ponto (atributos do SVG)
    private static string Inv(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string? _editId;
    private bool _formAberto;

    private string _fNome = "", _fValor = "", _fCiclo = "mensal", _fCategoriaSel = "", _fCategoriaNova = "", _fPagamento = "", _fObs = "";
    private DateOnly? _fVencimento = Hoje;
    private bool _fAtiva = true;

    private List<Assinatura> Lista => Store.Dados.Assinaturas;

    private Assinatura? Editando() => _editId is null ? null : Lista.FirstOrDefault(a => a.Id == _editId);

    private void AbrirNova()
    {
        LimparFormulario();
        _formAberto = true;
    }

    private void Fechar()
    {
        _formAberto = false;
        LimparFormulario();
    }

    private void LimparFormulario()
    {
        _editId = null;
        _fNome = _fValor = _fCategoriaSel = _fCategoriaNova = _fPagamento = _fObs = "";
        _fCiclo = "mensal";
        _fVencimento = Hoje;
        _fAtiva = true;
    }

    private void Editar(Assinatura a)
    {
        _editId = a.Id;
        _fNome = a.Nome;
        _fValor = InVal(a.Valor, 2);
        _fCiclo = a.Ciclo;
        // Mostra a próxima cobrança, não a data antiga que foi cadastrada
        _fVencimento = AssinaturasCalculos.ProximaCobranca(a, Hoje);
        _fCategoriaSel = a.Categoria ?? "";  // as categorias já usadas sempre estão na lista
        _fCategoriaNova = "";
        _fPagamento = a.Pagamento ?? "";
        _fObs = a.Obs ?? "";
        _fAtiva = a.Ativa;
        _formAberto = true;
    }

    private async Task Excluir(Assinatura a)
    {
        if (!await Dialogo.Confirmar($"Excluir a assinatura \"{a.Nome}\"?\n\nSe você só cancelou o serviço, prefira editar e desmarcar \"Assinatura ativa\" para manter o histórico.")) return;
        Lista.Remove(a);
        Store.Salvar();
        if (_editId == a.Id) Fechar();
        Toast.Ok("Assinatura excluída.");
    }

    private void Salvar()
    {
        var nome = _fNome.Trim();
        var valor = Pf(_fValor);
        var categoria = (_fCategoriaSel == OutraCategoria ? _fCategoriaNova : _fCategoriaSel).Trim();
        if (nome.Length == 0) { Toast.Erro("Informe o nome da assinatura."); return; }
        if (valor is not (> 0 and <= 100_000)) { Toast.Erro("Informe um valor válido."); return; }
        if (_fVencimento is not DateOnly vencimento) { Toast.Erro("Informe a data da próxima cobrança."); return; }
        if (_fCategoriaSel == OutraCategoria && categoria.Length == 0) { Toast.Erro("Informe o nome da nova categoria."); return; }

        void Preencher(Assinatura a)
        {
            a.Nome = nome;
            a.Valor = valor.Value;
            a.Ciclo = _fCiclo;
            a.Vencimento = vencimento;
            a.Categoria = categoria.Length == 0 ? null : categoria;
            a.Pagamento = string.IsNullOrWhiteSpace(_fPagamento) ? null : _fPagamento.Trim();
            a.Obs = string.IsNullOrWhiteSpace(_fObs) ? null : _fObs.Trim();
            a.Ativa = _fAtiva;
        }

        var ed = Editando();
        if (ed is not null)
        {
            Preencher(ed);
            Toast.Ok("Assinatura atualizada.");
        }
        else
        {
            var nova = new Assinatura { Id = ArmazenamentoService.NovoId() };
            Preencher(nova);
            Lista.Add(nova);
            Toast.Ok($"Assinatura \"{nome}\" adicionada.");
        }
        Store.Salvar();
        Fechar();
    }
}
