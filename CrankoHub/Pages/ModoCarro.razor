@page "/carro/modo"
@layout LayoutCarro
@* Modo Carro (CarLink): mapa próprio (OpenStreetMap, seguindo o GPS) com rota (RotaService) + Spotify + atalhos, para o celular no suporte do carro.
   Só funciona no Android (ModoCarroService); no Windows/Linux a página explica isso e o mapa nem é carregado. *@
@implements IAsyncDisposable
@inject ModoCarroService Modo
@inject ToastService Toast
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject RotaService Rota
@inject ArmazenamentoService Store
@inject VisorCarroService Visor

@{
    var musica = Modo.Musica;
    var pos = Modo.Posicao;
    // Layout escolhido em Configurações → Modo Carro (ou no botão de layout): o CSS faz a disposição
    var cfg = Store.Dados.Config;
    var tela = LayoutsCarro.Valido(cfg.LayoutCarro);
    var atalhos = !cfg.AtalhosOcultosCarro.Contains(tela);
}

<div @ref="_raiz" class="modo-carro layout-@tela @(cfg.PainelCarroEsquerda ? "esquerda" : "") @(atalhos ? "" : "sem-atalhos")" style="@EstiloPainel(cfg, tela)">
    @if (!Modo.Disponivel)
    {
        <header class="mc-status">
            <b class="mc-hora">@DateTime.Now.ToString("HH:mm")</b>
            <span class="mc-titulo">Modo carro</span>
            <button class="mc-sair" type="button" @onclick="Sair">@Icones.Sair<span>Sair</span></button>
        </header>
        <section class="mc-card mc-aviso">
            <h2>Só no celular</h2>
            <p>O Modo Carro usa o GPS e o Spotify do Android. Abra o CrankoHub no celular para usar.</p>
        </section>
    }
    else
    {
        var pr = Rota.Atual is not null ? Rota.Progresso : null;
        <div class="mc-mapa @(Rota.Atual is not null ? "navegando" : "")">
            <div id="mc-mapa" class="mc-mapa-area"></div>

            @if (pr is not null)
            {
                <div class="mc-manobra @(pr.Chegou ? "chegou" : "")">
                    <span class="mc-manobra-seta">@Icones.Manobra(pr.Chegou ? "chegada" : pr.Proximo.Icone)</span>
                    <div class="mc-manobra-texto">
                        @if (!pr.Chegou)
                        {
                            <b>@RotaService.TextoDistancia(pr.DistanciaProximo)</b>
                        }
                        <p>@(pr.Chegou ? "Você chegou ao destino" : pr.Proximo.Instrucao)</p>
                    </div>
                </div>
            }
            else if (Rota.Atual is not null)
            {
                <div class="mc-manobra"><div class="mc-manobra-texto"><p>Rota para @Rota.Atual.Destino.Nome</p></div></div>
            }
            else if (Rota.Destino is null && pos is not null && !_buscando)
            {
                <button class="mc-para-onde" type="button" @onclick="AbrirBusca">@Icones.Busca<span>Para onde?</span></button>
            }
            @if (Rota.Calculando && Rota.Atual is not null)
            {
                <div class="mc-recalculando">Recalculando…</div>
            }
            @if (pr is not null && !pr.Chegou && (pr.RadarEm is <= 1000 || pr.PedagioEm is <= 2000))
            {
                <div class="mc-alertas">
                    @if (pr is { Radar: { } radar, RadarEm: <= 1000 and var radarEm })
                    {
                        <div class="mc-alerta radar"><span class="mc-radar-ponto"></span>Radar a @RotaService.TextoDistancia(radarEm)@(radar.Kmh is { } k ? $" · {k} km/h" : "")</div>
                    }
                    @if (pr is { PedagioEm: <= 2000 and var pedagioEm })
                    {
                        <div class="mc-alerta"><span class="mc-pedagio-ponto"></span>Pedágio a @RotaService.TextoDistancia(pedagioEm)</div>
                    }
                </div>
            }

            @if (Rota.Atual is { } rota)
            {
                <div class="mc-viagem">
                    @if (pr is not null)
                    {
                        <div><b>@pr.Chegada.ToString("HH:mm")</b><small>chegada</small></div>
                        <div><b>@TempoTexto(pr.TempoRestante)</b><small>@(pr.TempoRestante.TotalMinutes >= 60 ? "h" : "min")</small></div>
                        <div><b>@KmTexto(pr.Restante)</b><small>km</small></div>
                    }
                    else
                    {
                        <div class="mc-viagem-destino"><b>@rota.Destino.Nome</b></div>
                    }
                    <button class="mc-encerrar" type="button" aria-label="Encerrar a rota" @onclick="Encerrar">@Icones.Fechar<span>Encerrar</span></button>
                </div>
            }

            @if (_buscando)
            {
                <div class="mc-busca">
                    <div class="mc-busca-topo">
                        <span class="mc-busca-icone">@Icones.Busca</span>
                        <input @ref="_campoBusca" class="mc-busca-campo" type="search" placeholder="Para onde?" autocomplete="off" enterkeyhint="search"
                               @oninput="Digitou" />
                        <button class="mc-btn" type="button" @onclick="FecharBusca">Cancelar</button>
                    </div>
                    <div class="mc-busca-lista">
                        @if (string.IsNullOrWhiteSpace(_termo))
                        {
                            @if (Rota.Recentes.Count == 0)
                            {
                                <p class="mc-busca-vazio">Digite um endereço, um lugar ou um estabelecimento.</p>
                            }
                            else
                            {
                                <small class="mc-busca-titulo">Recentes</small>
                                @foreach (var l in Rota.Recentes)
                                {
                                    <button class="mc-lugar" type="button" @onclick="() => Ir(l)"><b>@l.Nome</b><span>@Detalhe(l)</span></button>
                                }
                            }
                        }
                        else if (_procurando && _resultados.Count == 0)
                        {
                            <p class="mc-busca-vazio">Procurando…</p>
                        }
                        else if (_resultados.Count == 0)
                        {
                            <p class="mc-busca-vazio">@(_erroBusca ?? "Nada encontrado. Tente com a cidade, ex.: \"Rua Augusta, São Paulo\".")</p>
                        }
                        else
                        {
                            @foreach (var l in _resultados)
                            {
                                <button class="mc-lugar" type="button" @onclick="() => Ir(l)"><b>@l.Nome</b><span>@Detalhe(l)</span></button>
                            }
                        }
                    </div>
                </div>
            }

            @if (Modo.SemLocalizacao)
            {
                <div class="mc-mapa-aviso">
                    <p>Permita a localização para o mapa acompanhar o carro.</p>
                    <button class="mc-btn primario" type="button" @onclick="Modo.LigarGps">Permitir localização</button>
                </div>
            }
            else if (pos is null)
            {
                <div class="mc-mapa-aviso discreto"><p>Procurando o GPS…</p></div>
            }
            @if (pos is not null)
            {
                var limite = pr?.LimiteKmh;
                <div class="mc-velocidade @(limite is { } l && pos.VelocidadeKmh > l + 3 ? "acima" : "")"><b>@Num(pos.VelocidadeKmh, 0)</b><small>km/h</small></div>
                @if (limite is { } lim)
                {
                    <div class="mc-limite" title="Limite da via"><b>@lim</b></div>
                }
            }
            @if (!_seguindo)
            {
                <button class="mc-recentralizar" type="button" @onclick="Recentralizar">@Icones.Navegacao<span>Recentralizar</span></button>
            }
        </div>

        @if (LayoutsCarro.TemTamanho(tela))
        {
            @* Arrastar muda o tamanho (modo-carro-layout.js); toque duplo volta ao padrão *@
            <div class="mc-divisoria" role="separator" aria-label="Arraste para mudar o tamanho" title="Arraste para mudar o tamanho (toque duplo: padrão)"
                 data-min="@LayoutsCarro.Minimo(tela)" data-max="@LayoutsCarro.Maximo(tela)"></div>
        }

        var previa = Rota.Atual is null && Rota.Destino is not null;
        <aside class="mc-lado @(previa ? "previa" : "") @(tela == LayoutsCarro.Mapa && _miniRecolhido && !previa ? "recolhido" : "")">
            <header class="mc-status">
                <b class="mc-hora">@DateTime.Now.ToString("HH:mm")</b>
                @if (tela == LayoutsCarro.Mapa)
                {
                    <button class="mc-icone" type="button" aria-label="@(_miniRecolhido ? "Mostrar o Spotify" : "Esconder o Spotify")" @onclick="() => _miniRecolhido = !_miniRecolhido">
                        @(_miniRecolhido ? Icones.Musica : Icones.Recolher)
                    </button>
                }
                <button class="mc-icone" type="button" aria-label="Trocar o layout" title="Trocar o layout" @onclick="TrocarLayout">@Icones.Layout</button>
                <button class="mc-sair" type="button" @onclick="Sair">@Icones.Sair<span>Sair</span></button>
            </header>

            @if (Rota.Atual is null && Rota.Destino is { } destino)
            {
                @* Prévia: escolher a rota antes de iniciar (no lugar do player) *@
                <section class="mc-card mc-previa">
                    <div class="mc-previa-topo">
                        <div><small>Rotas para</small><b>@destino.Nome</b></div>
                        <button class="mc-evitar @(Rota.EvitarPedagios ? "ligado" : "")" type="button" role="switch" aria-checked="@Rota.EvitarPedagios"
                                disabled="@Rota.Calculando" @onclick="Rota.AlternarEvitarPedagios">
                            <span class="mc-chave"></span>Sem pedágio
                        </button>
                    </div>
                    <div class="mc-opcoes">
                        @if (Rota.Opcoes is { } opcoes)
                        {
                            @for (var i = 0; i < opcoes.Count; i++)
                            {
                                var indice = i;
                                var o = opcoes[i];
                                <button class="mc-opcao @(i == Rota.Escolhida ? "ativa" : "")" type="button" @onclick="() => Rota.Escolher(indice)">
                                    <span class="mc-opcao-linha"><b>@RotaService.TextoTempo(TimeSpan.FromSeconds(o.Duracao))</b><span>@KmTexto(o.Distancia) km</span>@if (i == 0) {<em>Mais rápida</em>}</span>
                                    <span class="mc-opcao-linha"><span>Chegada @((DateTime.Now + TimeSpan.FromSeconds(o.Duracao)).ToString("HH:mm"))</span>
                                        @if (o.Pedagios.Count > 0 || o.TemPedagio)
                                        {
                                            var quantos = o.Pedagios.Count switch { 0 => "Com pedágio", 1 => "1 pedágio", var n => $"{n} pedágios" };
                                            <span class="mc-com-pedagio"><span class="mc-pedagio-ponto"></span>@quantos@(o.PrecoPedagio is { } preco ? $" · {preco}" : "")</span>
                                        }
                                        else
                                        {
                                            <span class="mc-sem-pedagio">Sem pedágio</span>
                                        }
                                        @if (o.Transito >= 180)
                                        {
                                            <span class="mc-transito">+@Math.Round(o.Transito / 60) min de trânsito</span>
                                        }
                                        @if (o.Radares.Count > 0)
                                        {
                                            <span class="mc-com-radar"><span class="mc-radar-ponto"></span>@(o.Radares.Count == 1 ? "1 radar" : $"{o.Radares.Count} radares")</span>
                                        }
                                    </span>
                                </button>
                            }
                        }
                        else
                        {
                            <p class="mc-previa-calculando">Calculando as rotas…</p>
                        }
                    </div>
                    <div class="mc-previa-acoes">
                        <button class="mc-btn" type="button" @onclick="Encerrar">Cancelar</button>
                        <button class="mc-btn primario" type="button" disabled="@(Rota.Opcoes is null)" @onclick="Rota.Iniciar">@Icones.Navegacao Iniciar</button>
                    </div>
                </section>
            }
            else
            {
            <section class="mc-card mc-player">
                <div class="mc-capa">
                    @if (musica?.Capa is { } capa)
                    {
                        <img src="@capa" alt="" />
                    }
                    else
                    {
                        @Icones.Musica
                    }
                </div>
                <div class="mc-musica">
                    @if (musica?.Titulo is { } titulo)
                    {
                        <b>@titulo</b>
                        <span>@musica.Artista</span>
                    }
                    else
                    {
                        <b>Spotify</b>
                        <span class="mc-dica">Toque play ou troque de música. Se nada aparecer, ative no Spotify: Configurações → <b>Transmissão do status do dispositivo</b>.</span>
                    }
                </div>
                <div class="mc-controles">
                    <button class="mc-redondo" type="button" aria-label="Anterior" @onclick="Modo.Anterior">@Icones.Anterior</button>
                    <button class="mc-redondo grande" type="button" aria-label="@(musica?.Tocando == true ? "Pausar" : "Tocar")" @onclick="Modo.TocarPausar">
                        @(musica?.Tocando == true ? Icones.Pausar : Icones.Tocar)
                    </button>
                    <button class="mc-redondo" type="button" aria-label="Próxima" @onclick="Modo.Proxima">@Icones.Proxima</button>
                </div>
            </section>

            <nav class="mc-apps" aria-label="Abrir apps">
                <button class="mc-app" type="button" @onclick="() => Abrir(AppsCarro.Spotify)">@Icones.Musica<span>Spotify</span></button>
                <button class="mc-app" type="button" @onclick="() => Abrir(AppsCarro.Maps)">@Icones.Navegacao<span>Maps</span></button>
                <button class="mc-app" type="button" @onclick="() => Abrir(AppsCarro.Waze)">@Icones.Navegacao<span>Waze</span></button>
            </nav>
            @if (Visor.Disponivel && Store.Dados.Config.TesteVisor)
            {
                <button class="mc-btn mc-testar-visor" type="button" @onclick="AbrirTesteVisor">@(Visor.Testando ? "Teste do visor ligado" : "Testar visor da central")</button>
            }
            }
        </aside>

        @if (Visor.Testando && !_visorMinimizado)
        {
            var etapa = TesteVisor.Etapas[Visor.Etapa];
            var ultima = Visor.Etapa == TesteVisor.Etapas.Count - 1;
            <div class="mc-visor">
                <div class="mc-visor-painel">
                    <header class="mc-visor-topo">
                        <div>
                            <small>Teste do visor · etapa @(Visor.Etapa + 1) de @TesteVisor.Etapas.Count</small>
                            <h2>@etapa.Nome</h2>
                        </div>
                        <button class="mc-btn" type="button" @onclick="() => _visorMinimizado = true">Minimizar</button>
                    </header>
                    <p class="mc-visor-instrucao">@etapa.Instrucao</p>

                    @if (Visor.Enviando is { } t)
                    {
                        <div class="mc-visor-enviando">
                            <small>Mandando para o visor agora</small>
                            <b>@t.Titulo</b>
                            <span>@t.Artista</span>
                            <span>@t.Album</span>
                            <span>@t.Genero</span>
                        </div>
                    }

                    <div class="mc-visor-respostas">
                        @if (etapa.Sim is { } sim && etapa.Nao is { } nao)
                        {
                            <button class="mc-btn primario" type="button" @onclick="() => Visor.Anotar(TesteVisor.Apareceu)">@sim</button>
                            <button class="mc-btn" type="button" @onclick="() => Visor.Anotar(TesteVisor.NaoApareceu)">@nao</button>
                        }
                        <button class="mc-btn" type="button" @onclick="() => Visor.Anotar(TesteVisor.MusicaParou)">A música parou</button>
                        <button class="mc-btn" type="button" @onclick="() => Visor.Anotar(TesteVisor.AcentosComDefeito)">Acentos com defeito</button>
                        @if (!ultima)
                        {
                            <button class="mc-btn" type="button" @onclick="Visor.ProximaEtapa">Pular etapa</button>
                        }
                    </div>

                    <div class="mc-visor-log">
                        @foreach (var linha in Visor.Linhas.TakeLast(8))
                        {
                            <code>@linha</code>
                        }
                    </div>

                    <div class="mc-visor-acoes">
                        <button class="mc-btn" type="button" @onclick="CompartilharLogVisor">Enviar o log</button>
                        <button class="mc-btn perigo" type="button" @onclick="Visor.Parar">Parar o teste</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private System.Threading.Timer? _relogio;
    private DotNetObjectReference<ModoCarro>? _ref;
    private bool _mapaPronto, _seguindo = true;
    private PosicaoCarro? _enviada;
    private int _versaoEnviada = -1;

    // Objeto JS do mapa: "modoCarroGoogle" (com a chave do Google) ou "modoCarro" (MapLibre/OpenStreetMap)
    private string _js = "modoCarro";

    /// <summary>Abre o mapa do Google (com a chave) ou o do OpenStreetMap. Se o Google não abrir, usa o OpenStreetMap.</summary>
    private async Task<bool> AbrirMapa(bool google)
    {
        try
        {
            if (google)
            {
                await JS.InvokeVoidAsync("crankohub.carregarScript", "js/modo-carro-google.js");
                var cfg = Store.Dados.Config;
                if (await JS.InvokeAsync<bool>("modoCarroGoogle.iniciar", "mc-mapa", _ref, cfg.ChaveGoogleMaps, cfg.MapaIdGoogle))
                {
                    _js = "modoCarroGoogle";
                    _mapaPronto = true;
                    return true;
                }
                Toast.Erro("Não foi possível abrir o mapa do Google: usando o OpenStreetMap.");
            }
            await JS.InvokeVoidAsync("crankohub.carregarCss", "lib/maplibre-gl/maplibre-gl.css");
            await JS.InvokeVoidAsync("crankohub.carregarScript", "lib/maplibre-gl/maplibre-gl.js");
            await JS.InvokeVoidAsync("crankohub.carregarScript", "js/modo-carro.js");
            await JS.InvokeVoidAsync("modoCarro.iniciar", "mc-mapa", _ref);
            _js = "modoCarro";
            _mapaPronto = true;
            return true;
        }
        catch (JSException ex)
        {
            Toast.Erro($"Não foi possível abrir o mapa: {ex.Message}");
            return false;
        }
    }

    /// <summary>O Google recusou a chave depois de abrir: troca para o mapa do OpenStreetMap e redesenha tudo.</summary>
    [JSInvokable]
    public async Task GoogleFalhou(string mensagem)
    {
        if (_js != "modoCarroGoogle") return;
        Toast.Erro($"{mensagem} Usando o OpenStreetMap.");
        _mapaPronto = false;
        try { await JS.InvokeVoidAsync("modoCarroGoogle.destruir"); } catch (JSException) { }
        await JS.InvokeVoidAsync("crankohub.limpar", "mc-mapa");
        if (!await AbrirMapa(google: false)) return;
        if (_layoutPronto) await JS.InvokeVoidAsync("modoCarroLayout.mapa", _js);
        _versaoEnviada = -1;
        _enviada = null;
        StateHasChanged();
    }

    // Erro do Google na busca ou na rota: avisa uma vez por mensagem (a busca e a rota seguiram pelo OpenStreetMap)
    private string? _erroGoogleAvisado;

    private void AvisarErroGoogle()
    {
        if (Rota.ErroGoogle is not { } erro || erro == _erroGoogleAvisado) return;
        _erroGoogleAvisado = erro;
        Toast.Erro($"{erro} Usando o OpenStreetMap.");
    }


    protected override async Task OnInitializedAsync()
    {
        if (!Modo.Disponivel) return;
        Modo.Mudou += Mudou;
        Rota.Mudou += Mudou;
        Visor.Mudou += Mudou;
        // Hora da barra de cima
        _relogio = new System.Threading.Timer(_ => Mudou(), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
        await Modo.Entrar();
        // A rota vai para o visor da central sozinha quando começar (Configurações → Modo Carro)
        Visor.Entrar();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Modo.Disponivel) return;
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            if (!await AbrirMapa(google: Rota.UsaGoogle)) return;
            try
            {
                await JS.InvokeVoidAsync("crankohub.carregarScript", "js/modo-carro-layout.js");
                await JS.InvokeVoidAsync("modoCarroLayout.iniciar", _raiz, _ref, "mc-mapa", _js);
                _layoutPronto = true;
            }
            catch (JSException) { } // sem a barra de arrastar: o tamanho ainda muda pelas Configurações
        }
        if (_focarBusca)
        {
            _focarBusca = false;
            await JS.InvokeVoidAsync("crankohub.focar", _campoBusca);
        }
        await EnviarRota();
        await EnviarPosicao();
    }

    // Só manda ao mapa quando a posição muda (o relógio e o Spotify também redesenham a página)
    private async Task EnviarPosicao()
    {
        if (!_mapaPronto || Modo.Posicao is not { } p || p == _enviada) return;
        _enviada = p;
        Rota.Atualizar(p);
        try
        {
            await JS.InvokeVoidAsync($"{_js}.posicao", p.Latitude, p.Longitude, p.Direcao, p.VelocidadeKmh);
        }
        catch (JSDisconnectedException) { }
    }

    // A linha da rota só vai ao mapa quando muda (rota nova, recalculada ou encerrada)
    private async Task EnviarRota()
    {
        if (!_mapaPronto || Rota.Versao == _versaoEnviada) return;
        _versaoEnviada = Rota.Versao;
        // Prévia: todas as opções (pedágios da marcada); navegando: só a rota escolhida
        var (lista, marcada, modo) = Rota.Atual is { } atual ? (new[] { atual }, 0, "navegando")
            : Rota.Opcoes is { } opcoes ? (opcoes.ToArray(), Rota.Escolhida, "previa")
            : (Array.Empty<RotaAtiva>(), 0, (string?)null);
        var pracas = lista.Length > 0 ? lista[marcada].Pedagios.Select(p => new[] { p.Longitude, p.Latitude }).ToArray() : [];
        var radares = lista.Length > 0 ? lista[marcada].Radares.Select(r => new[] { r.Longitude, r.Latitude }).ToArray() : [];
        try
        {
            await JS.InvokeVoidAsync($"{_js}.rotas", lista.Select(r => r.Coordenadas).ToArray(), marcada, pracas, radares, modo);
        }
        catch (JSDisconnectedException) { }
    }

    /// <summary>O usuário arrastou o mapa (false) ou recentralizou (true).</summary>
    [JSInvokable]
    public void SeguindoMudou(bool seguindo)
    {
        _seguindo = seguindo;
        StateHasChanged();
    }

    private async Task Recentralizar() => await JS.InvokeVoidAsync($"{_js}.seguir");

    // ===== Busca de destino =====

    private bool _buscando, _procurando, _focarBusca;
    private string _termo = "";
    private string? _erroBusca;
    private List<LugarBusca> _resultados = [];
    private CancellationTokenSource? _busca;
    private ElementReference _campoBusca;

    private void AbrirBusca()
    {
        _buscando = _focarBusca = true;
        _termo = "";
        _resultados = [];
    }

    private void FecharBusca()
    {
        _busca?.Cancel();
        _buscando = false;
    }

    // Procura enquanto digita, esperando uma pausa de 450 ms (não pesa o serviço gratuito)
    private async Task Digitou(ChangeEventArgs e)
    {
        _termo = e.Value?.ToString() ?? "";
        _busca?.Cancel();
        _erroBusca = null;
        if (_termo.Trim().Length < 3)
        {
            _resultados = [];
            _procurando = false;
            return;
        }
        var busca = _busca = new CancellationTokenSource();
        _procurando = true;
        try
        {
            await Task.Delay(450, busca.Token);
            _resultados = await Rota.Buscar(_termo.Trim(), Modo.Posicao, busca.Token);
            AvisarErroGoogle();
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            _resultados = [];
            _erroBusca = "Não foi possível buscar agora. Confira a internet.";
        }
        _procurando = false;
    }

    private async Task Ir(LugarBusca lugar)
    {
        FecharBusca();
        if (Modo.Posicao is not { } origem)
        {
            Toast.Erro("Esperando o GPS para calcular a rota.");
            return;
        }
        var ok = await Rota.Planejar(lugar, origem);
        AvisarErroGoogle();
        if (!ok)
            Toast.Erro("Não foi possível calcular a rota até esse lugar. Confira a internet ou tente outro destino.");
    }

    private void Encerrar() => Rota.Encerrar();

    // Distância em linha reta na frente do endereço, para escolher o certo entre nomes iguais
    private string? Detalhe(LugarBusca l)
    {
        // Sugestão do Google: ainda sem coordenada, a distância vem dele
        double? metros = l.PlaceId is not null ? l.Metros
            : Modo.Posicao is { } p ? RotaService.Distancia(p.Latitude, p.Longitude, l.Latitude, l.Longitude) : null;
        if (metros is not { } m) return l.Detalhe;
        var longe = RotaService.TextoDistancia(m);
        return l.Detalhe is null ? longe : $"{longe} · {l.Detalhe}";
    }

    private static string TempoTexto(TimeSpan t) =>
        t.TotalMinutes >= 60 ? $"{(int)t.TotalHours}:{t.Minutes:00}" : Math.Max(1, Math.Round(t.TotalMinutes)).ToString("0");

    private static string KmTexto(double metros) => (metros / 1000).ToString(metros < 100_000 ? "0.0" : "0", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));

