    // ===== Layout (Configurações → Modo Carro) =====

    private ElementReference _raiz;
    private bool _layoutPronto, _miniRecolhido;

    // Tamanhos do painel em variáveis CSS: --mc-painel (paisagem) e --mc-painel-r (retrato). Sem valor = tamanho do conteúdo.
    private static string EstiloPainel(Models.Configuracoes cfg, string layout)
    {
        var partes = new List<string>(2);
        if (LayoutsCarro.Tamanho(cfg, layout, retrato: false) is { } p) partes.Add($"--mc-painel: {p}%");
        if (LayoutsCarro.Tamanho(cfg, layout, retrato: true) is { } r) partes.Add($"--mc-painel-r: {r}%");
        return string.Join("; ", partes);
    }

    private void TrocarLayout()
    {
        var cfg = Store.Dados.Config;
        cfg.LayoutCarro = LayoutsCarro.Proximo(cfg.LayoutCarro);
        _miniRecolhido = false;
        Store.Salvar();
        Toast.Ok(LayoutsCarro.Nome(cfg.LayoutCarro));
    }

    /// <summary>A barra entre o mapa e o painel foi arrastada (modo-carro-layout.js).</summary>
    [JSInvokable]
    public void PainelMudou(int pct, bool retrato)
    {
        var cfg = Store.Dados.Config;
        var tela = LayoutsCarro.Valido(cfg.LayoutCarro);
        if (!LayoutsCarro.TemTamanho(tela)) return;
        cfg.TamanhoPainelCarro[LayoutsCarro.Chave(tela, retrato)] = Math.Clamp(pct, LayoutsCarro.Minimo(tela), LayoutsCarro.Maximo(tela));
        Store.Salvar();
        StateHasChanged();
    }

    /// <summary>Toque duplo na barra: volta ao tamanho padrão do layout.</summary>
    [JSInvokable]
    public void PainelPadrao(bool retrato)
    {
        var cfg = Store.Dados.Config;
        cfg.TamanhoPainelCarro.Remove(LayoutsCarro.Chave(cfg.LayoutCarro, retrato));
        Store.Salvar();
        StateHasChanged();
    }

    // ===== Resto =====

    private void Mudou() => _ = InvokeAsync(StateHasChanged);

    private void Sair() => Nav.NavigateTo("carro");

    private void Abrir(string app)
    {
        if (!Modo.AbrirApp(app)) Toast.Erro($"O {AppsCarro.Nome(app)} não está instalado.");
    }

    public async ValueTask DisposeAsync()
    {
        Modo.Mudou -= Mudou;
        Rota.Mudou -= Mudou;
        Visor.Mudou -= Mudou;
        // O visor da central volta para a música do Spotify ao sair do Modo Carro
        Visor.Sair();
        _busca?.Cancel();
        _relogio?.Dispose();
        // Também ao sair pelo botão voltar do Android. A rota continua no RotaService e volta ao abrir de novo.
        Modo.Sair();
        if (_layoutPronto)
        {
            try { await JS.InvokeVoidAsync("modoCarroLayout.destruir"); }
            catch (JSDisconnectedException) { }
        }
        if (_mapaPronto)
        {
            try { await JS.InvokeVoidAsync($"{_js}.destruir"); }
            catch (JSDisconnectedException) { }
        }
        _ref?.Dispose();
    }
