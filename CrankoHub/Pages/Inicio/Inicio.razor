@namespace CrankoHub.Pages
@page "/"
@implements IDisposable
@inject ArmazenamentoService Store
@inject ContaService Conta
@inject CarroBluetoothService Bluetooth

@*
    Início (layout "Fusão"): cabeçalho com a data, a saudação e o resumo do dia; a faixa "Precisa de atenção";
    e um mosaico de blocos, um por módulo, na ordem de Configurações → Módulos. Os blocos têm tamanhos diferentes
    (Dieta, Agenda e Tarefas são altos; Entretenimento e a Atividade recente são largos) e a grade preenche os buracos.
*@
@{
    var d = Store.Dados;
    var rs = DietaCalculos.Ordenados(d.Dieta.Registros);
    var last = rs.LastOrDefault();
    var veic = CarroCalculos.VeiculoAtivo(d.Carro);
    var abs = veic is null ? [] : CarroCalculos.DoVeiculo(d.Carro, veic.Id);
    var st = CarroCalculos.Estatisticas(abs);
    var gastoMes = CarroCalculos.GastoNoMes(abs, Hoje);

    // Peso de ~30 dias atrás (registro mais próximo)
    double? var30 = null;
    if (last is not null && rs.Count > 1)
    {
        var alvo = last.Data.DayNumber - 30;
        var referencia = rs.MinBy(r => Math.Abs(r.Data.DayNumber - alvo))!;
        if (referencia != last) var30 = last.Peso - referencia.Peso;
    }
    var meta = d.Dieta.Perfil.Meta;
    var perdendo = meta is null || rs.Count == 0 || meta < rs[0].Peso;

    var agora = DateTime.Now;
    var saudacao = agora.Hour < 12 ? "Bom dia" : agora.Hour < 18 ? "Boa tarde" : "Boa noite";
    if (Conta.Usuario is { Length: > 0 } nome) saudacao += ", " + char.ToUpper(nome[0]) + nome[1..];

    var atividades = (Modulo.Visivel(d.Config, Modulo.Dieta) ? rs : []).TakeLast(6)
        .Select(r => (r.Data, Icone: Icones.Balanca, Cor: Modulo.CorDe(d.Config, Modulo.Dieta), Texto: $"{Num(r.Peso)} kg registrados", Sub: string.IsNullOrEmpty(r.Obs) ? Modulo.De(d.Config, Modulo.Dieta)!.Nome : r.Obs))
        .Concat((Modulo.Visivel(d.Config, Modulo.Carro) ? abs : []).TakeLast(6).Select(a => (a.Data, Icone: Icones.Bomba, Cor: Modulo.CorDe(d.Config, Modulo.Carro),
            Texto: $"{Num(a.Litros, 1)} L de {Combustivel.NomeDe(a.Combustivel)}{(a.Valor > 0 ? " · " + Money(a.Valor) : "")}",
            Sub: $"{veic?.Nome} · {(a.Inicial ? "ponto de partida" : Num(a.Kml, 2) + " km/l")}")))
        .OrderByDescending(x => x.Data)
        .Take(5)
        .ToList();

    var alertas = Alertas.Gerar(d, Hoje);
    var resumo = TarefasCalculos.ResumoDoDia(d.Tarefas, Hoje);
    var assinAtivas = d.Assinaturas.Where(a => a.Ativa).ToList();
    var custoAssin = assinAtivas.Sum(AssinaturasCalculos.PorMes);
    var proximasCobrancas = AssinaturasCalculos.CobrancasAte(assinAtivas, Hoje, 30);

    var cfg = d.Config;
    var (verDieta, verCarro) = (Modulo.Visivel(cfg, Modulo.Dieta), Modulo.Visivel(cfg, Modulo.Carro));
    var agenda = AgendaCalculos.ResumoDe(d.Agenda, agora);

    // Mini-gráficos: últimos 90 dias
    var corte = Hoje.AddDays(-90);

    // Resumo do dia no cabeçalho: só o que existe e está visível
    var partes = new List<string>();
    if (Modulo.Visivel(cfg, Modulo.Agenda) && agenda.Hoje > 0) partes.Add($"{agenda.Hoje} {Plural(agenda.Hoje, "compromisso", "compromissos")}");
    var tarefasHoje = resumo.ParaHoje.Count + resumo.Atrasados.Count;
    if (Modulo.Visivel(cfg, Modulo.Tarefas) && tarefasHoje > 0) partes.Add($"{tarefasHoje} {Plural(tarefasHoje, "tarefa", "tarefas")}");
    var cobrancasPerto = proximasCobrancas.Count(c => c.Data.DayNumber - Hoje.DayNumber <= 1);
    if (Modulo.Visivel(cfg, Modulo.Assinaturas) && cobrancasPerto > 0) partes.Add($"{cobrancasPerto} {Plural(cobrancasPerto, "cobrança", "cobranças")} chegando");
}

<header class="pagina-cab ini-cab">
    <div class="pagina-titulo">
        <p class="pagina-sobre ini-data">@DataPorExtenso(agora)</p>
        <h1>@saudacao</h1>
        <p class="ini-resumo">
            @if (partes.Count > 0)
            {
                <text>Hoje: </text>
                @for (var i = 0; i < partes.Count; i++)
                {
                    @(i == 0 ? "" : i == partes.Count - 1 ? " e " : ", ")<b>@partes[i]</b>
                }
                <text>.</text>
            }
            else
            {
                <text>Nada marcado para hoje. Bom momento para registrar alguma coisa.</text>
            }
        </p>
    </div>
    <div class="topo-acoes">
        <a class="btn" href="configuracoes?aba=modulos" title="Escolher a ordem, o nome e a cor dos módulos">@Icones.Layout<span class="rotulo">Organizar</span></a>
    </div>
</header>

@if (verCarro && cfg.Estacionado is { } estacionado)
{
    @* Guardado quando o Bluetooth do carro desconectou (Configurações → Modo Carro → Onde estacionei) *@
    <section class="card estacionado brilho" style="--c:@Modulo.CorDe(cfg, Modulo.Carro)" aria-label="Carro estacionado">
        <span class="estacionado-icone" aria-hidden="true">@Icones.Carro</span>
        <div class="estacionado-texto">
            <b>Carro estacionado</b>
            <span>@(estacionado.Endereco ?? "Endereço não encontrado") · @HaQuanto(estacionado.Quando)</span>
        </div>
        <div class="estacionado-acoes">
            <button type="button" class="btn primary" @onclick="Bluetooth.ComoChegar">Como chegar</button>
            <button type="button" class="btn" @onclick="Bluetooth.EsquecerEstacionado">Já peguei o carro</button>
        </div>
    </section>
}

@* Precisa de atenção: faixa com as pendências de todas as áreas (a cor da marca é a urgência) *@
<section class="faixa-atencao @(alertas.Count == 0 ? "vazia" : "")" aria-label="Precisa de atenção">
    @if (alertas.Count > 0)
    {
        @foreach (var a in alertas)
        {
            <a class="fa-item" href="@a.Link" @key="a.Chave" data-nivel="@a.Classe" title="@a.Badge">
                <span class="fa-marca" aria-hidden="true"></span>
                <span class="fa-texto"><b>@a.Titulo</b><small>@a.Detalhe</small></span>
            </a>
        }
    }
    else
    {
        <div class="fa-item"><span class="fa-marca" aria-hidden="true"></span><span class="fa-texto"><b>Tudo em dia</b><small>Nenhuma pendência em nenhuma área.</small></span></div>
    }
</section>

<div class="mosaico">
@foreach (var m in Modulo.Visiveis(cfg))
{
    switch (m.Id)
    {
        case Modulo.Dieta:
    <a class="card bloco alto brilho" href="dieta" style="--c:@m.Cor" @key="m.Id">
        <div class="b-cab"><span class="b-ic">@m.Icone</span>@m.Nome<span class="b-dir">90 dias</span></div>
        @if (last is not null)
        {
            <div class="b-num">@Num(last.Peso)<small>kg</small></div>
            <p class="b-sub">
                @if (var30 is not null)
                {
                    <Delta Valor="var30" Unidade=" kg" BomQuandoCai="perdendo" /> <span>em 30 dias</span>
                }
                else
                {
                    <span>Último registro em @DataBR(last.Data)</span>
                }
            </p>
            @if (meta is not null)
            {
                <p class="b-sub">Meta @Num(meta) kg · @(Math.Abs(last.Peso - meta.Value) < 0.05 ? "atingida" : $"faltam {Num(Math.Abs(last.Peso - meta.Value))} kg")</p>
            }
        }
        else
        {
            <div class="b-num vazio">—</div>
            <p class="b-sub">Registre seu primeiro peso.</p>
        }
        <div class="b-graf">
            <GraficoLinha Compacto="true" Altura="250" FormatoY="new FormatoNumero(1)" Formato="FormatoNumero.Kg" MsgVazia="Sem pesos nos últimos 90 dias."
                          Series="@([new SerieLinha("Peso", m.Cor, rs.Where(r => r.Data > corte).Select(r => new PontoLinha(r.Data, r.Peso)).ToList(), Markers: false, Area: true)])" />
        </div>
    </a>
            break;

        case Modulo.Carro:
    <a class="card bloco brilho" href="carro" style="--c:@m.Cor" @key="m.Id">
        <div class="b-cab"><span class="b-ic">@m.Icone</span>@(veic?.Nome ?? m.Nome)<span class="b-dir">@(veic is null ? "" : "consumo médio")</span></div>
        @if (veic is null)
        {
            <p class="b-sub b-convite">Cadastre seu veículo para acompanhar consumo, gastos, manutenção e documentos.</p>
        }
        else
        {
            <div class="b-num">@(st.Media is not null ? Num(st.Media) : "—")<small>km/l</small></div>
            <div class="b-rodape">
                <div><span>Gasto no mês</span><b>@Money(gastoMes)</b></div>
                <div><span>Custo por km</span><b>@Money(st.CustoKm)</b></div>
            </div>
        }
    </a>
            break;

        case Modulo.Assinaturas:
        {
    var proxima = proximasCobrancas.FirstOrDefault();
    var porValor = assinAtivas.OrderByDescending(AssinaturasCalculos.PorMes).ToList();
    <a class="card bloco brilho" href="assinaturas" style="--c:@m.Cor" @key="m.Id">
        <div class="b-cab"><span class="b-ic">@m.Icone</span>@m.Nome<span class="b-dir">@assinAtivas.Count @Plural(assinAtivas.Count, "ativa", "ativas")</span></div>
        <div class="b-num">@Num(custoAssin, 0)<small>R$/mês</small></div>
        @if (porValor.Count > 0)
        {
            @* Quanto cada uma pesa no mês: tons da cor do módulo, da mais cara para a mais barata *@
            <div class="b-composicao" aria-hidden="true">
                @for (var i = 0; i < porValor.Count; i++)
                {
                    <span style="flex:@(AssinaturasCalculos.PorMes(porValor[i]).ToString(System.Globalization.CultureInfo.InvariantCulture));opacity:@((1 - i * 0.7 / Math.Max(1, porValor.Count - 1)).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"></span>
                }
            </div>
        }
        <div class="b-rodape">
            @if (proxima.Assinatura is not null)
            {
                var (prazo, _) = AssinaturasCalculos.Prazo(proxima.Data.DayNumber - Hoje.DayNumber);
                <div><span>Próxima</span><b>@proxima.Assinatura.Nome, @prazo.ToLowerInvariant()</b></div>
                <div><span>Valor</span><b>@Money(proxima.Assinatura.Valor)</b></div>
            }
            else
            {
                <div><span>Próximos 30 dias</span><b>Nenhuma cobrança</b></div>
            }
        </div>
    </a>
            break;
        }

        case Modulo.Agenda:
        {
    // Hoje: o que ainda falta hoje. Semana/Mês: de agora até 7/30 dias à frente (não a semana/mês do calendário)
    var periodoDias = _periodoAgenda switch { VisaoAgenda.Semana => 7, VisaoAgenda.Mes => 30, _ => 1 };
    var doPeriodo = _periodoAgenda == VisaoAgenda.Dia ? agenda.Proximos
        : AgendaCalculos.Ocorrencias(d.Agenda, agora, Hoje.AddDays(periodoDias).ToDateTime(TimeOnly.MinValue))
            .Where(o => o.Fim > agora || (o.NoTopo && o.Data >= Hoje) || (o.Fim == o.Inicio && o.Inicio >= agora))
            .OrderBy(o => o.Data).ThenBy(o => !o.NoTopo).ThenBy(o => o.Inicio).ToList();
    var maxItens = 5;
    <section class="card bloco alto" style="--c:@m.Cor" @key="m.Id">
        <a class="b-cab b-cab-link" href="agenda?dia=@Iso(Hoje)&visao=@_periodoAgenda"><span class="b-ic">@m.Icone</span>@m.Nome<span class="b-dir">@agenda.Hoje hoje · @agenda.Semana em 7 dias</span></a>
        <div class="chips cartao-ini-chips" role="group" aria-label="Período da agenda">
            @foreach (var (visao, rotulo) in PeriodosAgenda)
            {
                <button type="button" class="chip @(_periodoAgenda == visao ? "active" : "")" aria-pressed="@(_periodoAgenda == visao)"
                        @onclick="() => _periodoAgenda = visao">@rotulo</button>
            }
        </div>
        @if (doPeriodo.Count > 0)
        {
            <ul class="b-lista">
                @foreach (var o in doPeriodo.Take(maxItens))
                {
                    var acontecendo = !o.NoTopo && o.Inicio <= agora && o.Fim > agora;
                    var quando = o.Data <= Hoje
                        ? (o.NoTopo ? "dia todo" : o.Inicio <= agora ? "agora" : AgendaCalculos.Hora(o.Inicio))
                        : $"{(o.Data == Hoje.AddDays(1) ? "amanhã" : $"{AgendaCalculos.DiaSemanaCurto(o.Data)} {o.Data.Day}")}{(o.NoTopo ? "" : " " + AgendaCalculos.Hora(o.Inicio))}";
                    <li>
                        <span class="b-hora @(acontecendo ? "agora" : "")">@quando</span>
                        <span class="b-item"><b>@(string.IsNullOrWhiteSpace(o.Evento.Titulo) ? "(sem título)" : o.Evento.Titulo)</b><small><span class="ag-bolinha" style="--c:@AgendaCalculos.CorDe(d.Agenda, o.Evento)"></span>@(o.Evento.Local ?? AgendaCalculos.AgendaDe(d.Agenda, o.Evento)?.Nome)</small></span>
                    </li>
                }
            </ul>
            @if (doPeriodo.Count > maxItens)
            {
                <a class="cartao-ini-mais" href="agenda?dia=@Iso(Hoje)&visao=@_periodoAgenda">+ @(doPeriodo.Count - maxItens) @Plural(doPeriodo.Count - maxItens, "compromisso", "compromissos")</a>
            }
        }
        else
        {
            <p class="b-vazio">@(_periodoAgenda switch
            {
                VisaoAgenda.Semana => "Nada marcado nos próximos 7 dias.",
                VisaoAgenda.Mes => "Nada marcado nos próximos 30 dias.",
                _ => agenda.Hoje > 0 ? "Os compromissos de hoje já passaram. ✓" : "Nenhum compromisso hoje.",
            })</p>
        }
    </section>
            break;
        }

        case Modulo.Tarefas:
        {
    var pendentesHoje = resumo.Atrasados.Concat(resumo.ParaHoje).Take(6).ToList();
    <a class="card bloco alto" href="tarefas?quadro=hoje" style="--c:@m.Cor" @key="m.Id">
        <div class="b-cab"><span class="b-ic">@m.Icone</span>@m.Nome de hoje<span class="b-dir">@resumo.ConcluidosHoje.Count de @(resumo.ConcluidosHoje.Count + tarefasHoje) feitas</span></div>
        @if (pendentesHoje.Count > 0 || resumo.ConcluidosHoje.Count > 0)
        {
            <ul class="b-lista">
                @foreach (var c in resumo.ConcluidosHoje.Take(2))
                {
                    <li class="feita"><span class="b-check feito"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span><span class="b-item"><b>@c.Titulo</b></span></li>
                }
                @foreach (var c in pendentesHoje)
                {
                    var q = TarefasCalculos.QuadroDe(d.Tarefas, c);
                    <li>
                        <span class="b-check"></span>
                        <span class="b-item"><b>@c.Titulo</b><small>@(q is null ? "" : TarefasCalculos.NomeQuadro(q))</small></span>
                        @if (c.Prazo is not null)
                        {
                            var (texto, classe) = TarefasCalculos.Prazo(c, DateTime.Now);
                            <span class="badge @classe">@texto</span>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="b-vazio">Nenhuma tarefa para hoje.</p>
        }
    </a>
            break;
        }

        case Modulo.Entretenimento:
        {
    // Continuar de onde parou: o que está em andamento; sem nada, os mais recentes
    var andamento = d.Entretenimento.Where(e => e.Status == "andamento").ToList();
    var estante = (andamento.Count > 0 ? andamento : d.Entretenimento.OrderByDescending(e => e.Data ?? DateOnly.MinValue).ToList()).Take(6).ToList();
    <a class="card bloco largo" href="entretenimento" style="--c:@m.Cor" @key="m.Id">
        <div class="b-cab"><span class="b-ic">@m.Icone</span>@(andamento.Count > 0 ? "Continuar de onde parou" : m.Nome)<span class="b-dir">@d.Entretenimento.Count(e => e.Status == "concluido" && e.Data?.Year == Hoje.Year) concluídos em @Hoje.Year</span></div>
        @if (estante.Count > 0)
        {
            <div class="b-estante">
                @foreach (var e in estante)
                {
                    var total = e.TotalEpisodios();
                    <div class="b-capa">
                        <Capa Item="e" />
                        <span class="b-capa-titulo">@e.Titulo</span>
                        @if (total > 0)
                        {
                            <span class="capa-progresso"><span style="width:@((100.0 * e.EpisodiosAssistidos() / total).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p class="b-vazio">Sua estante ainda está vazia.</p>
        }
    </a>
            break;
        }
    }
}

@if (verDieta || verCarro)
{
    <section class="card bloco largo atividade">
        <div class="b-cab"><span class="b-ic" style="--c:var(--accent)">@Icones.Relogio</span>Atividade recente<span class="b-dir">últimos registros</span></div>
        @if (atividades.Count > 0)
        {
            <ul class="b-lista">
                @foreach (var a in atividades)
                {
                    <li>
                        <span class="b-ic" style="--c:@a.Cor">@a.Icone</span>
                        <span class="b-item"><b>@a.Texto</b><small>@a.Sub</small></span>
                        <time>@DataBR(a.Data)</time>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="b-vazio">Nada registrado ainda. Comece por <a href="dieta">@Modulo.De(cfg, Modulo.Dieta)!.Nome</a> ou <a href="carro">@Modulo.De(cfg, Modulo.Carro)!.Nome</a>.</p>
        }
    </section>
}
</div>

@if (!Modulo.Visiveis(cfg).Any())
{
    <section class="card">
        <div class="chart-empty"><span>Todos os módulos estão escondidos. Escolha o que mostrar em <a href="configuracoes?aba=modulos">Configurações</a>.</span></div>
    </section>
}

@code {
    // O Início pode ficar aberto por horas (o app fica na bandeja): redesenha a cada minuto para a saudação e a data acompanharem
    private System.Threading.Timer? _relogio;

    // Período do bloco da Agenda (fica escolhido enquanto o app estiver aberto)
    private static string _periodoAgenda = VisaoAgenda.Dia;
    private static readonly (string Visao, string Rotulo)[] PeriodosAgenda =
        [(VisaoAgenda.Dia, "Hoje"), (VisaoAgenda.Semana, "Semana"), (VisaoAgenda.Mes, "Mês")];

    protected override void OnInitialized()
    {
        _relogio = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
        // O carro estacionado chega pelo Bluetooth (desligou o carro com o app aberto)
        Bluetooth.Mudou += Redesenhar;
    }

    private void Redesenhar() => _ = InvokeAsync(StateHasChanged);

    private static string HaQuanto(DateTime quando)
    {
        var t = DateTime.Now - quando;
        var ha = t.TotalMinutes < 1 ? "agora há pouco" : t.TotalHours < 1 ? $"há {(int)t.TotalMinutes} min"
            : t.TotalDays < 1 ? $"há {(int)t.TotalHours} h" : $"há {(int)t.TotalDays} {((int)t.TotalDays == 1 ? "dia" : "dias")}";
        return $"{ha} · {(quando.Date == DateTime.Today ? quando.ToString("HH:mm") : quando.ToString("dd/MM HH:mm"))}";
    }

    public void Dispose()
    {
        _relogio?.Dispose();
        Bluetooth.Mudou -= Redesenhar;
    }
}
