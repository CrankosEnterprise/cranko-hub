@namespace CrankoHub.Pages
@page "/"
@implements IDisposable
@inject ArmazenamentoService Store
@inject ContaService Conta
@inject CarroBluetoothService Bluetooth

@*
    Início (protótipo "Fusão", Redesign/imagens/e-fusao-inicio-*.png): cabeçalho com a data, a saudação, o resumo do
    dia e os botões Organizar / Registrar; a faixa "Precisa de atenção"; e o mosaico de blocos na ordem de
    Configurações → Módulos. Dieta e "Hoje" (agenda + tarefas num bloco só) são altos; o Entretenimento é largo;
    a grade preenche os buracos.
*@
@{
    var d = Store.Dados;
    var hoje = Hoje;
    var rs = DietaCalculos.Ordenados(d.Dieta.Registros);
    var last = rs.LastOrDefault();
    var veic = CarroCalculos.VeiculoAtivo(d.Carro);
    var abs = veic is null ? [] : CarroCalculos.DoVeiculo(d.Carro, veic.Id);
    var st = CarroCalculos.Estatisticas(abs);
    var manut = veic is null ? [] : ManutencaoCalculos.DoVeiculo(d.Carro, veic.Id);
    var inicioMes = new DateOnly(hoje.Year, hoje.Month, 1);
    var gastoMes = abs.Where(a => a.Data >= inicioMes).Sum(a => a.Valor ?? 0) + manut.Where(m => m.Data >= inicioMes).Sum(m => m.Valor ?? 0);
    var variacaoCarro = CarroCalculos.VariacaoTrimestre(abs, hoje);
    var tanque = veic is null ? null : CarroCalculos.TanqueAgora(abs, veic.Ficha?.TanqueLitros, ManutencaoCalculos.KmPorDia(abs, hoje), st.Media, hoje);

    // Peso de ~30 dias atrás (registro mais próximo)
    double? var30 = null;
    if (last is not null && rs.Count > 1)
    {
        var alvo = last.Data.DayNumber - 30;
        var referencia = rs.MinBy(r => Math.Abs(r.Data.DayNumber - alvo))!;
        if (referencia != last) var30 = last.Peso - referencia.Peso;
    }
    var meta = d.Dieta.Perfil.Meta;
    var perdendo = meta is null || rs.Count == 0 || meta < rs[0].Peso;

    var agora = DateTime.Now;
    var saudacao = agora.Hour < 12 ? "Bom dia" : agora.Hour < 18 ? "Boa tarde" : "Boa noite";
    if (Conta.Usuario is { Length: > 0 } nome) saudacao += ", " + char.ToUpper(nome[0]) + nome[1..];

    var alertas = Alertas.Gerar(d, hoje);
    var resumo = TarefasCalculos.ResumoDoDia(d.Tarefas, hoje);
    var assinAtivas = d.Assinaturas.Where(a => a.Ativa).ToList();
    var custoAssin = assinAtivas.Sum(AssinaturasCalculos.PorMes);
    var proximasCobrancas = AssinaturasCalculos.CobrancasAte(assinAtivas, hoje, 30);

    var cfg = d.Config;
    var agenda = AgendaCalculos.ResumoDe(d.Agenda, agora);
    var (verAgenda, verTarefas) = (Modulo.Visivel(cfg, Modulo.Agenda), Modulo.Visivel(cfg, Modulo.Tarefas));

    // Mini-gráfico do peso: últimos 90 dias
    var corte = hoje.AddDays(-90);

    // Resumo do dia no cabeçalho: só o que existe e está visível
    var partes = new List<string>();
    if (verAgenda && agenda.Hoje > 0) partes.Add($"{agenda.Hoje} {Plural(agenda.Hoje, "compromisso", "compromissos")}");
    var tarefasHoje = resumo.ParaHoje.Count + resumo.Atrasados.Count;
    if (verTarefas && tarefasHoje > 0) partes.Add($"{tarefasHoje} {Plural(tarefasHoje, "tarefa", "tarefas")}");
    var cobrancasPerto = proximasCobrancas.Count(c => c.Data.DayNumber - hoje.DayNumber <= 1);
    if (Modulo.Visivel(cfg, Modulo.Assinaturas) && cobrancasPerto > 0) partes.Add($"{cobrancasPerto} {Plural(cobrancasPerto, "cobrança", "cobranças")} chegando");

    // Blocos na ordem dos módulos; Agenda e Tarefas viram um bloco "Hoje" só, no lugar do primeiro dos dois
    var blocos = new List<string>();
    foreach (var m in Modulo.Visiveis(cfg))
    {
        var id = m.Id is Modulo.Agenda or Modulo.Tarefas ? BlocoHoje : m.Id;
        if (!blocos.Contains(id)) blocos.Add(id);
    }

    // Atalhos do "Registrar": só das áreas visíveis
    var registros = new List<(string Link, MarkupString Icone, string Texto, string Cor)>();
    if (Modulo.Visivel(cfg, Modulo.Dieta)) registros.Add(("dieta?novo=1", Icones.Balanca, "Peso", Modulo.CorDe(cfg, Modulo.Dieta)));
    if (Modulo.Visivel(cfg, Modulo.Carro) && veic is not null) registros.Add(("carro?novo=abastecimento", Icones.Bomba, "Abastecimento", Modulo.CorDe(cfg, Modulo.Carro)));
    if (Modulo.Visivel(cfg, Modulo.Assinaturas)) registros.Add(("assinaturas?novo=1", Icones.Assinaturas, "Assinatura", Modulo.CorDe(cfg, Modulo.Assinaturas)));
    if (verTarefas && d.Tarefas.Quadros.Count > 0) registros.Add(("tarefas?novo=hoje", Icones.Tarefas, "Tarefa para hoje", Modulo.CorDe(cfg, Modulo.Tarefas)));
    if (verAgenda) registros.Add(("agenda?novo=1", Icones.Agenda, "Compromisso", Modulo.CorDe(cfg, Modulo.Agenda)));
}

<header class="pagina-cab ini-cab">
    <div class="pagina-titulo">
        <p class="pagina-sobre ini-data">@DataPorExtenso(agora)</p>
        <h1>@saudacao</h1>
        <p class="ini-resumo">
            @if (partes.Count > 0)
            {
                <text>Hoje: </text>
                @for (var i = 0; i < partes.Count; i++)
                {
                    @(i == 0 ? "" : i == partes.Count - 1 ? " e " : ", ")<b>@partes[i]</b>
                }
                <text>.</text>
            }
            else
            {
                <text>Nada marcado para hoje. Bom momento para registrar alguma coisa.</text>
            }
        </p>
    </div>
    <div class="topo-acoes">
        <a class="btn" href="configuracoes?aba=modulos" title="Escolher a ordem, o nome e a cor dos módulos">@Icones.Layout<span class="rotulo">Organizar</span></a>
        @if (registros.Count > 0)
        {
            <div class="registrar">
                <button class="btn primary" type="button" aria-haspopup="menu" aria-expanded="@_registrar" @onclick="() => _registrar = !_registrar">@Icones.Mais<span class="rotulo">Registrar</span></button>
                @if (_registrar)
                {
                    <div class="conta-fundo" @onclick="() => _registrar = false"></div>
                    <div class="registrar-menu" role="menu">
                        @foreach (var (link, icone, texto, corReg) in registros)
                        {
                            <a role="menuitem" href="@link" style="--c:@corReg" @onclick="() => _registrar = false"><span class="b-ic">@icone</span>@texto</a>
                        }
                    </div>
                }
            </div>
        }
    </div>
</header>

@if (Modulo.Visivel(cfg, Modulo.Carro) && cfg.Estacionado is { } estacionado)
{
    @* Guardado quando o Bluetooth do carro desconectou (Configurações → Modo Carro → Onde estacionei) *@
    <section class="card estacionado brilho" style="--c:@Modulo.CorDe(cfg, Modulo.Carro)" aria-label="Carro estacionado">
        <span class="estacionado-icone" aria-hidden="true">@Icones.Carro</span>
        <div class="estacionado-texto">
            <b>Carro estacionado</b>
            <span>@(estacionado.Endereco ?? "Endereço não encontrado") · @HaQuanto(estacionado.Quando)</span>
        </div>
        <div class="estacionado-acoes">
            <button type="button" class="btn primary" @onclick="Bluetooth.ComoChegar">Como chegar</button>
            <button type="button" class="btn" @onclick="Bluetooth.EsquecerEstacionado">Já peguei o carro</button>
        </div>
    </section>
}

@* Precisa de atenção: faixa com as pendências de todas as áreas (a cor da marca é a urgência) *@
<section class="faixa-atencao @(alertas.Count == 0 ? "vazia" : "")" aria-label="Precisa de atenção">
    @if (alertas.Count > 0)
    {
        // Uma linha só: até 4 pendências; com mais, a última vaga vira "+N" e abre o resto
        var visiveis = _todasPendencias || alertas.Count <= 4 ? alertas : alertas.Take(3).ToList();
        @foreach (var a in visiveis)
        {
            <a class="fa-item" href="@a.Link" @key="a.Chave" data-nivel="@a.Classe" title="@a.Badge">
                <span class="fa-marca" aria-hidden="true"></span>
                <span class="fa-texto"><b>@a.Titulo</b><small>@a.Detalhe</small></span>
            </a>
        }
        @if (alertas.Count > 4)
        {
            <button type="button" class="fa-item fa-mais" @onclick="() => _todasPendencias = !_todasPendencias">
                <span class="fa-marca" aria-hidden="true"></span>
                <span class="fa-texto"><b>@(_todasPendencias ? "Mostrar menos" : $"+{alertas.Count - 3} pendências")</b><small>@(_todasPendencias ? "Voltar para as principais" : "Ver todas as áreas")</small></span>
            </button>
        }
    }
    else
    {
        <div class="fa-item"><span class="fa-marca" aria-hidden="true"></span><span class="fa-texto"><b>Tudo em dia</b><small>Nenhuma pendência em nenhuma área.</small></span></div>
    }
</section>

<div class="mosaico">
@foreach (var bloco in blocos)
{
    var m = Modulo.De(cfg, bloco);
    switch (bloco)
    {
        case Modulo.Dieta:
    <a class="card bloco alto brilho" href="dieta" style="--c:@m!.Cor" @key="bloco">
        <div class="b-cab"><span class="b-ic">@m.Icone</span>@m.Nome<span class="b-dir">90 dias</span></div>
        @if (last is not null)
        {
            <div class="b-num">@Num(last.Peso)<small>kg</small></div>
            <p class="b-sub">
                @if (var30 is not null)
                {
                    <span class="b-delta @((var30 < 0) == perdendo ? "bom" : "ruim")">@(var30 < 0 ? "−" : "+")@Num(Math.Abs(var30.Value)) kg</span><span>no mês</span>
                }
                else
                {
                    <span>Último registro em @DataBR(last.Data)</span>
                }
            </p>
            @if (meta is not null)
            {
                <p class="b-sub b-sub2">Meta @Num(meta) kg · @(Math.Abs(last.Peso - meta.Value) < 0.05 ? "atingida" : $"faltam {Num(Math.Abs(last.Peso - meta.Value))}")</p>
            }
        }
        else
        {
            <div class="b-num vazio">—</div>
            <p class="b-sub">Registre seu primeiro peso.</p>
        }
        <div class="b-graf">
            <GraficoLinha Compacto="true" Altura="250" FormatoY="new FormatoNumero(1)" Formato="FormatoNumero.Kg" MsgVazia="Sem pesos nos últimos 90 dias."
                          Series="@([new SerieLinha("Peso", m.Cor, rs.Where(r => r.Data > corte).Select(r => new PontoLinha(r.Data, r.Peso)).ToList(), Markers: false, Area: true)])" />
        </div>
    </a>
            break;

        case Modulo.Carro:
    <a class="card bloco brilho" href="carro" style="--c:@m!.Cor" @key="bloco">
        <div class="b-cab"><span class="b-ic">@m.Icone</span>@(veic?.Nome ?? m.Nome)<span class="b-dir">@(veic?.Ficha?.Placa ?? "")</span></div>
        @if (veic is null)
        {
            <p class="b-sub b-convite">Cadastre seu veículo para acompanhar consumo, gastos, manutenção e documentos.</p>
        }
        else
        {
            <div class="b-num-linha">
                <div>
                    <div class="b-num">@(st.Media is not null ? Num(st.Media) : "—")<small>km/l</small></div>
                    @if (variacaoCarro is double x)
                    {
                        <p class="b-sub"><span class="b-delta @(x >= 0 ? "bom" : "ruim")">@(x >= 0 ? "↑" : "↓") @Num(Math.Abs(x) * 100, 0)%</span><span>vs. 3 meses</span></p>
                    }
                </div>
                @if (tanque is { } t)
                {
                    const double r = 23, circ = 2 * Math.PI * r;
                    <div class="b-anel" title="Tanque estimado">
                        <svg viewBox="0 0 60 60" aria-hidden="true">
                            <circle cx="30" cy="30" r="@r" class="cv-anel-fundo" />
                            <circle cx="30" cy="30" r="@r" class="cv-anel-valor" style="stroke:@m.Cor"
                                    stroke-dasharray="@($"{(circ * t.Fracao).ToString(System.Globalization.CultureInfo.InvariantCulture)} {circ.ToString(System.Globalization.CultureInfo.InvariantCulture)}")" />
                        </svg>
                        <b>@Num(t.Fracao * 100, 0)%</b>
                    </div>
                }
            </div>
            <div class="b-rodape">
                <div><span>@NomeMes(hoje)</span><b>@Money(gastoMes)</b></div>
                <div><span>@(tanque is null ? "Custo por km" : "Tanque")</span><b>@(tanque is { } t2 ? Num(t2.Fracao * 100, 0) + "%" : Money(st.CustoKm))</b></div>
            </div>
        }
    </a>
            break;

        case Modulo.Assinaturas:
        {
    var proxima = proximasCobrancas.FirstOrDefault();
    var porValor = assinAtivas.OrderByDescending(AssinaturasCalculos.PorMes).ToList();
    <a class="card bloco brilho" href="assinaturas" style="--c:@m!.Cor" @key="bloco">
        <div class="b-cab"><span class="b-ic">@m.Icone</span>@m.Nome<span class="b-dir">@assinAtivas.Count @Plural(assinAtivas.Count, "ativa", "ativas")</span></div>
        <div class="b-num">@Num(custoAssin, 0)<small>R$/mês</small></div>
        @if (porValor.Count > 0)
        {
            @* Quanto cada uma pesa no mês, na cor da marca, da mais cara para a mais barata *@
            <div class="b-composicao" aria-hidden="true">
                @foreach (var a in porValor)
                {
                    <span style="flex:@(AssinaturasCalculos.PorMes(a).ToString(System.Globalization.CultureInfo.InvariantCulture));background:@AssinaturasCalculos.CorDe(a)"></span>
                }
            </div>
        }
        <div class="b-rodape">
            @if (proxima.Assinatura is not null)
            {
                var (prazo, _) = AssinaturasCalculos.Prazo(proxima.Data.DayNumber - hoje.DayNumber);
                <div><span>Próxima</span><b>@proxima.Assinatura.Nome, @prazo</b></div>
                <div><span>Valor</span><b>@Money(proxima.Assinatura.Valor)</b></div>
            }
            else
            {
                <div><span>Próximos 30 dias</span><b>Nenhuma cobrança</b></div>
            }
        </div>
    </a>
            break;
        }

        case BlocoHoje:
        {
    // Hoje: os compromissos que ainda faltam e as tarefas do dia (feitas riscadas), num bloco só
    var corHoje = Modulo.CorDe(cfg, verAgenda ? Modulo.Agenda : Modulo.Tarefas);
    var pendentes = verTarefas ? resumo.Atrasados.Concat(resumo.ParaHoje).Take(6).ToList() : [];
    var feitas = verTarefas ? resumo.ConcluidosHoje.Take(Math.Max(0, 6 - pendentes.Count)).Take(2).ToList() : [];
    var eventos = verAgenda ? agenda.Proximos.Take(4).ToList() : [];
    <section class="card bloco alto bloco-hoje" style="--c:@corHoje" @key="bloco">
        <a class="b-cab b-cab-link" href="@(verAgenda ? $"agenda?dia={Iso(hoje)}&visao=dia" : "tarefas?quadro=hoje")"><span class="b-ic">@Icones.Agenda</span>Hoje
            @if (verTarefas)
            {
                <span class="b-dir">@resumo.ConcluidosHoje.Count de @(resumo.ConcluidosHoje.Count + tarefasHoje) tarefas</span>
            }
        </a>
        @if (eventos.Count == 0 && pendentes.Count == 0 && feitas.Count == 0)
        {
            <p class="b-vazio">Nada para hoje.</p>
        }
        <ul class="b-lista">
            @foreach (var o in eventos)
            {
                var acontecendo = !o.NoTopo && o.Inicio <= agora && o.Fim > agora;
                <li>
                    <span class="b-hora @(acontecendo ? "agora" : "")">@(o.NoTopo ? "dia" : acontecendo ? "agora" : AgendaCalculos.Hora(o.Inicio))</span>
                    <a class="b-item" href="agenda?dia=@Iso(hoje)&visao=dia"><b>@(string.IsNullOrWhiteSpace(o.Evento.Titulo) ? "(sem título)" : o.Evento.Titulo)</b><small>@(o.Evento.Local ?? AgendaCalculos.AgendaDe(d.Agenda, o.Evento)?.Nome)</small></a>
                </li>
            }
            @foreach (var c in feitas)
            {
                <li class="feita"><span class="b-check feito"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span><a class="b-item" href="tarefas?card=@c.Id"><b>@c.Titulo</b></a></li>
            }
            @foreach (var c in pendentes)
            {
                var q = TarefasCalculos.QuadroDe(d.Tarefas, c);
                var atrasada = c.Prazo < hoje;
                <li>
                    <span class="b-check"></span>
                    <a class="b-item" href="tarefas?card=@c.Id"><b>@c.Titulo</b></a>
                    <span class="b-quadro @(atrasada ? "ruim" : "")">@(atrasada ? "atrasada" : q is null ? "" : TarefasCalculos.NomeQuadro(q))</span>
                </li>
            }
        </ul>
        @if (verTarefas && d.Tarefas.Quadros.Count > 0)
        {
            <a class="nova-tarefa" href="tarefas?novo=hoje">@Icones.Mais<span>Adicionar tarefa para hoje</span><kbd>N</kbd></a>
        }
    </section>
            break;
        }

        case Modulo.Entretenimento:
        {
    // Continuar de onde parou: o que está em andamento; sem nada, os mais recentes
    var andamento = d.Entretenimento.Where(e => e.Status == "andamento").OrderByDescending(e => e.Data ?? DateOnly.MinValue).ToList();
    var estante = (andamento.Count > 0 ? andamento : d.Entretenimento.OrderByDescending(e => e.Data ?? DateOnly.MinValue).ToList()).Take(3).ToList();
    <a class="card bloco largo" href="entretenimento" style="--c:@m!.Cor" @key="bloco">
        <div class="b-cab"><span class="b-ic">@m.Icone</span>@(andamento.Count > 0 ? "Continuar de onde parou" : m.Nome)<span class="b-dir">@m.Nome</span></div>
        @if (estante.Count > 0)
        {
            <div class="ent-cartoes">
                @foreach (var e in estante)
                {
                    var total = e.TotalEpisodios();
                    var prox = e.ProximoEpisodio();
                    var sub = prox is { } pe ? $"T{pe.Temporada.Numero} · E{pe.Episodio.Numero}" : total > 0 ? $"{e.EpisodiosAssistidos()} de {total} episódios" : e.Ano?.ToString() ?? StatusNome(e.Status);
                    <div class="ent-cartao" style="--c:@Formatacao.CorEstavel(e.Titulo)">
                        <Capa Item="e" />
                        <span class="ent-tipo">@Maiuscula(CategoriaEntretenimento.Buscar(e.Categoria).Singular)</span>
                        <span class="ent-texto"><b>@e.Titulo</b><small>@sub</small></span>
                        @if (total > 0)
                        {
                            <span class="ent-barra"><i style="width:@((100.0 * e.EpisodiosAssistidos() / total).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></i></span>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p class="b-vazio">Sua estante ainda está vazia.</p>
        }
    </a>
            break;
        }
    }
}
</div>

@if (!Modulo.Visiveis(cfg).Any())
{
    <section class="card">
        <div class="chart-empty"><span>Todos os módulos estão escondidos. Escolha o que mostrar em <a href="configuracoes?aba=modulos">Configurações</a>.</span></div>
    </section>
}

@code {
    // Id do bloco que junta Agenda e Tarefas
    private const string BlocoHoje = "hoje";

    // Menu do botão "Registrar"
    private bool _registrar;

    // Faixa de atenção aberta com todas as pendências
    private bool _todasPendencias;

    // O Início pode ficar aberto por horas (o app fica na bandeja): redesenha a cada minuto para a saudação e a data acompanharem
    private System.Threading.Timer? _relogio;

    protected override void OnInitialized()
    {
        _relogio = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
        // O carro estacionado chega pelo Bluetooth (desligou o carro com o app aberto)
        Bluetooth.Mudou += Redesenhar;
    }

    private void Redesenhar() => _ = InvokeAsync(StateHasChanged);

    // "Novembro"
    private static string NomeMes(DateOnly d) => Maiuscula(Formatacao.NomeDoMes(d.Month));

    private static string Maiuscula(string s) => s.Length == 0 ? s : char.ToUpper(s[0]) + s[1..];

    private static string StatusNome(string chave) => StatusEntretenimento.Todos.FirstOrDefault(s => s.Chave == chave)?.Nome ?? "";

    private static string HaQuanto(DateTime quando)
    {
        var t = DateTime.Now - quando;
        var ha = t.TotalMinutes < 1 ? "agora há pouco" : t.TotalHours < 1 ? $"há {(int)t.TotalMinutes} min"
            : t.TotalDays < 1 ? $"há {(int)t.TotalHours} h" : $"há {(int)t.TotalDays} {((int)t.TotalDays == 1 ? "dia" : "dias")}";
        return $"{ha} · {(quando.Date == DateTime.Today ? quando.ToString("HH:mm") : quando.ToString("dd/MM HH:mm"))}";
    }

    public void Dispose()
    {
        _relogio?.Dispose();
        Bluetooth.Mudou -= Redesenhar;
    }
}
