@page "/entretenimento"
@inject ArmazenamentoService Store
@inject ToastService Toast
@inject IDialogoService Dialogo
@inject EntretenimentoBusca Busca
@inject CapasService Capas
@implements IDisposable

@{
    var hoje = Hoje;
    var todos = Lista;
    var concluidos = todos.Where(e => e.Status == "concluido").ToList();
    var noAno = concluidos.Count(e => e.Data?.Year == hoje.Year);
    var notas = todos.Where(e => e.Nota is not null).Select(e => e.Nota!.Value).ToList();
    var andamento = todos.Count(e => e.Status == "andamento");
    var quero = todos.Count(e => e.Status == "quero");

    var termo = _filtroTexto.Trim();
    var estante = todos
        .Where(e => _filtroCategoria == "todas" || e.Categoria == _filtroCategoria)
        .Where(e => _filtroStatus == "todos" || e.Status == _filtroStatus)
        .Where(e => termo.Length == 0 || e.Titulo.Contains(termo, StringComparison.CurrentCultureIgnoreCase)
                    || (e.Criadores?.Contains(termo, StringComparison.CurrentCultureIgnoreCase) ?? false));
    estante = _ordem switch
    {
        "nota" => estante.OrderByDescending(e => e.Nota ?? -1).ThenBy(e => e.Titulo),
        "titulo" => estante.OrderBy(e => e.Titulo),
        "ano" => estante.OrderByDescending(e => e.Ano ?? 0).ThenBy(e => e.Titulo),
        _ => estante.OrderByDescending(e => e.Data ?? DateOnly.MinValue).ThenBy(e => e.Titulo),
    };
    var lista = estante.ToList();
}

<div class="page-head">
    <div>
        <h1>Entretenimento</h1>
        <p>Sua estante de filmes, séries, animes, jogos e livros — o que você viu, quando e que nota deu.</p>
    </div>
    <div class="page-acoes">
        <button class="btn primary" type="button" @onclick="AbrirBusca">+ Adicionar</button>
        @* Configurações só do Entretenimento (as gerais do app ficam em Configurações, no menu) *@
        <button class="btn so-icone" type="button" title="Configurações do Entretenimento" aria-label="Configurações do Entretenimento" @onclick="AbrirConfig">@Icones.Engrenagem</button>
    </div>
</div>

<section class="kpis">
    <div class="kpi"><span class="kpi-label">Na estante</span>
        <span class="kpi-value">@todos.Count</span>
        <span class="kpi-sub">@concluidos.Count @Plural(concluidos.Count, "concluído", "concluídos")</span></div>
    <div class="kpi"><span class="kpi-label">Em @hoje.Year</span>
        <span class="kpi-value">@noAno</span>
        <span class="kpi-sub">@Plural(noAno, "concluído este ano", "concluídos este ano")</span></div>
    <div class="kpi"><span class="kpi-label">Nota média</span>
        <span class="kpi-value">@(notas.Count > 0 ? Num(notas.Average(), 1) + " ★" : Vazio)</span>
        <span class="kpi-sub">@notas.Count @Plural(notas.Count, "avaliado", "avaliados")</span></div>
    <div class="kpi"><span class="kpi-label">Em andamento</span>
        <span class="kpi-value">@andamento</span>
        <span class="kpi-sub">@quero na lista de desejos</span></div>
</section>

<section class="card">
    <div class="estante-filtros">
        <div class="chips">
            <button type="button" class="chip @(_filtroCategoria == "todas" ? "active" : "")" @onclick='() => _filtroCategoria = "todas"'>Tudo</button>
            @foreach (var c in CategoriaEntretenimento.Todas)
            {
                var n = todos.Count(e => e.Categoria == c.Chave);
                <button type="button" class="chip @(_filtroCategoria == c.Chave ? "active" : "")" @onclick="() => _filtroCategoria = c.Chave">@c.Nome@(n > 0 ? $" · {n}" : "")</button>
            }
        </div>
        <div class="estante-busca">
            <input class="select" type="search" placeholder="Buscar título ou autor..." @bind="_filtroTexto" @bind:event="oninput">
            <select class="select" @bind="_filtroStatus">
                <option value="todos">Todos os status</option>
                @foreach (var s in StatusEntretenimento.Todos)
                {
                    <option value="@s.Chave">@s.Nome</option>
                }
            </select>
            <select class="select" @bind="_ordem">
                <option value="recentes">Mais recentes</option>
                <option value="nota">Maior nota</option>
                <option value="ano">Lançamento</option>
                <option value="titulo">Título (A–Z)</option>
            </select>
        </div>
    </div>

    @if (lista.Count == 0)
    {
        <div class="chart-empty">@(todos.Count == 0 ? "Sua estante está vazia. Clique em \"+ Adicionar\" para colocar o primeiro item." : "Nada encontrado com esses filtros.")</div>
    }
    else
    {
        <div class="estante">
            @foreach (var e in lista)
            {
                <button type="button" class="capa-item" @key="e.Id" @onclick="() => AbrirDetalhe(e)">
                    <Capa Item="e" />
                    @if (e.Status == "andamento" && e.TotalEpisodios() is > 0 and var totalEp)
                    {
                        var vistosEp = e.EpisodiosAssistidos();
                        <span class="capa-progresso" title="@vistosEp de @totalEp episódios"><span style="width:@(Pct(vistosEp, totalEp))%"></span></span>
                    }
                    <span class="capa-titulo">@e.Titulo</span>
                    <span class="capa-sub">
                        @if (e.Status == "concluido" && e.Nota is not null)
                        {
                            <Estrelas Valor="e.Nota" />
                        }
                        else if (e.Status == "andamento" && e.ProximoEpisodio() is (var pt, var pe))
                        {
                            <span class="badge good" title="Próximo episódio">@CodigoEp(pt, pe)</span>
                        }
                        else if (e.Status != "concluido")
                        {
                            <span class="badge @(e.Status == "andamento" ? "good" : "")">@StatusEntretenimento.Buscar(e.Status).Nome</span>
                        }
                        else
                        {
                            @(e.Ano?.ToString() ?? CategoriaEntretenimento.Buscar(e.Categoria).Singular)
                        }
                    </span>
                </button>
            }
        </div>
    }
</section>

@* ---- Adicionar: busca nas APIs ---- *@
@if (_modo == Modo.Buscar)
{
    var geral = _buscaCategoria == Geral;
    var placeholder = geral ? "Buscar filme, série, anime, jogo ou livro..." : $"Título do {CategoriaEntretenimento.Buscar(_buscaCategoria).Singular}...";
    <div class="modal-backdrop" @onclick="Fechar">
        <div class="card modal modal-largo" @onclick:stopPropagation="true">
            <div class="card-head"><div><h2>Adicionar à estante</h2><p>Digite o título — os resultados aparecem enquanto você escreve.</p></div></div>
            <form class="busca-linha" autocomplete="off" @onsubmit="BuscarAgora">
                <input class="select" type="search" placeholder="@placeholder" autofocus aria-label="Título"
                       @bind="_termo" @bind:event="oninput" @bind:after="AoDigitar">
                <select class="select" aria-label="Tipo de conteúdo" @bind="_buscaCategoria" @bind:after="BuscarAgora">
                    <option value="@Geral">Geral</option>
                    @foreach (var c in CategoriaEntretenimento.Todas)
                    {
                        <option value="@c.Chave">@c.Nome</option>
                    }
                </select>
            </form>
            @if (_erroBusca is not null)
            {
                <div class="preview">@_erroBusca</div>
            }
            @if (_resultados.Count > 0)
            {
                <div class="resultados">
                    @foreach (var r in _resultados)
                    {
                        <button type="button" class="resultado" disabled="@_escolhendo" @onclick="() => Escolher(r)">
                            @if (r.UrlCapa is not null)
                            {
                                <img src="@r.UrlCapa" alt="" loading="lazy">
                            }
                            else
                            {
                                <span class="capa-vazia mini">@Inicial(r.Titulo)</span>
                            }
                            <span>
                                <b>@r.Titulo</b>
                                <small>@(string.Join(" · ", new[] { geral && r.Categoria is not null ? Maiuscula(CategoriaEntretenimento.Buscar(r.Categoria).Singular) : null, r.Ano?.ToString(), r.Criadores }.Where(x => x is not null)))</small>
                            </span>
                        </button>
                    }
                    @if (_temMais)
                    {
                        <button type="button" class="btn ver-mais" disabled="@_buscando" @onclick="VerMais">@(_buscando ? "Carregando..." : "Ver mais resultados")</button>
                    }
                </div>
            }
            else if (_buscando)
            {
                <p class="muted">Buscando...</p>
            }
            else if (_buscou && _erroBusca is null)
            {
                <p class="muted">Nada encontrado. Tente outro título, outro tipo ou cadastre manualmente.</p>
            }
            <div class="form-actions">
                <button class="btn" type="button" @onclick="Fechar">Cancelar</button>
                <button class="btn" type="button" @onclick="() => AbrirFormulario(null, null)">Cadastrar manualmente</button>
            </div>
        </div>
    </div>
}

@* ---- Formulário (novo ou edição) ---- *@
@if (_modo == Modo.Form)
{
    var cat = CategoriaEntretenimento.Buscar(_fCategoria);
    <div class="modal-backdrop" @onclick="Fechar">
        <form class="card modal modal-largo" autocomplete="off" @onclick:stopPropagation="true" @onsubmit="Salvar">
            <h2>@(_editId is not null ? "Editar" : "Novo") @cat.Singular</h2>
            <div class="detalhe">
                <div class="detalhe-capa">
                    <Capa Arquivo="@_fCapa" UrlExterna="@_fUrlCapa" Titulo="@_fTitulo" />
                    <button class="btn sm" type="button" @onclick="EscolherImagem">Escolher imagem…</button>
                    @if (_fCapa is not null || _fUrlCapa is not null)
                    {
                        <button class="btn sm" type="button" @onclick="RemoverImagem">Remover imagem</button>
                    }
                </div>
                <div class="form-grid">
                    <label class="field full"><span>Título *</span><input maxlength="120" required @bind="_fTitulo"></label>
                    <label class="field"><span>Categoria</span>
                        <select @bind="_fCategoria">
                            @foreach (var c in CategoriaEntretenimento.Todas)
                            {
                                <option value="@c.Chave">@c.Nome</option>
                            }
                        </select></label>
                    <label class="field"><span>Ano de lançamento</span><input inputmode="numeric" maxlength="4" @bind="_fAno"></label>
                    <label class="field"><span>Status</span>
                        <select @bind="_fStatus">
                            @foreach (var s in StatusEntretenimento.Todos)
                            {
                                <option value="@s.Chave">@s.Nome</option>
                            }
                        </select></label>
                    @if (_fStatus != "quero")
                    {
                        <label class="field"><span>@(_fStatus == "concluido" ? cat.Verbo + " em" : "Começou em")</span><input type="date" @bind="_fData"></label>
                    }
                    @if (_fStatus == "concluido")
                    {
                        <div class="field full"><span>Sua nota</span><Estrelas Editavel="true" @bind-Valor="_fNota" /></div>
                    }
                    <label class="field"><span>Criadores</span><input maxlength="120" placeholder="diretor, autor, estúdio..." @bind="_fCriadores"></label>
                    <label class="field"><span>Gêneros</span><input maxlength="120" @bind="_fGeneros"></label>
                    <label class="field full"><span>Sinopse</span><textarea rows="4" maxlength="2000" @bind="_fSinopse"></textarea></label>
                    <label class="field full"><span>Observação</span><input maxlength="200" placeholder="onde assistiu, com quem, plataforma..." @bind="_fObs"></label>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn" type="button" @onclick="Fechar">Cancelar</button>
                <button class="btn primary" type="submit" disabled="@_salvando">@(_salvando ? "Salvando..." : _editId is not null ? "Salvar alterações" : "Adicionar à estante")</button>
            </div>
        </form>
    </div>
}

@* ---- Detalhes ---- *@
@if (_modo == Modo.Detalhe && Lista.FirstOrDefault(e => e.Id == _detalheId) is { } d)
{
    var cat = CategoriaEntretenimento.Buscar(d.Categoria);
    <div class="modal-backdrop" @onclick="Fechar">
        <div class="card modal modal-largo" @onclick:stopPropagation="true">
            <div class="detalhe">
                <div class="detalhe-capa"><Capa Item="d" /></div>
                <div class="detalhe-info">
                    <span class="muted">@cat.Singular@(d.Ano is int ano ? $" · {ano}" : "")</span>
                    <h2>@d.Titulo</h2>
                    @if (d.Criadores is not null)
                    {
                        <p class="muted">@d.Criadores</p>
                    }
                    <div class="detalhe-nota">
                        @if (d.Status == "concluido")
                        {
                            <Estrelas Editavel="true" Valor="d.Nota" ValorChanged="n => MudarNota(d, n)" />
                            <span class="muted">@(d.Data is DateOnly dt ? $"{cat.Verbo} em {DataBR(dt)}" : cat.Verbo)</span>
                        }
                        else
                        {
                            <span class="badge @(d.Status == "andamento" ? "good" : "")">@StatusEntretenimento.Buscar(d.Status).Nome</span>
                            @if (d.Data is DateOnly dt)
                            {
                                <span class="muted">desde @DataBR(dt)</span>
                            }
                        }
                    </div>
                    @if (d.Generos is not null)
                    {
                        <p><small class="muted">@d.Generos</small></p>
                    }
                    @if (d.Sinopse is not null)
                    {
                        <p class="sinopse">@d.Sinopse</p>
                    }
                    @if (d.Obs is not null)
                    {
                        <p class="preview">@d.Obs</p>
                    }
                </div>
            </div>
            @if (cat.TemEpisodios && d.Fonte != "tmdb-movie")
            {
                var total = d.TotalEpisodios();
                var vistos = d.EpisodiosVistos.ToHashSet();
                var assistidos = d.EpisodiosAssistidos();
                var proximo = d.ProximoEpisodio();
                var carregando = _carregandoEpisodios == d.Id;
                <section class="episodios">
                    <div class="episodios-topo">
                        <div>
                            <h3>Temporadas e episódios</h3>
                            @if (total > 0)
                            {
                                <span class="muted">@assistidos de @total @Plural(total, "episódio", "episódios") · @d.Temporadas.Count @Plural(d.Temporadas.Count, "temporada", "temporadas")</span>
                            }
                        </div>
                        <button class="btn sm" type="button" disabled="@carregando" @onclick="() => CarregarEpisodios(d, avisar: true)"
                                title="@(total > 0 ? "Buscar episódios novos e atualizar os nomes" : null)">
                            @(carregando ? "Carregando..." : total > 0 ? "Atualizar" : "Carregar episódios")</button>
                    </div>
                    @if (total == 0)
                    {
                        <p class="muted">@(carregando ? "Buscando as temporadas..." : $"Carregue a lista para marcar o que já assistiu. Se for um filme, não há episódios.")</p>
                    }
                    else
                    {
                        <div class="progress"><div style="width:@(Pct(assistidos, total))%"></div></div>
                        @if (proximo is (var pt, var pe))
                        {
                            <div class="episodio-proximo">
                                <span><small class="muted">Próximo</small> <b>@CodigoEp(pt, pe)</b>@(NomeEp(pe) is string np ? $" · {np}" : "")</span>
                                <button class="btn sm primary" type="button" @onclick="() => MarcarEpisodio(d, pt, pe, true)">Marcar como visto</button>
                            </div>
                        }
                        @foreach (var t in d.Temporadas)
                        {
                            var vistosT = t.Episodios.Count(e => vistos.Contains(EpisodioEntretenimento.ChaveDe(t.Numero, e.Numero)));
                            var completa = vistosT == t.Episodios.Count;
                            var aberta = _temporadasAbertas.Contains(t.Numero);
                            <div class="temporada @(completa ? "completa" : "")" @key="t.Numero">
                                <div class="temporada-topo">
                                    <button type="button" class="temporada-abrir" aria-expanded="@(aberta ? "true" : "false")" @onclick="() => AlternarTemporada(t.Numero)">
                                        <span class="seta">@(aberta ? "▾" : "▸")</span>
                                        <b>Temporada @t.Numero</b>
                                        @if (MostrarNomes && t.Nome is not null)
                                        {
                                            <small class="muted">@t.Nome</small>
                                        }
                                        <span class="temporada-conta">@vistosT/@t.Episodios.Count</span>
                                    </button>
                                    <button type="button" class="btn sm" @onclick="() => MarcarTemporada(d, t, !completa)">@(completa ? "Desmarcar" : "Marcar todos")</button>
                                </div>
                                @if (aberta)
                                {
                                    <ul class="lista-episodios">
                                        @foreach (var e in t.Episodios)
                                        {
                                            var visto = vistos.Contains(EpisodioEntretenimento.ChaveDe(t.Numero, e.Numero));
                                            <li class="@(visto ? "visto" : "")" @key="e.Numero">
                                                <label>
                                                    <input type="checkbox" checked="@visto" @onchange="ev => MarcarEpisodio(d, t, e, ev.Value is true)">
                                                    <span class="ep-num">E@(e.Numero)</span>
                                                    <span class="ep-nome">@(NomeEp(e) ?? $"Episódio {e.Numero}")</span>
                                                    @if (e.Data is DateOnly de)
                                                    {
                                                        <small class="muted">@DataBR(de)</small>
                                                    }
                                                </label>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    }
                </section>
            }
            <div class="form-actions">
                <button class="btn" type="button" @onclick="() => Excluir(d)">Excluir</button>
                <button class="btn" type="button" @onclick="() => AbrirFormulario(d, null)">Editar</button>
                <button class="btn primary" type="button" @onclick="Fechar">Fechar</button>
            </div>
        </div>
    </div>
}

@* ---- Configurações do Entretenimento (engrenagem no topo) ---- *@
@if (_configAberta)
{
    <div class="modal-backdrop" @onclick="() => _configAberta = false">
        <form class="card modal" autocomplete="off" @onclick:stopPropagation="true" @onsubmit="SalvarConfig">
            <div><h2>@Icones.Engrenagem Configurações do Entretenimento</h2><p class="muted">Valem só para esta seção. As do app ficam em Configurações, no menu.</p></div>
            <label class="check full"><input type="checkbox" @bind="_fNomesEpisodios"> Mostrar os nomes dos episódios</label>
            <p class="muted">
                @if (_fNomesEpisodios)
                {
                    @("Cada episódio aparece com o título (\"E3 · O Retorno\"). Nos animes os nomes vêm do MyAnimeList, em inglês, e a lista demora um pouco mais para carregar.")
                }
                else
                {
                    @("Os episódios aparecem só com o número (\"E3 · Episódio 3\"), e a lista dos animes carrega mais rápido.")
                }
            </p>
            <div class="form-actions">
                <button class="btn" type="button" @onclick="() => _configAberta = false">Cancelar</button>
                <button class="btn primary" type="submit">Salvar</button>
            </div>
        </form>
    </div>
}

@code {
    private enum Modo { Nenhum, Buscar, Form, Detalhe }

    // Engrenagem: configurações do Entretenimento
    private bool _configAberta, _fNomesEpisodios;

    private bool MostrarNomes => Store.Dados.Config.NomesEpisodios;

    private void AbrirConfig()
    {
        _fNomesEpisodios = MostrarNomes;
        _configAberta = true;
    }

    private void SalvarConfig()
    {
        var ligou = _fNomesEpisodios && !MostrarNomes;
        Store.Dados.Config.NomesEpisodios = _fNomesEpisodios;
        Store.Salvar();
        _configAberta = false;
        // Os nomes que já vieram ficam guardados (só são escondidos); os dos animes só vêm num novo carregamento
        var semNome = ligou ? Lista.Count(e => e.Temporadas.Count > 0 && e.Temporadas.All(t => t.Episodios.All(x => x.Nome is null))) : 0;
        Toast.Ok(!_fNomesEpisodios ? "Episódios só com o número."
            : semNome > 0 ? $"Nomes dos episódios ligados. Em {semNome} {Plural(semNome, "item", "itens")} sem nomes ainda, use \"Atualizar\" nos episódios."
            : "Nomes dos episódios ligados.");
    }

    // Episódios: item carregando agora e temporadas abertas no detalhe
    private string? _carregandoEpisodios;
    private readonly HashSet<int> _temporadasAbertas = [];

    private static string CodigoEp(TemporadaEntretenimento t, EpisodioEntretenimento e) => $"T{t.Numero}E{e.Numero}";

    private string? NomeEp(EpisodioEntretenimento e) => MostrarNomes ? e.Nome : null;

    private static int Pct(int parte, int total) => total > 0 ? (int)Math.Round(100.0 * parte / total) : 0;

    private void AlternarTemporada(int numero)
    {
        if (!_temporadasAbertas.Remove(numero)) _temporadasAbertas.Add(numero);
    }

    /// <summary>Abre a temporada do próximo episódio (ou a primeira).</summary>
    private void AbrirTemporadaAtual(ItemEntretenimento e)
    {
        _temporadasAbertas.Clear();
        if ((e.ProximoEpisodio()?.Temporada ?? e.Temporadas.FirstOrDefault()) is { } t) _temporadasAbertas.Add(t.Numero);
    }

    /// <summary>Busca (ou atualiza) as temporadas na fonte. Sem <paramref name="avisar"/>, só reclama se der erro.</summary>
    private async Task CarregarEpisodios(ItemEntretenimento e, bool avisar)
    {
        if (_carregandoEpisodios is not null) return;
        _carregandoEpisodios = e.Id;
        StateHasChanged();
        try
        {
            var antes = e.TotalEpisodios();
            var temporadas = await Busca.Episodios(e);
            if (temporadas is null)
            {
                if (avisar) Toast.Erro("Não foram encontrados episódios para este título.");
                return;
            }
            // O item pode ter sido excluído enquanto carregava
            if (!Lista.Contains(e)) return;
            e.Temporadas = temporadas;
            Store.Salvar();
            if (_detalheId == e.Id && (antes == 0 || _temporadasAbertas.Count == 0)) AbrirTemporadaAtual(e);
            var novos = e.TotalEpisodios() - antes;
            if (avisar) Toast.Ok(antes == 0 ? $"{e.TotalEpisodios()} episódios carregados."
                : novos > 0 ? $"{novos} {Plural(novos, "episódio novo", "episódios novos")}." : "Episódios atualizados.");
        }
        catch (BuscaException ex) { Toast.Erro(ex.Message); }
        finally
        {
            _carregandoEpisodios = null;
            StateHasChanged();
        }
    }

    private void MarcarEpisodio(ItemEntretenimento d, TemporadaEntretenimento t, EpisodioEntretenimento e, bool visto) =>
        Marcar(d, [EpisodioEntretenimento.ChaveDe(t.Numero, e.Numero)], visto);

    private void MarcarTemporada(ItemEntretenimento d, TemporadaEntretenimento t, bool visto) =>
        Marcar(d, t.Episodios.Select(e => EpisodioEntretenimento.ChaveDe(t.Numero, e.Numero)), visto);

    /// <summary>
    /// Marca/desmarca e acerta o status: o primeiro visto põe "Em andamento", o último põe "Concluído"
    /// e desmarcar algum de uma série concluída volta para "Em andamento".
    /// </summary>
    private void Marcar(ItemEntretenimento d, IEnumerable<string> chaves, bool visto)
    {
        var total = d.TotalEpisodios();
        var estavaCompleto = total > 0 && d.EpisodiosAssistidos() == total;
        var vistos = d.EpisodiosVistos.ToHashSet();
        foreach (var c in chaves)
            if (visto) vistos.Add(c); else vistos.Remove(c);
        d.EpisodiosVistos = vistos.OrderBy(c => c, Comparer<string>.Create(CompararChaves)).ToList();

        var assistidos = d.EpisodiosAssistidos();
        if (assistidos == total && total > 0 && d.Status != "concluido")
        {
            d.Status = "concluido";
            d.Data = Hoje;
            Toast.Ok($"Todos os episódios vistos: \"{d.Titulo}\" está em Concluídos.{(d.Nota is null ? " Que tal dar uma nota?" : "")}");
        }
        else if (assistidos > 0 && d.Status == "quero")
        {
            d.Status = "andamento";
            d.Data = Hoje;
        }
        // A nota fica guardada: volta a aparecer quando terminar de novo
        else if (assistidos < total && estavaCompleto && d.Status == "concluido")
            d.Status = "andamento";
        // A temporada do próximo fica aberta
        if (visto && d.ProximoEpisodio() is (var t, _)) _temporadasAbertas.Add(t.Numero);
        Store.Salvar();
    }

    // "2x10" depois de "2x9": ordena pelos números, não pelo texto
    private static int CompararChaves(string a, string b)
    {
        static (int, int) Partes(string c) => c.Split('x') is [var t, var e] && int.TryParse(t, out var nt) && int.TryParse(e, out var ne) ? (nt, ne) : (int.MaxValue, 0);
        return Partes(a).CompareTo(Partes(b));
    }

    // Filtros mantidos enquanto o app estiver aberto
    private static string _filtroCategoria = "todas", _filtroStatus = "todos", _ordem = "recentes";
    private string _filtroTexto = "";

    private Modo _modo;
    private string? _detalheId, _editId;

    // Busca: "geral" procura em todas as categorias de uma vez
    private const string Geral = "geral";
    private const int AtrasoDigitacaoMs = 450;  // espera parar de digitar antes de buscar (poupa as APIs)
    private const int MinimoLetras = 2;
    private string _termo = "", _buscaCategoria = Geral;
    private List<ResultadoBusca> _resultados = [];
    private string? _erroBusca;
    private bool _buscando, _buscou, _escolhendo, _salvando;
    private int _pagina;
    private bool _temMais;
    private List<string> _geralComMais = [];   // categorias da busca geral que ainda têm páginas
    private CancellationTokenSource? _ctsBusca;

    private string _fCategoria = "filme", _fTitulo = "", _fAno = "", _fStatus = "quero", _fCriadores = "", _fGeneros = "", _fSinopse = "", _fObs = "";
    private DateOnly? _fData;
    private double? _fNota;
    private string? _fCapa, _fUrlCapa, _fFonte, _fFonteId;
    // Capas importadas neste formulário que ainda não foram salvas (apagadas se cancelar)
    private readonly List<string> _capasNovas = [];

    private List<ItemEntretenimento> Lista => Store.Dados.Entretenimento;

    private static string Inicial(string titulo) => titulo.Length > 0 ? titulo[..1].ToUpperInvariant() : "?";

    private static string Maiuscula(string s) => s.Length > 0 ? char.ToUpperInvariant(s[0]) + s[1..] : s;

    private void AbrirBusca()
    {
        _buscaCategoria = _filtroCategoria == "todas" ? Geral : _filtroCategoria;
        _termo = "";
        LimparResultados();
        _modo = Modo.Buscar;
    }

    private void LimparResultados()
    {
        _ctsBusca?.Cancel();
        _resultados = [];
        _erroBusca = null;
        _buscou = _buscando = _temMais = false;
        _pagina = 0;
        _geralComMais = [];
    }

    private void AbrirDetalhe(ItemEntretenimento e)
    {
        AbrirTemporadaAtual(e);
        _detalheId = e.Id;
        _modo = Modo.Detalhe;
    }

    private void Fechar()
    {
        _ctsBusca?.Cancel();
        foreach (var c in _capasNovas) CapasService.Excluir(c);
        _capasNovas.Clear();
        _modo = Modo.Nenhum;
    }

    public void Dispose() => _ctsBusca?.Cancel();

    /// <summary>A cada letra: espera a pessoa parar de digitar e então busca.</summary>
    private Task AoDigitar() => Pesquisar(atraso: true);

    /// <summary>Enter ou troca do tipo: busca na hora.</summary>
    private Task BuscarAgora() => Pesquisar(atraso: false);

    private async Task Pesquisar(bool atraso)
    {
        // Cancela a espera/busca anterior: só a última digitação vale
        _ctsBusca?.Cancel();
        var termo = _termo.Trim();
        if (termo.Length < MinimoLetras)
        {
            LimparResultados();
            return;
        }
        var cts = _ctsBusca = new CancellationTokenSource();
        try
        {
            if (atraso) await Task.Delay(AtrasoDigitacaoMs, cts.Token);
            _buscando = true;
            _erroBusca = null;
            StateHasChanged();
            await CarregarPagina(termo, 1, cts.Token);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested) { }
    }

    private async Task VerMais()
    {
        if (_buscando || !_temMais) return;
        _ctsBusca?.Cancel();
        var cts = _ctsBusca = new CancellationTokenSource();
        _buscando = true;
        try { await CarregarPagina(_termo.Trim(), _pagina + 1, cts.Token); }
        catch (OperationCanceledException) when (cts.IsCancellationRequested) { }
    }

    private async Task CarregarPagina(string termo, int pagina, CancellationToken ct)
    {
        List<ResultadoBusca> novos;
        try
        {
            if (_buscaCategoria == Geral)
            {
                var g = await Busca.BuscarGeral(termo, pagina, pagina == 1 ? null : _geralComMais, ct);
                novos = g.Itens;
                _geralComMais = g.ComMais;
                _temMais = g.ComMais.Count > 0;
            }
            else
            {
                var p = await Busca.Buscar(CategoriaEntretenimento.Buscar(_buscaCategoria), termo, pagina, ct);
                novos = p.Itens;
                _temMais = p.TemMais;
            }
        }
        catch (BuscaException e)
        {
            ct.ThrowIfCancellationRequested();
            if (pagina == 1) _resultados = [];
            _erroBusca = e.Message;
            _temMais = false;
            _buscando = false;
            _buscou = true;
            return;
        }
        ct.ThrowIfCancellationRequested();
        if (pagina == 1) _resultados = novos;
        else
        {
            // As páginas podem se sobrepor quando a fonte reordena: não repete o que já está na lista
            var vistos = _resultados.Select(r => (r.Fonte, r.FonteId)).ToHashSet();
            _resultados.AddRange(novos.Where(r => vistos.Add((r.Fonte, r.FonteId))));
        }
        _pagina = pagina;
        _buscando = false;
        _buscou = true;
    }

    private async Task Escolher(ResultadoBusca r)
    {
        var existente = Lista.FirstOrDefault(e => e.Fonte == r.Fonte && e.FonteId == r.FonteId && r.FonteId.Length > 0);
        if (existente is not null && !await Dialogo.Confirmar($"\"{existente.Titulo}\" já está na sua estante.\nAdicionar de novo (ex.: assistiu outra vez)?")) return;
        _ctsBusca?.Cancel();
        _escolhendo = true;
        StateHasChanged();
        r = await Busca.Detalhar(r);
        _escolhendo = false;
        AbrirFormulario(null, r);
    }

    private void AbrirFormulario(ItemEntretenimento? e, ResultadoBusca? r)
    {
        _capasNovas.Clear();
        _editId = e?.Id;
        // Item da estante > categoria do resultado > tipo escolhido na busca (Geral cai em filme)
        _fCategoria = e?.Categoria ?? r?.Categoria ?? (_buscaCategoria == Geral ? "filme" : _buscaCategoria);
        _fTitulo = e?.Titulo ?? r?.Titulo ?? _termo.Trim();
        _fAno = (e?.Ano ?? r?.Ano)?.ToString() ?? "";
        _fStatus = e?.Status ?? "quero";  // item novo entra como "Quero ver"
        _fData = e is not null ? e.Data : Hoje;
        _fNota = e?.Nota;
        _fCriadores = e?.Criadores ?? r?.Criadores ?? "";
        _fGeneros = e?.Generos ?? r?.Generos ?? "";
        _fSinopse = e?.Sinopse ?? r?.Sinopse ?? "";
        _fObs = e?.Obs ?? "";
        _fCapa = e?.Capa;
        _fUrlCapa = r?.UrlCapa;
        _fFonte = e?.Fonte ?? r?.Fonte;
        _fFonteId = e?.FonteId ?? r?.FonteId;
        _modo = Modo.Form;
    }

