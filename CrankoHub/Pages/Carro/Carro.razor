@namespace CrankoHub.Pages
@page "/carro"
@using CrankoHub.Pages.CarroAbas
@inject ArmazenamentoService Store
@inject ModoCarroService ModoCarro

@if (CarroCalculos.VeiculoAtivo(Store.Dados.Carro) is null)
{
    // Sem veículo: o cadastro é obrigatório antes de usar o resto do Carro
    <AbaVeiculo Veiculo="_semVeiculo" Inicio="novo" Obrigatorio="true" Criado="VeiculoCriado" />
    return;
}

@{
    var hoje = Hoje;
    var c = Store.Dados.Carro;
    var v = CarroCalculos.VeiculoAtivo(c)!;
    var list = CarroCalculos.DoVeiculo(c, v.Id);
    var manut = ManutencaoCalculos.DoVeiculo(c, v.Id);
    var st = CarroCalculos.Estatisticas(list);
    var odoAtual = ManutencaoCalculos.OdometroAtual(list, manut);
    var kmDia = ManutencaoCalculos.KmPorDia(list, hoje);
    var lembretes = ManutencaoCalculos.Lembretes(manut, odoAtual, kmDia, hoje);
    var alertas = lembretes.Count(s => s.Vencida || s.EmBreve);
    var documentos = DocumentosCalculos.DoVeiculo(c, v.Id);
    var docsAtencao = documentos.Where(x => DocumentosCalculos.PrecisaAtencao(x, hoje)).ToList();
    // Cabeçalho do protótipo: "Honda Civic EXL 2.0 · 2019" em cima, o nome grande e a placa ao lado
    var sobre = string.Join(" · ", new[] { string.Join(" ", new[] { v.Marca, v.Nome, v.Ficha?.Versao }.Where(s => !string.IsNullOrWhiteSpace(s))), v.Ano?.ToString() }.Where(s => !string.IsNullOrWhiteSpace(s)));
}

<CabecalhoPagina Sobre="@sobre" Titulo="@v.Nome" Selo="@v.Ficha?.Placa" />

<AcoesTopo>
    @* Com mais de um veículo, a troca fica aqui; cadastrar, editar e excluir ficam na aba Veículos *@
    @if (c.Veiculos.Count > 1)
    {
        <select class="select veh-topo" aria-label="Veículo em uso" title="Veículo em uso" value="@v.Id" @onchange="TrocarVeiculo">
            @foreach (var x in c.Veiculos)
            {
                <option value="@x.Id">@x.Nome</option>
            }
        </select>
    }
    @if (ModoCarro.Disponivel)
    {
        <a class="btn" href="carro/modo" title="Modo Carro" aria-label="Modo Carro">@Icones.Carro<span class="rotulo">Modo Carro</span></a>
    }
    <button class="btn primary" type="button" title="Novo abastecimento" aria-label="Novo abastecimento" @onclick="NovoAbastecimento">@Icones.Bomba<span class="rotulo">Novo abastecimento</span></button>
</AcoesTopo>

<nav class="tabs" role="tablist" aria-label="Seções do carro">
    @foreach (var (chave, rotulo) in Abas)
    {
        <button type="button" role="tab" class="tab @(_aba == chave ? "active" : "")" aria-selected="@(_aba == chave)" @onclick="() => Abrir(chave)">
            @rotulo
            @if (chave == "consumo" && list.Count > 0) { <span class="tab-count" title="Abastecimentos registrados">@list.Count</span> }
            @if (chave == "manutencao" && alertas > 0) { <span class="tab-count alerta" title="Manutenções vencidas ou próximas">@alertas</span> }
            @if (chave == "documentos" && docsAtencao.Count > 0) { <span class="tab-count alerta" title="Documentos vencidos ou vencendo em 30 dias">@docsAtencao.Count</span> }
        </button>
    }
</nav>

@switch (_aba)
{
    case "veiculo":
        <AbaVeiculo @key="v.Id" Veiculo="v" Criado="VeiculoCriado" Alterado="StateHasChanged"
                    Trocar="AtivarVeiculo" Excluido="VeiculoExcluido" />
        break;
    case "consumo":
        <AbaConsumo @key="@($"{v.Id}:{_pedidoAbastecimento}")" Veiculo="v" NovoAoAbrir="_novoAbastecimento" Alterado="StateHasChanged" />
        break;
    case "calculadoras":
        <AbaCalculadoras @key="v.Id" Veiculo="v" />
        break;
    case "documentos":
        <AbaDocumentos @key="v.Id" Veiculo="v" Alterado="StateHasChanged" />
        break;
    case "manutencao":
        <AbaManutencao @key="v.Id" Veiculo="v" Alterado="StateHasChanged" />
        break;
    default:
        // ---- Visão geral (protótipo "Fusão"): bloco grande com os números e o consumo mês a mês,
        //      coluna com tanque, manutenção e documentos, e a tabela dos últimos abastecimentos ----
        var cor = Modulo.CorDe(Store.Dados.Config, Modulo.Carro);
        var variacao = CarroCalculos.VariacaoTrimestre(list, hoje);
        var inicioMes = new DateOnly(hoje.Year, hoje.Month, 1);
        var doMes = list.Where(a => a.Data >= inicioMes).ToList();
        var gastoMes = doMes.Sum(a => a.Valor ?? 0) + manut.Where(m => m.Data >= inicioMes).Sum(m => m.Valor ?? 0);
        var odoInicioMes = ManutencaoCalculos.OdometroAtual(list.Where(a => a.Data < inicioMes), manut.Where(m => m.Data < inicioMes));
        var kmNoMes = odoAtual is double oa && odoInicioMes is double oi && oa >= oi ? oa - oi : doMes.Sum(a => a.Km);
        var consumoMensal = CarroCalculos.ConsumoMensal(list);
        var tanqueLitros = v.Ficha?.TanqueLitros;
        var tanque = CarroCalculos.TanqueAgora(list, tanqueLitros, kmDia, st.Media, hoje);
        var comLembrete = lembretes.Where(s => s.TemLembrete).OrderByDescending(s => s.Progresso).Take(3).ToList();
        var ultimos = list.AsEnumerable().Reverse().Take(5).ToList();
        var nomeMes = Formatacao.NomeDoMes(hoje.Month);

        <div class="carro-visao">
            <section class="card cv-hero brilho" style="--c:@cor">
                <div class="cv-numeros">
                    <div>
                        <span class="rot">Consumo médio</span>
                        <div class="cv-v">@Num(st.Media, 1)<small>km/l</small></div>
                        @if (variacao is double x)
                        {
                            <span class="cv-delta @(x >= 0 ? "bom" : "ruim")">@(x >= 0 ? "↑" : "↓") @Num(Math.Abs(x) * 100, 0)% vs. trimestre anterior</span>
                        }
                        else
                        {
                            <span class="rot">@(st.N > 0 ? $"melhor {Num(st.Melhor, 1)} · pior {Num(st.Pior, 1)}" : "nenhum trecho ainda")</span>
                        }
                    </div>
                    <div>
                        <span class="rot">Custo por km</span>
                        <div class="cv-v">@(st.CustoKm > 0 ? Num(st.CustoKm, 2) : "—")<small>R$</small></div>
                        <span class="rot">@(st.CustoKm > 0 ? Money(st.CustoKm * 100) + " a cada 100 km" : "informe os valores pagos")</span>
                    </div>
                    <div>
                        <span class="rot">Gasto em @nomeMes</span>
                        <div class="cv-v">@Num(gastoMes, 2)<small>R$</small></div>
                        <span class="rot">@doMes.Count @Plural(doMes.Count, "abastecimento", "abastecimentos")</span>
                    </div>
                    <div>
                        <span class="rot">Odômetro</span>
                        <div class="cv-v">@Num(odoAtual, 0)<small>km</small></div>
                        <span class="rot">@(odoAtual is null ? "informe nos abastecimentos" : $"+{Num(kmNoMes, 0)} km no mês")</span>
                    </div>
                </div>
                <div class="cv-graf">
                    <GraficoLinha Compacto="true" EixoMeses="true" Altura="190" FormatoY="new FormatoNumero(1)" Formato="@(new FormatoNumero(1, " km/l"))"
                                  MsgVazia="O consumo de cada mês aparece aqui a partir do segundo abastecimento."
                                  Series="@([new SerieLinha("Consumo", cor, consumoMensal, Markers: false, Area: true)])" />
                </div>
            </section>

            <div class="cv-lado">
                <section class="card cv-tanque brilho" style="--c:@cor">
                    @{
                        var fracao = tanque?.Fracao ?? 0;
                        const double raio = 38, circ = 2 * Math.PI * raio;
                    }
                    <div class="cv-anel">
                        <svg viewBox="0 0 92 92" aria-hidden="true">
                            <circle cx="46" cy="46" r="@raio" class="cv-anel-fundo" />
                            @if (tanque is not null)
                            {
                                <circle cx="46" cy="46" r="@raio" class="cv-anel-valor" style="stroke:@cor"
                                        stroke-dasharray="@($"{(circ * fracao).ToString(System.Globalization.CultureInfo.InvariantCulture)} {circ.ToString(System.Globalization.CultureInfo.InvariantCulture)}")" />
                            }
                        </svg>
                        <b>@(tanque is null ? "—" : Num(fracao * 100, 0) + "%")</b>
                    </div>
                    <div>
                        <span class="rot">Tanque</span>
                        @if (tanque is { } t)
                        {
                            <div class="cv-tanque-km">≈ @Num(st.Media is double md ? t.Litros * md : null, 0) km</div>
                            <span class="rot">@Num(t.Litros, 0) de @Num(tanqueLitros, 0) litros · estimado</span>
                        }
                        else
                        {
                            <div class="cv-tanque-km">—</div>
                            <span class="rot">@(tanqueLitros is null ? "Informe a capacidade na ficha (aba Veículos)" : "Complete o tanque ou marque o ponteiro no abastecimento")</span>
                        }
                    </div>
                </section>

                <section class="card">
                    <div class="b-cab"><span class="b-ic" style="--c:#FF9500">@Icones.Ferramenta</span>Manutenção<button type="button" class="b-dir b-link" @onclick="@(() => Abrir("manutencao"))">@comLembrete.Count @Plural(comLembrete.Count, "lembrete", "lembretes")</button></div>
                    @if (comLembrete.Count > 0)
                    {
                        @foreach (var s in comLembrete)
                        {
                            var alerta = s.Vencida || s.EmBreve;
                            <div class="cv-lemb">
                                <div class="cv-lemb-linha"><span>@s.Tipo.Nome</span>
                                    <b class="@(s.Vencida ? "ruim" : alerta ? "atencao" : "")">@(s.KmRestantes is double km && km >= 0 ? $"em {Num(km, 0)} km" : s.Restante)</b></div>
                                <div class="cv-barra @(s.Vencida ? "ruim" : alerta ? "atencao" : "")"><i style="width:@(Math.Clamp((s.Progresso ?? 0) * 100, 2, 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="b-vazio">Registre um serviço com intervalo de km ou meses para receber lembretes.</p>
                    }
                </section>

                <section class="card cv-docs">
                    <div class="b-cab"><span class="b-ic" style="--c:#34C759">@Icones.Dados</span>Documentos<button type="button" class="b-dir b-link" @onclick="@(() => Abrir("documentos"))">@hoje.Year</button></div>
                    @if (documentos.Count > 0)
                    {
                        @foreach (var d in documentos.Take(5))
                        {
                            var (texto, classe) = DocumentosCalculos.Situacao(d, hoje);
                            var atencao = DocumentosCalculos.PrecisaAtencao(d, hoje);
                            <div class="cv-doc">
                                <span>@(string.IsNullOrWhiteSpace(d.Descricao) ? TipoDocumento.NomeDe(d.Tipo) : d.Descricao)</span>
                                <b class="@(atencao ? (classe is "critical" ? "ruim" : "atencao") : "")">@(d.Pago || atencao ? char.ToUpper(texto[0]) + texto[1..] : "Até " + DataBR(d.Vencimento))</b>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="b-vazio">IPVA, licenciamento, seguro e CNH aparecem aqui.</p>
                    }
                </section>
            </div>

            <section class="card cv-tabela">
                <div class="b-cab"><span class="b-ic" style="--c:@cor">@Icones.Bomba</span>Últimos abastecimentos<button type="button" class="b-dir b-link" @onclick="@(() => Abrir("consumo"))">Ver histórico</button></div>
                @if (ultimos.Count > 0)
                {
                    <table class="tabela-limpa">
                        <thead><tr><th>Data</th><th>Posto</th><th>Combustível</th><th class="num">Litros</th><th class="num">km/l</th><th class="num">Valor</th></tr></thead>
                        <tbody>
                            @foreach (var a in ultimos)
                            {
                                <tr>
                                    <td>@DataCurta(a.Data)</td>
                                    <td>@(a.Posto ?? "—")</td>
                                    <td><span class="tag-comb" style="--c:@Combustivel.CorDe(a.Combustivel)">@Combustivel.NomeDe(a.Combustivel)</span></td>
                                    <td class="num">@Num(a.Litros, 1) L</td>
                                    <td class="num">@(a.Inicial ? "—" : Num(a.Kml, 1))</td>
                                    <td class="num"><b>@Money(a.Valor)</b></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="b-vazio">Nenhum abastecimento ainda. Use "Novo abastecimento" no topo.</p>
                }
            </section>
        </div>
        break;
}

@code {
    private static readonly (string Chave, string Rotulo)[] Abas =
    [
        ("resumo", "Visão geral"),
        ("consumo", "Abastecimentos e consumo"),
        ("manutencao", "Manutenção"),
        ("documentos", "Documentos"),
        ("calculadoras", "Calculadoras"),
        ("veiculo", "Veículos"),
    ];

    // Aba aberta, mantida enquanto o app estiver aberto
    private static string _aba = "resumo";

    /// <summary>Permite abrir uma aba direto pelo link (ex.: carro?aba=manutencao).</summary>
    [SupplyParameterFromQuery(Name = "aba")] public string? AbaInicial { get; set; }

    /// <summary>Permite abrir um veículo direto pelo link (ex.: carro?veiculo=abc123).</summary>
    [SupplyParameterFromQuery(Name = "veiculo")] public string? VeiculoDoLink { get; set; }

    /// <summary>carro?novo=abastecimento abre direto a janela de novo abastecimento (botão Registrar do Início).</summary>
    [SupplyParameterFromQuery(Name = "novo")] public string? NovoDoLink { get; set; }

    private string? _novoDoLink;

    private string? _abaDoLink, _veiculoDoLink;
    private bool _novoAbastecimento; // abrir Consumo já com a janela de novo abastecimento
    private int _pedidoAbastecimento; // muda a cada atalho, para reabrir a janela mesmo já estando na aba
    private readonly Veiculo _semVeiculo = new(); // só para o formulário do primeiro cadastro

    private DadosCarro Dados => Store.Dados.Carro;

    protected override void OnParametersSet()
    {
        if (NovoDoLink != _novoDoLink)
        {
            _novoDoLink = NovoDoLink;
            if (NovoDoLink == "abastecimento" && CarroCalculos.VeiculoAtivo(Dados) is not null) NovoAbastecimento();
        }
        // Só quando o link muda, para não desfazer a aba escolhida a cada nova renderização
        if (VeiculoDoLink != _veiculoDoLink)
        {
            _veiculoDoLink = VeiculoDoLink;
            if (Dados.Veiculos.Any(v => v.Id == VeiculoDoLink)) AtivarVeiculo(VeiculoDoLink!);
        }
        if (AbaInicial == _abaDoLink) return;
        _abaDoLink = AbaInicial;
        // Abastecimentos agora ficam dentro de Consumo (links antigos ainda funcionam)
        var aba = AbaInicial == "abastecimentos" ? "consumo" : AbaInicial;
        if (Abas.Any(a => a.Chave == aba)) _aba = aba!;
    }

    private void Abrir(string aba)
    {
        _aba = aba;
        _novoAbastecimento = false;
    }

    // "Novo abastecimento" (topo, ou o link do Início): abre Consumo já com a janela de novo abastecimento
    private void NovoAbastecimento()
    {
        Abrir("consumo");
        _novoAbastecimento = true;
        _pedidoAbastecimento++;
    }

    // ---- Veículos ----

    private void AtivarVeiculo(string id)
    {
        Dados.Ativo = id;
        Store.Salvar();
    }

    private void TrocarVeiculo(ChangeEventArgs e) => AtivarVeiculo(e.Value?.ToString() ?? "");

    // A aba passa a mostrar a ficha do novo veículo (ou o Resumo, no primeiro cadastro)
    private void VeiculoCriado(Veiculo novo) => AtivarVeiculo(novo.Id);

    // Continua na aba Veículos com o próximo; sem nenhum, a página volta para o cadastro
    private void VeiculoExcluido() => AtivarVeiculo(Dados.Veiculos.FirstOrDefault()?.Id ?? "");
}
