@page "/assinaturas"
@inject ArmazenamentoService Store
@inject ToastService Toast
@inject IDialogoService Dialogo

@{
    var hoje = Hoje;
    var todas = Lista;
    var ativas = todas.Where(a => a.Ativa).ToList();
    var canceladas = todas.Count - ativas.Count;
    var porMes = ativas.Sum(AssinaturasCalculos.PorMes);
    var proximas30 = AssinaturasCalculos.CobrancasAte(ativas, hoje, 30);
    var proxima = ativas.Select(a => (Assinatura: a, Data: AssinaturasCalculos.ProximaCobranca(a, hoje)))
        .OrderBy(x => x.Data).ThenBy(x => x.Assinatura.Nome).FirstOrDefault();
    var maisCara = ativas.MaxBy(AssinaturasCalculos.PorMes);
    var ed = Editando();
    var categorias = AssinaturasCalculos.CategoriasSugeridas.Union(todas.Select(a => a.Categoria).OfType<string>()).Distinct().Order().ToList();

    // Próximas cobranças: período e ciclo escolhidos, uma linha por assinatura
    var ciclosAtivos = CicloCobranca.Todos.Where(c => ativas.Any(a => a.Ciclo == c.Chave)).ToList();
    if (_cicloProximas != "" && !ciclosAtivos.Any(c => c.Chave == _cicloProximas)) _cicloProximas = "";
    var diasPeriodo = hoje.AddMonths(_mesesProximas).DayNumber - hoje.DayNumber;
    var cobrancasPeriodo = AssinaturasCalculos.CobrancasAte(ativas.Where(a => _cicloProximas == "" || a.Ciclo == _cicloProximas), hoje, diasPeriodo);
    var proximasPorAssinatura = cobrancasPeriodo.GroupBy(c => c.Assinatura)
        .Select(g => (Assinatura: g.Key, Data: g.First().Data, Vezes: g.Count(), Total: g.Sum(c => c.Assinatura.Valor)))
        .OrderBy(x => x.Data).ThenBy(x => x.Assinatura.Nome).ToList();
    var rotuloPeriodo = PeriodosProximas.First(p => p.Meses == _mesesProximas).Texto;

    // Cobranças previstas mês a mês (do mês atual em diante)
    var inicioMes = new DateOnly(hoje.Year, hoje.Month, 1);
    var meses = Enumerable.Range(0, 12).Select(i => inicioMes.AddMonths(i)).ToList();
    var cobrancasAno = AssinaturasCalculos.CobrancasAte(ativas, hoje, meses[^1].AddMonths(1).DayNumber - 1 - hoje.DayNumber);
    var previsaoMensal = meses.Select(m =>
    {
        var doMes = cobrancasAno.Where(c => c.Data.Year == m.Year && c.Data.Month == m.Month).ToList();
        var rotulo = MesLabel(m.Year, m.Month);
        return new BarraDado(rotulo, doMes.Sum(c => c.Assinatura.Valor), $"{rotulo} · {doMes.Count} {Plural(doMes.Count, "cobrança", "cobranças")}");
    }).ToList();

    var tabela = (_filtro switch
    {
        "ativas" => todas.Where(a => a.Ativa),
        "canceladas" => todas.Where(a => !a.Ativa),
        _ => todas,
    })
    .OrderByDescending(a => a.Ativa)
    .ThenBy(a => AssinaturasCalculos.ProximaCobranca(a, hoje))
    .ThenBy(a => a.Nome)
    .ToList();
}

<AcoesTopo>
    <button class="btn primary" type="button" title="Nova assinatura" aria-label="Nova assinatura" @onclick="AbrirNova">@Icones.Mais<span class="rotulo">Nova assinatura</span></button>
</AcoesTopo>

<section class="kpis">
    <div class="kpi">
        <div class="kpi-topo">
            <span class="kpi-label">Custo @(_custoAnual ? "anual" : "mensal")</span>
            <div class="chips mini" role="group" aria-label="Ver custo por mês ou por ano">
                <button type="button" class="chip @(!_custoAnual ? "active" : "")" aria-pressed="@(!_custoAnual)" @onclick="() => _custoAnual = false">Mês</button>
                <button type="button" class="chip @(_custoAnual ? "active" : "")" aria-pressed="@_custoAnual" @onclick="() => _custoAnual = true">Ano</button>
            </div>
        </div>
        <span class="kpi-value">@Money(_custoAnual ? porMes * 12 : porMes)</span>
        <span class="kpi-sub">@(ativas.Count == 0 ? "Nenhuma assinatura ativa" : _custoAnual ? "somando 12 meses das ativas" : "anuais divididas por 12")</span></div>
    <div class="kpi"><span class="kpi-label">Ativas</span>
        <span class="kpi-value">@ativas.Count</span>
        <span class="kpi-sub">@(canceladas > 0 ? $"{canceladas} {Plural(canceladas, "cancelada", "canceladas")}" : "nenhuma cancelada")</span></div>
    <div class="kpi"><span class="kpi-label">Próxima cobrança</span>
        <span class="kpi-value">@(proxima.Assinatura?.Nome ?? Vazio)</span>
        <span class="kpi-sub">
            @if (proxima.Assinatura is not null)
            {
                var (texto, classe) = AssinaturasCalculos.Prazo(proxima.Data.DayNumber - hoje.DayNumber);
                <span>@Money(proxima.Assinatura.Valor) · </span><span class="badge @classe">@texto</span>
            }
            else
            {
                @("Nenhuma assinatura ativa")
            }
        </span></div>
    <div class="kpi"><span class="kpi-label">Próximos 30 dias</span>
        <span class="kpi-value">@Money(proximas30.Sum(c => c.Assinatura.Valor))</span>
        <span class="kpi-sub">@proximas30.Count @Plural(proximas30.Count, "cobrança", "cobranças")</span></div>
    <div class="kpi"><span class="kpi-label">Mais cara</span>
        <span class="kpi-value">@(maisCara?.Nome ?? Vazio)</span>
        <span class="kpi-sub">@(maisCara is not null ? Money(AssinaturasCalculos.PorMes(maisCara)) + "/mês" : "Nenhuma assinatura ativa")</span></div>
</section>

<section class="card">
    <div class="card-head">
        <div>
            <h2>Próximas cobranças</h2>
            <p>@(cobrancasPeriodo.Count > 0
                ? $"{Money(cobrancasPeriodo.Sum(c => c.Assinatura.Valor))} em {cobrancasPeriodo.Count} {Plural(cobrancasPeriodo.Count, "cobrança", "cobranças")} nos próximos {rotuloPeriodo}"
                : $"O que vence nos próximos {rotuloPeriodo}.")</p>
        </div>
        <div class="filtros-linha">
            @if (ciclosAtivos.Count > 1)
            {
                <div class="chips" role="group" aria-label="Filtrar por ciclo">
                    <button type="button" class="chip @(_cicloProximas == "" ? "active" : "")" @onclick="@(() => _cicloProximas = "")">Todas</button>
                    @foreach (var c in ciclosAtivos)
                    {
                        <button type="button" class="chip @(_cicloProximas == c.Chave ? "active" : "")" @onclick="() => _cicloProximas = c.Chave">@NomePlural(c)</button>
                    }
                </div>
            }
            <div class="chips" role="group" aria-label="Período">
                @foreach (var p in PeriodosProximas)
                {
                    <button type="button" class="chip @(_mesesProximas == p.Meses ? "active" : "")" @onclick="() => _mesesProximas = p.Meses">@p.Rotulo</button>
                }
            </div>
        </div>
    </div>
    @if (proximasPorAssinatura.Count > 0)
    {
        <ul class="activity">
            @foreach (var (a, data, vezes, total) in proximasPorAssinatura)
            {
                var (texto, classe) = AssinaturasCalculos.Prazo(data.DayNumber - hoje.DayNumber);
                <li @key="a.Id">
                    <span class="a-icon">@Icones.Assinaturas</span>
                    <div class="a-text">@a.Nome · <b>@Money(a.Valor)</b>
                        <small>@DataBR(data) · @CicloCobranca.Buscar(a.Ciclo).Nome.ToLowerInvariant()@(vezes > 1 ? $" · {vezes}× no período = {Money(total)}" : "")@(string.IsNullOrEmpty(a.Pagamento) ? "" : " · " + a.Pagamento)</small></div>
                    <span class="badge @classe">@texto</span>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="chart-empty">
            @if (ativas.Count == 0)
            {
                <span>Nenhuma assinatura ainda. Toque em "Nova assinatura" no topo ⬆</span>
            }
            else
            {
                <span>Nenhuma cobrança nos próximos @rotuloPeriodo.</span>
                @if (proxima.Assinatura is not null)
                {
                    <span> A próxima é <b>@proxima.Assinatura.Nome</b> em @DataBR(proxima.Data).</span>
                }
            }
        </div>
    }
</section>

<div class="grid-2">
    <section class="card">
        <div class="card-head"><div><h2>Custo mensal por categoria</h2><p>Quanto cada tipo de serviço pesa por mês (assinaturas anuais divididas por 12).</p></div></div>
        <GraficoBarras Dados="AssinaturasCalculos.PorCategoria(ativas)" Nome="Por mês" Altura="240" Cor="var(--series-3)"
                       FormatoY="@(new FormatoNumero(0, Prefixo: "R$ "))" Formato="FormatoNumero.Real"
                       MsgVazia="Sem assinaturas ativas." />
    </section>
    <section class="card">
        <div class="card-head"><div><h2>Cobranças previstas</h2><p>Quanto vai sair em cada um dos próximos 12 meses — é aqui que as anuais aparecem.</p></div></div>
        <GraficoBarras Dados="previsaoMensal" Nome="Cobranças" Altura="240"
                       FormatoY="@(new FormatoNumero(0, Prefixo: "R$ "))" Formato="FormatoNumero.Real"
                       MsgVazia="Sem cobranças previstas." />
    </section>
</div>

<section class="card">
    <div class="card-head">
        <div><h2>Todas as assinaturas</h2><p>@todas.Count @Plural(todas.Count, "assinatura", "assinaturas")</p></div>
        <div class="chips">
            @foreach (var (chave, rotulo) in Filtros)
            {
                <button type="button" class="chip @(_filtro == chave ? "active" : "")" @onclick="() => _filtro = chave">@rotulo</button>
            }
        </div>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Assinatura</th><th>Categoria</th><th>Ciclo</th><th class="num">Valor</th><th class="num">Por mês</th><th>Próxima cobrança</th><th>Pagamento</th><th>Observação</th><th></th></tr></thead>
            <tbody>
                @if (tabela.Count == 0)
                {
                    <tr><td colspan="9" class="empty-row">@(todas.Count == 0 ? "Nenhuma assinatura ainda. Toque em \"Nova assinatura\" no topo ⬆" : "Nenhuma assinatura neste filtro.")</td></tr>
                }
                @foreach (var a in tabela)
                {
                    var proximaData = AssinaturasCalculos.ProximaCobranca(a, hoje);
                    <tr @key="a.Id" class="@(a.Ativa ? "" : "inativa")">
                        <td><b>@a.Nome</b></td>
                        <td>@AssinaturasCalculos.CategoriaDe(a)</td>
                        <td>@CicloCobranca.Buscar(a.Ciclo).Nome</td>
                        <td class="num">@Money(a.Valor)</td>
                        <td class="num">@Money(AssinaturasCalculos.PorMes(a))</td>
                        <td>
                            @if (a.Ativa)
                            {
                                var (texto, classe) = AssinaturasCalculos.Prazo(proximaData.DayNumber - hoje.DayNumber);
                                <span>@DataBR(proximaData) </span><span class="badge @classe">@texto</span>
                            }
                            else
                            {
                                <span class="badge">cancelada</span>
                            }
                        </td>
                        <td>@a.Pagamento</td>
                        <td class="obs">@a.Obs</td>
                        <td><div class="row-actions">
                            <button type="button" title="Editar" @onclick="() => Editar(a)">@Icones.Editar</button>
                            <button type="button" class="del" title="Excluir" @onclick="() => Excluir(a)">@Icones.Excluir</button>
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@* ---- Nova / editar assinatura ---- *@
@if (_formAberto)
{
    <div class="modal-backdrop" @onclick="Fechar">
        <form class="card modal modal-medio" autocomplete="off" @onclick:stopPropagation="true" @onsubmit="Salvar">
            <div><h2>@(ed is not null ? "Editar assinatura" : "Nova assinatura")</h2><p class="muted">Informe a data de uma cobrança — as próximas são calculadas pelo ciclo.</p></div>
            <div class="form-grid">
                <label class="field"><span>Nome *</span><input maxlength="60" required placeholder="ex.: Netflix" autofocus @bind="_fNome"></label>
                <label class="field"><span>Valor (R$) *</span><input inputmode="decimal" required placeholder="ex.: 44,90" @bind="_fValor" @bind:event="oninput"></label>
                <label class="field"><span>Ciclo</span>
                    <select @bind="_fCiclo">
                        @foreach (var c in CicloCobranca.Todos)
                        {
                            <option value="@c.Chave">@c.Nome</option>
                        }
                    </select></label>
                <label class="field"><span>Próxima cobrança *</span><input type="date" required @bind="_fVencimento"></label>
                <label class="field"><span>Categoria</span>
                    <select @bind="_fCategoriaSel">
                        <option value="">@AssinaturasCalculos.SemCategoria</option>
                        @foreach (var c in categorias)
                        {
                            <option value="@c">@c</option>
                        }
                        <option value="@OutraCategoria">Outra...</option>
                    </select></label>
                <label class="field"><span>Forma de pagamento</span><input maxlength="40" placeholder="ex.: Cartão Nubank, Pix" @bind="_fPagamento"></label>
                @if (_fCategoriaSel == OutraCategoria)
                {
                    <label class="field full"><span>Nome da categoria</span><input maxlength="40" placeholder="ex.: Delivery" autofocus @bind="_fCategoriaNova"></label>
                }
                <label class="field full"><span>Observação</span><input maxlength="140" placeholder="plano família, login de quem, como cancelar..." @bind="_fObs"></label>
                <label class="check"><input type="checkbox" @bind="_fAtiva"> Assinatura ativa</label>
            </div>
            @if (Pf(_fValor) is > 0 and var valor)
            {
                var ciclo = CicloCobranca.Buscar(_fCiclo);
                <div class="preview">
                    <span>Equivale a <b>@Money(ciclo.PorMes(valor))/mês</b> · <b>@Money(ciclo.PorMes(valor) * 12)/ano</b></span>
                </div>
            }
            <div class="form-actions">
                <button class="btn" type="button" @onclick="Fechar">Cancelar</button>
                <button class="btn primary" type="submit">@(ed is not null ? "Salvar alterações" : "Adicionar assinatura")</button>
            </div>
        </form>
    </div>
}

@code {
    private static readonly (string Chave, string Rotulo)[] Filtros = [("ativas", "Ativas"), ("canceladas", "Canceladas"), ("todas", "Todas")];
    private static readonly (int Meses, string Rotulo, string Texto)[] PeriodosProximas =
        [(1, "30 dias", "30 dias"), (3, "3 meses", "3 meses"), (12, "12 meses", "12 meses")];
    private const string OutraCategoria = "__outra";

    // Preferências de visualização mantidas enquanto o app estiver aberto
    private static string _filtro = "todas";
    private static bool _custoAnual;            // card de custo: false = por mês, true = por ano
    private static int _mesesProximas = 1;      // período do card "Próximas cobranças"
    private static string _cicloProximas = "";  // filtro por ciclo ("" = todas)

    private string? _editId;
    private bool _formAberto;

    private string _fNome = "", _fValor = "", _fCiclo = "mensal", _fCategoriaSel = "", _fCategoriaNova = "", _fPagamento = "", _fObs = "";
    private DateOnly? _fVencimento = Hoje;
    private bool _fAtiva = true;

    private List<Assinatura> Lista => Store.Dados.Assinaturas;

    private Assinatura? Editando() => _editId is null ? null : Lista.FirstOrDefault(a => a.Id == _editId);

    // Todos os ciclos terminam em "-al": Mensal → Mensais, Anual → Anuais
    private static string NomePlural(CicloCobranca c) => c.Nome.EndsWith("al") ? c.Nome[..^2] + "ais" : c.Nome;

    private void AbrirNova()
    {
        LimparFormulario();
        _formAberto = true;
    }

    private void Fechar()
    {
        _formAberto = false;
        LimparFormulario();
    }

    private void LimparFormulario()
    {
        _editId = null;
        _fNome = _fValor = _fCategoriaSel = _fCategoriaNova = _fPagamento = _fObs = "";
        _fCiclo = "mensal";
        _fVencimento = Hoje;
        _fAtiva = true;
    }

    private void Editar(Assinatura a)
    {
        _editId = a.Id;
        _fNome = a.Nome;
        _fValor = InVal(a.Valor, 2);
        _fCiclo = a.Ciclo;
        // Mostra a próxima cobrança, não a data antiga que foi cadastrada
        _fVencimento = AssinaturasCalculos.ProximaCobranca(a, Hoje);
        _fCategoriaSel = a.Categoria ?? "";  // as categorias já usadas sempre estão na lista
        _fCategoriaNova = "";
        _fPagamento = a.Pagamento ?? "";
        _fObs = a.Obs ?? "";
        _fAtiva = a.Ativa;
        _formAberto = true;
    }

    private async Task Excluir(Assinatura a)
    {
        if (!await Dialogo.Confirmar($"Excluir a assinatura \"{a.Nome}\"?\n\nSe você só cancelou o serviço, prefira editar e desmarcar \"Assinatura ativa\" para manter o histórico.")) return;
        Lista.Remove(a);
        Store.Salvar();
        Toast.Ok("Assinatura excluída.");
    }

    private void Salvar()
    {
        var nome = _fNome.Trim();
        var valor = Pf(_fValor);
        var categoria = (_fCategoriaSel == OutraCategoria ? _fCategoriaNova : _fCategoriaSel).Trim();
        if (nome.Length == 0) { Toast.Erro("Informe o nome da assinatura."); return; }
        if (valor is not (> 0 and <= 100_000)) { Toast.Erro("Informe um valor válido."); return; }
        if (_fVencimento is not DateOnly vencimento) { Toast.Erro("Informe a data da próxima cobrança."); return; }
        if (_fCategoriaSel == OutraCategoria && categoria.Length == 0) { Toast.Erro("Informe o nome da nova categoria."); return; }

        void Preencher(Assinatura a)
        {
            a.Nome = nome;
            a.Valor = valor.Value;
            a.Ciclo = _fCiclo;
            a.Vencimento = vencimento;
            a.Categoria = categoria.Length == 0 ? null : categoria;
            a.Pagamento = string.IsNullOrWhiteSpace(_fPagamento) ? null : _fPagamento.Trim();
            a.Obs = string.IsNullOrWhiteSpace(_fObs) ? null : _fObs.Trim();
            a.Ativa = _fAtiva;
        }

        var ed = Editando();
        if (ed is not null)
        {
            Preencher(ed);
            Toast.Ok("Assinatura atualizada.");
        }
        else
        {
            var nova = new Assinatura { Id = ArmazenamentoService.NovoId() };
            Preencher(nova);
            Lista.Add(nova);
            Toast.Ok($"Assinatura \"{nome}\" adicionada.");
        }
        Store.Salvar();
        Fechar();
    }
}
