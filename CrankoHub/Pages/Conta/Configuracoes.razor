@namespace CrankoHub.Pages
@page "/configuracoes"
@inject ArmazenamentoService Store
@inject ToastService Toast
@inject IDialogoService Dialogo
@inject AvisosService Avisos
@inject JanelaService Janela
@inject IJSRuntime JS
@inject BandejaService Bandeja
@inject AtualizacaoService Atualizacao
@inject CarroBluetoothService Bluetooth
@implements IDisposable

@{
    var d = Store.Dados;
    var cfg = d.Config;
}


<nav class="tabs" role="tablist" aria-label="Seções das configurações">
    @foreach (var (chave, rotulo) in Abas)
    {
        <button type="button" role="tab" class="tab @(_aba == chave ? "active" : "")" aria-selected="@(_aba == chave)" @onclick="() => _aba = chave">@rotulo</button>
    }
</nav>

@switch (_aba)
{
    case "modulos":
        <section class="card">
            <div class="card-head"><div><h2>Módulos</h2><p>Escolha o que aparece no menu, no Início e nos avisos. Esconder um módulo não apaga os dados dele.</p></div></div>
            <div class="opcoes">
                @foreach (var m in Modulo.Todos)
                {
                    <label class="check" @key="m.Id"><input type="checkbox" checked="@Modulo.Visivel(cfg, m.Id)" @onchange="@(e => Store.MostrarModulo(m.Id, e.Value is true))"> <span><b>@m.Nome</b> <span class="muted">· @m.Descricao</span></span></label>
                }
            </div>
        </section>
        break;

    case "integracoes":
        <section class="card">
            <div class="card-head"><div><h2>Entretenimento</h2><p>A busca de dados e capas já funciona sem nenhuma chave. As chaves abaixo são opcionais e trazem mais resultados.</p></div></div>
            <div class="form-grid">
                <label class="field"><span>Chave do TMDB (opcional: filmes, séries e animações)</span>
                    <input type="password" placeholder="Chave da API ou token de leitura" value="@cfg.ChaveTmdb" @onchange="e => SalvarChave(e, true)"></label>
                <label class="field"><span>Chave do RAWG (opcional: jogos)</span>
                    <input type="password" placeholder="Chave da API" value="@cfg.ChaveRawg" @onchange="e => SalvarChave(e, false)"></label>
            </div>
            <p class="muted" style="margin-top:10px">Sem chave, filmes, séries, animações e jogos vêm da <b>Wikipedia</b> e da <b>Wikidata</b> (pôsteres de séries pelo <b>TVmaze</b>); animes do <b>AniList</b> e livros da <b>Open Library</b>. Itens pouco conhecidos podem não estar lá: aí a chave ajuda (crie grátis em <b>themoviedb.org</b> → Configurações → API e em <b>rawg.io/apidocs</b>) ou cadastre manualmente.</p>
        </section>

        <section class="card">
            <div class="card-head"><div><h2>Google Maps</h2><p>Opcional, para o Modo Carro: com a chave, o mapa, a busca (bairros, números, estabelecimentos) e as rotas (com trânsito e preço do pedágio) vêm do Google.</p></div></div>
            <div class="form-grid">
                <label class="field"><span>Chave da API (Maps JavaScript, Places New e Routes)</span>
                    <input type="password" placeholder="AIza…" autocomplete="off" value="@cfg.ChaveGoogleMaps" @onchange="e => SalvarGoogle(e, chave: true)"></label>
                <label class="field"><span>ID do mapa (opcional: mapa vetorial escuro, girando)</span>
                    <input type="text" placeholder="Ex.: 1a2b3c4d5e6f7a8b" autocomplete="off" value="@cfg.MapaIdGoogle" @onchange="e => SalvarGoogle(e, chave: false)"></label>
            </div>
            <p class="muted" style="margin-top:10px">Sem chave, o Modo Carro usa o <b>OpenStreetMap</b> (mapa, busca pelo Photon e rotas pelo Valhalla). A chave fica só neste aparelho. O Google cobra acima da cota grátis do mês: configure no Google Cloud os <b>limites diários</b> de cada API e um <b>alerta de orçamento</b>. Radares e limite de velocidade continuam vindo do OpenStreetMap.</p>
        </section>
        break;

    case "carro":
        var lc = LayoutsCarro.Valido(cfg.LayoutCarro);
        var oQue = lc == LayoutsCarro.Musica ? "mapa" : "painel";
        var permissoes = Bluetooth.Permissoes();
        var faltam = permissoes.Where(p => p.Necessaria && p.Ativada == false).ToList();
        if (faltam.Count > 0)
        {
            <div class="mc-cfg-alerta" role="status">
                <b>Falta @(faltam.Count == 1 ? "ativar 1 permissão" : $"ativar {faltam.Count} permissões") para o que você escolheu.</b>
                <span>@string.Join(", ", faltam.Select(p => p.Nome)). Veja em <a href="configuracoes?aba=carro#permissoes-carro">Permissões do Modo Carro</a>, no fim da página.</span>
            </div>
        }

        <section class="card">
            <div class="card-head"><div><h2>Tela</h2><p>Como o Modo Carro (página Carro → Modo carro) divide a tela entre o mapa e o Spotify.</p></div></div>
            <div class="lc-config">
                <span class="lc-rotulo">Layout da tela <span class="muted">· também troca pelo botão de layout no Modo Carro</span></span>
                <div class="lc-opcoes" role="radiogroup" aria-label="Layout do Modo Carro">
                    @foreach (var l in LayoutsCarro.Todos)
                    {
                        <button type="button" role="radio" aria-checked="@(l == lc)" class="lc-opcao @(l == lc ? "ativa" : "")" @onclick="() => MudarLayoutCarro(l)">
                            <span class="lc-mini lc-@l @(cfg.PainelCarroEsquerda ? "esquerda" : "")" aria-hidden="true"><i class="m"></i><i class="p"></i></span>
                            <span>@LayoutsCarro.Nome(l)</span>
                        </button>
                    }
                </div>

                @if (LayoutsCarro.TemTamanho(lc))
                {
                    @foreach (var retrato in new[] { false, true })
                    {
                        var r = retrato;
                        var t = LayoutsCarro.Tamanho(cfg, lc, r);
                        <label class="lc-linha">
                            <span>Tamanho do @oQue <span class="muted">· @(r ? "celular em pé" : "celular deitado")</span></span>
                            <input type="range" min="@LayoutsCarro.Minimo(lc)" max="@LayoutsCarro.Maximo(lc)" step="1"
                                   value="@(t ?? LayoutsCarro.Minimo(lc))" @onchange="e => MudarTamanhoCarro(e, r)" />
                            <b>@(t is { } v ? $"{v}%" : "Automático")</b>
                        </label>
                    }
                    <div class="lc-linha">
                        <span class="muted">Também dá para arrastar a barra entre o mapa e o painel no Modo Carro (toque duplo nela volta ao padrão).</span>
                        <button type="button" class="btn" @onclick="PadraoTamanhoCarro">Tamanho padrão</button>
                    </div>
                }

                <div class="lc-linha">
                    <span>Lado do @(lc == LayoutsCarro.Mapa ? "mini player" : oQue == "mapa" ? "Spotify" : "painel")</span>
                    <div class="chips" role="radiogroup" aria-label="Lado do painel">
                        <button type="button" role="radio" aria-checked="@(!cfg.PainelCarroEsquerda)" class="chip @(!cfg.PainelCarroEsquerda ? "active" : "")" @onclick="() => MudarLadoCarro(false)">Direita · embaixo</button>
                        <button type="button" role="radio" aria-checked="@cfg.PainelCarroEsquerda" class="chip @(cfg.PainelCarroEsquerda ? "active" : "")" @onclick="() => MudarLadoCarro(true)">Esquerda · em cima</button>
                    </div>
                </div>
            </div>
            <div class="opcoes">
                <label class="check"><input type="checkbox" checked="@(!cfg.AtalhosOcultosCarro.Contains(lc))" @onchange="MudarAtalhosCarro"> <span>Atalhos do Spotify, Maps e Waze neste layout <span class="muted">· a hora e o Sair continuam aparecendo</span></span></label>
            </div>
        </section>

        <section class="card">
            <div class="card-head"><div><h2>Navegação</h2><p>A rota dentro do Modo Carro.</p></div></div>
            <div class="opcoes">
                <label class="check"><input type="checkbox" checked="@cfg.VozModoCarro" @onchange="@(e => Mudar(e, v => cfg.VozModoCarro = v))"> <span>Avisos por voz na rota <span class="muted">· manobras, radares, pedágios e limite de velocidade</span></span></label>
                <label class="check"><input type="checkbox" checked="@cfg.EvitarPedagios" @onchange="@(e => Mudar(e, v => cfg.EvitarPedagios = v))"> <span>Evitar pedágios nas rotas <span class="muted">· também dá para mudar na escolha da rota</span></span></label>
            </div>
        </section>

        <section class="card">
            <div class="card-head"><div><h2>Bluetooth do carro</h2><p>Marque a central do carro: o CrankoHub percebe quando o celular conecta (carro ligado) e desconecta (carro desligado).</p></div></div>
            @if (Pendente(permissoes, PermissoesCarro.Bluetooth) is { } pb)
            {
                <PermissaoLinha Permissao="pb" AoAtivar="AtivarPermissao" />
            }
            else
            {
                var pareados = Bluetooth.Pareados();
                var antigos = cfg.CarrosBluetooth.Where(c => pareados.All(p => !MesmoEndereco(p.Endereco, c.Endereco))).ToList();
                <span class="lc-rotulo">Qual é o carro? <span class="muted">· aparelhos pareados neste celular (os de som primeiro)</span></span>
                <div class="opcoes" role="group" aria-label="Aparelhos Bluetooth pareados">
                    @if (pareados.Count == 0 && antigos.Count == 0)
                    {
                        <p class="muted">Nenhum aparelho pareado. Pareie a central nas configurações de Bluetooth do Android e volte aqui.</p>
                    }
                    @foreach (var a in pareados)
                    {
                        var aparelho = a;
                        var marcado = cfg.CarrosBluetooth.Any(c => MesmoEndereco(c.Endereco, aparelho.Endereco));
                        <label class="check" @key="aparelho.Endereco"><input type="checkbox" checked="@marcado" @onchange="e => MarcarCarro(aparelho, e.Value is true)">
                            <span><b>@aparelho.Nome</b> <span class="muted">· @(aparelho.Audio ? "som / central" : "outro aparelho")</span></span></label>
                    }
                    @foreach (var c in antigos)
                    {
                        var carro = c;
                        <div class="lc-linha" @key="carro.Endereco">
                            <span><b>@carro.Nome</b> <span class="muted">· não está mais pareado</span></span>
                            <button type="button" class="btn" aria-label="Remover @carro.Nome" @onclick="() => RemoverCarro(carro)">Remover</button>
                        </div>
                    }
                </div>
            }

            <div class="lc-config mc-cfg-bloco">
                <span class="lc-rotulo">Ao ligar o carro (Bluetooth conectou)</span>
                <div class="chips" role="radiogroup" aria-label="Ao ligar o carro">
                    @foreach (var (valor, rotulo) in AcoesAoConectar)
                    {
                        <button type="button" role="radio" aria-checked="@(cfg.AoConectarCarro == valor)" class="chip @(cfg.AoConectarCarro == valor ? "active" : "")" @onclick="() => MudarAoConectar(valor)">@rotulo</button>
                    }
                </div>
                <span class="muted">@(cfg.AoConectarCarro switch
                {
                    AcoesConexao.Abrir => "Abre o Modo Carro sozinho. Com o celular bloqueado, espera você desbloquear.",
                    AcoesConexao.Notificar => "Aparece a notificação \"Modo Carro pronto\": toque para abrir.",
                    _ => "Não faz nada ao ligar o carro.",
                })</span>
                @if (cfg.AoConectarCarro != AcoesConexao.Nada && Pendente(permissoes, PermissoesCarro.Notificacoes) is { } pn)
                {
                    <PermissaoLinha Permissao="pn" AoAtivar="AtivarPermissao" />
                }
                @if (cfg.AoConectarCarro == AcoesConexao.Abrir && Pendente(permissoes, PermissoesCarro.Sobrepor) is { } ps)
                {
                    <PermissaoLinha Permissao="ps" AoAtivar="AtivarPermissao" />
                }
            </div>
            <div class="opcoes">
                <label class="check"><input type="checkbox" checked="@cfg.SairAoDesconectar" @onchange="@(e => Mudar(e, v => cfg.SairAoDesconectar = v))"> <span>Sair do Modo Carro ao desligar o carro <span class="muted">· a rota em andamento continua guardada</span></span></label>
            </div>
        </section>

        <section class="card">
            <div class="card-head"><div><h2>Onde estacionei</h2><p>Quando o Bluetooth do carro desconecta, o CrankoHub guarda onde o carro ficou: aparece numa notificação e no Início, com o caminho a pé no Google Maps.</p></div></div>
            <div class="opcoes">
                <label class="check"><input type="checkbox" checked="@cfg.LembrarEstacionado" @onchange="@(e => Mudar(e, v => cfg.LembrarEstacionado = v))"> <span>Lembrar onde estacionei <span class="muted">· usa o GPS do Modo Carro</span></span></label>
                @if (cfg.LembrarEstacionado)
                {
                    <label class="check"><input type="checkbox" checked="@cfg.EstacionadoComAppFechado" @onchange="@(e => Mudar(e, v => cfg.EstacionadoComAppFechado = v))"> <span>Funcionar também com o Modo Carro fechado <span class="muted">· precisa da localização "o tempo todo"</span></span></label>
                }
            </div>
            @if (cfg.LembrarEstacionado && cfg.EstacionadoComAppFechado && Pendente(permissoes, PermissoesCarro.LocalizacaoSempre) is { } pl)
            {
                <PermissaoLinha Permissao="pl" AoAtivar="AtivarPermissao" />
            }
            @if (cfg.Estacionado is { } est)
            {
                <div class="lc-linha mc-cfg-bloco">
                    <span><b>Carro estacionado</b> <span class="muted">· @(est.Endereco ?? "endereço não encontrado") · @est.Quando.ToString("dd/MM HH:mm")</span></span>
                    <button type="button" class="btn" @onclick="Bluetooth.ComoChegar">Como chegar</button>
                    <button type="button" class="btn" @onclick="Bluetooth.EsquecerEstacionado">Esquecer</button>
                </div>
            }
        </section>

        <section class="card">
            <div class="card-head"><div><h2>Visor da central</h2><p>A próxima curva no visor do som do carro, pelo Bluetooth.</p></div></div>
            <div class="opcoes">
                <label class="check"><input type="checkbox" checked="@cfg.VisorCentral" @onchange="@(e => Mudar(e, v => cfg.VisorCentral = v))"> <span>Mostrar a rota no visor da central <span class="muted">· a próxima curva no lugar do nome da música, durante a rota</span></span></label>
                <label class="check"><input type="checkbox" checked="@cfg.TesteVisor" @onchange="@(e => Mudar(e, v => cfg.TesteVisor = v))"> <span>Botão "Testar visor da central" <span class="muted">· diagnóstico com log, no Modo Carro</span></span></label>
            </div>
        </section>

        <section class="card" id="permissoes-carro">
            <div class="card-head"><div><h2>Permissões do Modo Carro</h2><p>Tudo o que o Android precisa liberar. Toque em <b>Ativar</b> para pedir a permissão ou abrir a tela certa do Android; o estado atualiza quando você volta.</p></div></div>
            <ul class="mc-permissoes">
                @foreach (var p in permissoes)
                {
                    <li @key="p.Id"><PermissaoLinha Permissao="p" AoAtivar="AtivarPermissao" Lista="true" /></li>
                }
            </ul>
        </section>
        break;

    case "aplicativo":
        <section class="card">
            <div class="card-head"><div><h2>Aplicativo</h2><p>@(Android ? "Notificações dos vencimentos (aparecem enquanto o app está aberto)." : "Ícone na bandeja do Windows (perto do relógio) e notificações dos vencimentos.")</p></div></div>
            <div class="opcoes">
                @if (!Android)
                {
                    <label class="check"><input type="checkbox" checked="@cfg.MinimizarParaBandeja" @onchange="@(e => Mudar(e, v => cfg.MinimizarParaBandeja = v))"> Ao fechar a janela, continuar rodando na bandeja</label>
                }
                <label class="check"><input type="checkbox" checked="@cfg.Avisos" @onchange="@(e => Mudar(e, v => cfg.Avisos = v))"> Mostrar notificações (manutenção, documentos, assinaturas, peso, backup)</label>
                @if (!Android)
                {
                    <label class="check"><input type="checkbox" checked="@(ConfigLocal.Atual.IniciarComWindows == true)" @onchange="MudarInicioWindows"> Iniciar com o Windows (abre direto na bandeja)</label>
                }
            </div>
            <div class="form-actions">
                <button class="btn" type="button" @onclick="() => Avisos.Verificar(manual: true)">Testar notificação</button>
            </div>
        </section>


        <section class="card">
            <div class="card-head">
                <div><h2>Atualizações</h2><p>Versão instalada: <b>@AtualizacaoService.Texto(AtualizacaoService.VersaoAtual)</b>. As versões novas vêm do Releases do GitHub (<b>CrankosEnterprise/cranko-hub</b>).</p></div>
                <label class="check"><input type="checkbox" checked="@cfg.VerificarAtualizacoes" @onchange="@(e => Mudar(e, v => cfg.VerificarAtualizacoes = v))"> Verificar sozinho</label>
            </div>
            @if (Atualizacao.Disponivel is { } nova)
            {
                <p style="margin-top:12px"><b>Versão @AtualizacaoService.Texto(nova.Versao) disponível</b> (@Num(nova.Tamanho / 1048576.0, 0) MB)</p>
                @if (!string.IsNullOrWhiteSpace(nova.Notas))
                {
                    <p class="muted" style="white-space:pre-wrap;margin-top:6px">@nova.Notas</p>
                }
                @if (_progresso is double p)
                {
                    <div class="progress"><div style="width:@Num(p * 100, 0)%"></div></div>
                    <div class="progress-legend"><span>Baixando…</span><b>@Num(p * 100, 0)%</b></div>
                }
            }
            else if (_emDia)
            {
                <p class="muted" style="margin-top:12px">Você está na versão mais recente.</p>
            }
            <div class="form-actions">
                <button class="btn" type="button" disabled="@(_verificando || _progresso is not null)" @onclick="VerificarAtualizacao">
                    @(_verificando ? "Verificando…" : "Verificar atualizações")</button>
                @if (Atualizacao.Disponivel is { } versaoNova)
                {
                    <button class="btn primary" type="button" disabled="@(_progresso is not null)" @onclick="() => Atualizar(versaoNova)">Atualizar agora</button>
                }
            </div>
        </section>
        break;

    default:
        <section class="card">
            <div class="card-head"><div><h2>Aparência</h2><p>Tema e cor de destaque do aplicativo.</p></div></div>
            @{
                var corAtual = CorDestaque.DaConfig(cfg.CorDestaque);
                var personalizada = !CorDestaque.Paleta.Contains(corAtual);
            }
            <div class="aparencia">
                <span>Tema</span>
                <div class="chips">
                    @foreach (var (valor, rotulo) in Temas)
                    {
                        <button type="button" class="chip @(d.Tema == valor ? "active" : "")" @onclick="() => MudarTema(valor)">@rotulo</button>
                    }
                </div>
                <span>Cor de destaque</span>
                <div class="paleta">
                    @foreach (var c in CorDestaque.Paleta)
                    {
                        <button type="button" class="cor @(c == corAtual ? "ativa" : "")" title="@c.Nome" aria-label="@c.Nome"
                                style="background:@c.Claro;--cor:@c.Claro" @onclick="() => MudarCor(c.Chave)"></button>
                    }
                    <label class="cor cor-personalizada @(personalizada ? "ativa" : "")" title="Personalizada"
                           style="@(personalizada ? $"background:{corAtual.Claro};--cor:{corAtual.Claro}" : "")">
                        <input type="color" value="@(personalizada ? corAtual.Claro.ToLowerInvariant() : "#5856d6")" @onchange="MudarCorPersonalizada">
                    </label>
                    <span class="muted">@corAtual.Nome</span>
                </div>
            </div>
        </section>
        break;
}

@code {
    // A aba Modo Carro só existe no celular
    private static readonly (string Chave, string Rotulo)[] Abas =
    [
        ("aparencia", "Aparência"),
        ("modulos", "Módulos"),
        ("integracoes", "Integrações"),
        .. OperatingSystem.IsAndroid() ? new[] { ("carro", "Modo Carro") } : [],
        ("aplicativo", "Aplicativo"),
    ];

    // No celular não há bandeja nem inicialização com o sistema
    private static bool Android => OperatingSystem.IsAndroid();

    // As permissões mudam fora do app (telas do Android) e o carro estacionado chega pelo Bluetooth
    protected override void OnInitialized() => Bluetooth.Mudou += Redesenhar;

    private void Redesenhar() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Bluetooth.Mudou -= Redesenhar;

    // ===== Bluetooth do carro (CarroBluetoothService) =====

    private static readonly (string Valor, string Rotulo)[] AcoesAoConectar =
        [(AcoesConexao.Nada, "Nada"), (AcoesConexao.Notificar, "Notificação"), (AcoesConexao.Abrir, "Abrir direto")];

    /// <summary>A permissão, se ainda falta ativar (null = já ativada ou não dá para conferir).</summary>
    private static PermissaoCarro? Pendente(IReadOnlyList<PermissaoCarro> lista, string id) =>
        lista.FirstOrDefault(p => p.Id == id && p.Ativada == false);

    private static bool MesmoEndereco(string a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    private Task AtivarPermissao(string id) => Bluetooth.Ativar(id);

    private void MarcarCarro(AparelhoBluetooth aparelho, bool marcado)
    {
        var carros = Store.Dados.Config.CarrosBluetooth;
        carros.RemoveAll(c => MesmoEndereco(c.Endereco, aparelho.Endereco));
        if (marcado) carros.Add(new CarroPareado(aparelho.Endereco, aparelho.Nome));
        Store.Salvar();
        if (marcado) Toast.Ok($"{aparelho.Nome} marcado como o seu carro.");
    }

    private void RemoverCarro(CarroPareado carro)
    {
        Store.Dados.Config.CarrosBluetooth.Remove(carro);
        Store.Salvar();
    }

    private void MudarAoConectar(string valor)
    {
        Store.Dados.Config.AoConectarCarro = valor;
        Store.Salvar();
    }

    // Aba aberta, mantida enquanto o app estiver aberto
    private static string _aba = "aparencia";

    /// <summary>Permite abrir uma aba direto pelo link (ex.: configuracoes?aba=aplicativo).</summary>
    [SupplyParameterFromQuery(Name = "aba")] public string? AbaInicial { get; set; }

    private string? _abaDoLink;

    protected override void OnParametersSet()
    {
        // Só quando o link muda, para não desfazer a aba escolhida a cada nova renderização
        if (AbaInicial == _abaDoLink) return;
        _abaDoLink = AbaInicial;
        if (Abas.Any(a => a.Chave == AbaInicial)) _aba = AbaInicial!;
    }

    private static readonly (string? Valor, string Rotulo)[] Temas = [("light", "Claro"), ("dark", "Escuro"), (null, "Automático")];

    private async Task MudarTema(string? tema)
    {
        Store.Dados.Tema = tema;
        Store.Salvar();
        await JS.InvokeVoidAsync("crankohub.aplicarTema", tema);
        Janela.TemaMudou(tema);
    }

    private void SalvarGoogle(ChangeEventArgs e, bool chave)
    {
        var valor = e.Value?.ToString()?.Trim() is { Length: > 0 } v ? v : null;
        if (chave) Store.Dados.Config.ChaveGoogleMaps = valor; else Store.Dados.Config.MapaIdGoogle = valor;
        Store.Salvar();
        Toast.Ok(chave ? (valor is null ? "Chave do Google removida: o Modo Carro volta ao OpenStreetMap." : "Chave do Google salva.") : "ID do mapa salvo.");
    }

    private void SalvarChave(ChangeEventArgs e, bool tmdb)
    {
        var chave = e.Value?.ToString()?.Trim() is { Length: > 0 } k ? k : null;
        if (tmdb) Store.Dados.Config.ChaveTmdb = chave; else Store.Dados.Config.ChaveRawg = chave;
        Store.Salvar();
        Toast.Ok(chave is null ? "Chave removida." : "Chave salva.");
    }

    private bool _verificando, _emDia;
    private double? _progresso;

    private async Task VerificarAtualizacao()
    {
        _verificando = true;
        _emDia = false;
        try
        {
            _emDia = await Atualizacao.VerificarAsync() is null;
        }
        catch (Exception ex)
        {
            Toast.Erro(ex is InvalidOperationException ? ex.Message : $"Não foi possível verificar: {ex.Message}");
        }
        _verificando = false;
    }

    private async Task Atualizar(AtualizacaoService.Novidade n)
    {
        if (!await Dialogo.Confirmar($"Atualizar para a versão {AtualizacaoService.Texto(n.Versao)}?\n{(Android ? "O CrankoHub vai baixar a versão nova e abrir o instalador do Android. Toque em Atualizar para concluir." : "O CrankoHub vai baixar a versão nova, fechar e abrir de novo.")} Seus dados não são alterados.")) return;
        _progresso = 0;
        // Redesenha só quando muda o percentual inteiro (o download avisa a cada 80 KB)
        var progresso = new Progress<double>(p =>
        {
            if ((int)(p * 100) == (int)((_progresso ?? 0) * 100)) return;
            _progresso = p;
            StateHasChanged();
        });
        try
        {
            await Atualizacao.InstalarAsync(n, progresso);
        }
        catch (Exception ex)
        {
            _progresso = null;
            Toast.Erro(ex is InvalidOperationException ? ex.Message : $"Não foi possível atualizar: {ex.Message}");
        }
    }

    private async Task MudarCor(string valor)
    {
        Store.Dados.Config.CorDestaque = valor;
        Store.Salvar();
        var cor = CorDestaque.DaConfig(valor);
        await JS.InvokeVoidAsync("crankohub.aplicarDestaque", cor.Claro, cor.Escuro, cor.Texto);
        Bandeja.AplicarCor(cor.Claro);
    }

    private Task MudarCorPersonalizada(ChangeEventArgs e) => MudarCor(e.Value?.ToString()?.ToUpperInvariant() ?? "azul");

    private void Mudar(ChangeEventArgs e, Action<bool> aplicar)
    {
        aplicar(e.Value is true);
        Store.Salvar();
    }

    // ===== Layout do Modo Carro (Models/Carro/ModoCarro.cs LayoutsCarro) =====

    private void MudarLayoutCarro(string layout)
    {
        Store.Dados.Config.LayoutCarro = layout;
        Store.Salvar();
    }

    private void MudarTamanhoCarro(ChangeEventArgs e, bool retrato)
    {
        var cfg = Store.Dados.Config;
        if (!int.TryParse(e.Value?.ToString(), out var pct)) return;
        var lc = LayoutsCarro.Valido(cfg.LayoutCarro);
        cfg.TamanhoPainelCarro[LayoutsCarro.Chave(lc, retrato)] = Math.Clamp(pct, LayoutsCarro.Minimo(lc), LayoutsCarro.Maximo(lc));
        Store.Salvar();
    }

    private void PadraoTamanhoCarro()
    {
        var cfg = Store.Dados.Config;
        cfg.TamanhoPainelCarro.Remove(LayoutsCarro.Chave(cfg.LayoutCarro, false));
        cfg.TamanhoPainelCarro.Remove(LayoutsCarro.Chave(cfg.LayoutCarro, true));
        Store.Salvar();
    }

    private void MudarLadoCarro(bool esquerda)
    {
        Store.Dados.Config.PainelCarroEsquerda = esquerda;
        Store.Salvar();
    }

    private void MudarAtalhosCarro(ChangeEventArgs e)
    {
        var cfg = Store.Dados.Config;
        var lc = LayoutsCarro.Valido(cfg.LayoutCarro);
        cfg.AtalhosOcultosCarro.Remove(lc);
        if (e.Value is not true) cfg.AtalhosOcultosCarro.Add(lc);
        Store.Salvar();
    }

    private void MudarInicioWindows(ChangeEventArgs e)
    {
        var ligado = e.Value is true;
        try
        {
            InicializacaoWindows.Aplicar(ligado);
            ConfigLocal.Atual.IniciarComWindows = ligado;
            ConfigLocal.Atual.Salvar();
        }
        catch (Exception ex)
        {
            Toast.Erro($"Não foi possível alterar a inicialização: {ex.Message}");
        }
    }
