@namespace CrankoHub.Pages
@page "/tarefas"
@inject ArmazenamentoService Store
@inject ToastService Toast
@inject IDialogoService Dialogo
@inject IJSRuntime JS
@implements IAsyncDisposable

@{
    var t = Dados;
    var hoje = Hoje;
    var emHoje = t.Ativo == Quadro.Hoje;
    var quadro = emHoje ? null : t.Quadros.FirstOrDefault(q => q.Id == t.Ativo);
    var resumo = TarefasCalculos.ResumoDoDia(t, hoje);
    var etiquetas = t.Cards.Where(c => emHoje || c.QuadroId == t.Ativo).SelectMany(c => c.Etiquetas).Distinct().Order().ToList();
}

<AcoesTopo>
    @if (quadro is not null)
    {
        <button class="btn primary" type="button" title="Nova tarefa" aria-label="Nova tarefa" @onclick="() => AbrirNovo(quadro, quadro.Colunas[0])">@Icones.Mais<span class="rotulo">Nova tarefa</span></button>
    }
    @* Configurações só das Tarefas (as gerais do app ficam em Configurações, no menu) *@
    <button class="icon-btn" type="button" title="Configurações das Tarefas" aria-label="Configurações das Tarefas" @onclick="AbrirConfig">@Icones.Engrenagem</button>
</AcoesTopo>

@{
    var cor = Modulo.CorDe(Store.Dados.Config, Modulo.Tarefas);
    var agoraT = DateTime.Now;
    var deHoje = resumo.ParaHoje.Count + resumo.Atrasados.Count;
    var emAberto = t.Cards.Count(TarefasCalculos.Aberto);
    var ontem = t.Cards.Count(c => c.Concluido == hoje.AddDays(-1));
    var semana = t.Cards.Count(c => c.Concluido is DateOnly f && hoje.DayNumber - f.DayNumber is >= 0 and < 7);
    var semanaAnterior = t.Cards.Count(c => c.Concluido is DateOnly f && hoje.DayNumber - f.DayNumber is >= 7 and < 14);

    // Concluídas por dia: últimos 14 dias, até hoje
    var porDia = Enumerable.Range(0, 14).Select(i => hoje.AddDays(i - 13)).Select(d =>
    {
        var n = t.Cards.Count(c => c.Concluido == d);
        var nome = d == hoje ? "Hoje" : d == hoje.AddDays(-1) ? "Ontem" : DataCurta(d);
        return new BarraDado(d.Day.ToString(), n, $"{nome} · {n} {Plural(n, "concluída", "concluídas")}");
    }).ToList();

    // Progresso do dia: o que foi feito hoje sobre tudo o que era de hoje
    var totalDia = resumo.ConcluidosHoje.Count + deHoje;
    double? fracaoDia = totalDia > 0 ? (double)resumo.ConcluidosHoje.Count / totalDia : null;
    const double raio = 38, circ = 2 * Math.PI * raio;

    // Próximos prazos: atrasadas primeiro, depois os próximos 7 dias
    var proximos = t.Cards.Where(c => TarefasCalculos.Aberto(c) && c.Prazo is DateOnly p && p.DayNumber - hoje.DayNumber <= 7)
        .OrderBy(c => c.Prazo).ThenBy(c => c.PrazoHora ?? TimeOnly.MaxValue).ThenBy(c => TarefasCalculos.PrioridadeIndice(c.Prioridade)).Take(5).ToList();
}

@* Cabeçalho no padrão do Carro e das Assinaturas: quanto falta fazer hoje é o título *@
<CabecalhoPagina Sobre="@($"{emAberto} {Plural(emAberto, "tarefa em aberto", "tarefas em aberto")} · {t.Quadros.Count} {Plural(t.Quadros.Count, "quadro", "quadros")}")"
                 Titulo="@(deHoje > 0 ? $"{deHoje} para hoje" : "Tudo em dia")" />

@*
    Visão das Tarefas (mesmo desenho da Visão geral do Carro): bloco grande com os números e as concluídas dia a dia,
    coluna com o progresso do dia e os próximos prazos; os quadros ficam embaixo, na largura toda.
*@
<div class="carro-visao tarefas-visao">
    <section class="card cv-hero brilho" style="--c:@cor">
        <div class="cv-numeros">
            <div>
                <span class="rot">Concluídas hoje</span>
                <div class="cv-v">@resumo.ConcluidosHoje.Count</div>
                @if (resumo.ConcluidosHoje.Count != ontem)
                {
                    <span class="cv-delta @(resumo.ConcluidosHoje.Count > ontem ? "bom" : "ruim")">@(resumo.ConcluidosHoje.Count > ontem ? "↑" : "↓") @Math.Abs(resumo.ConcluidosHoje.Count - ontem) vs. ontem</span>
                }
                else
                {
                    <span class="rot">igual a ontem</span>
                }
            </div>
            <div>
                <span class="rot">Para hoje</span>
                <div class="cv-v">@resumo.ParaHoje.Count</div>
                <span class="rot">prazo hoje ou em foco</span>
            </div>
            <div>
                <span class="rot">Atrasadas</span>
                <div class="cv-v @(resumo.Atrasados.Count > 0 ? "tv-ruim" : "")">@resumo.Atrasados.Count</div>
                @if (resumo.Atrasados.Count > 0)
                {
                    <span class="cv-delta ruim">prazo já passou</span>
                }
                else
                {
                    <span class="rot">nada atrasado ✓</span>
                }
            </div>
            <div>
                <span class="rot">Em aberto</span>
                <div class="cv-v">@emAberto</div>
                <span class="rot">em @t.Quadros.Count @Plural(t.Quadros.Count, "quadro", "quadros")</span>
            </div>
        </div>
        <div class="ev-graf">
            <div class="b-cab ev-graf-cab">Concluídas por dia
                <span class="b-dir">@semana nos últimos 7 dias@(semanaAnterior > 0 || semana > 0 ? $" · {(semana >= semanaAnterior ? "↑" : "↓")} {Math.Abs(semana - semanaAnterior)} vs. semana anterior" : "")</span>
            </div>
            <GraficoBarras RealcarUltimo="true" Dados="porDia" Nome="Concluídas" Altura="170" Cor="@cor"
                           FormatoY="new FormatoNumero(0)" Formato="new FormatoNumero(0)"
                           MsgVazia="As tarefas que você concluir aparecem aqui, dia a dia." />
        </div>
    </section>

    <div class="cv-lado">
        <section class="card cv-tanque brilho" style="--c:@cor">
            <div class="cv-anel">
                <svg viewBox="0 0 92 92" aria-hidden="true">
                    <circle cx="46" cy="46" r="@raio" class="cv-anel-fundo" />
                    @if (fracaoDia is double fd && fd > 0)
                    {
                        <circle cx="46" cy="46" r="@raio" class="cv-anel-valor" style="stroke:@cor"
                                stroke-dasharray="@($"{(circ * fd).ToString(System.Globalization.CultureInfo.InvariantCulture)} {circ.ToString(System.Globalization.CultureInfo.InvariantCulture)}")" />
                    }
                </svg>
                <b>@(fracaoDia is double f2 ? Num(f2 * 100, 0) + "%" : "—")</b>
            </div>
            <div>
                <span class="rot">Progresso de hoje</span>
                @if (totalDia > 0)
                {
                    <div class="cv-tanque-km">@resumo.ConcluidosHoje.Count de @totalDia</div>
                    <span class="rot">@(deHoje == 0 ? "tudo feito por hoje!" : $"{deHoje} {Plural(deHoje, "falta", "faltam")}{(resumo.Atrasados.Count > 0 ? $" · {resumo.Atrasados.Count} {Plural(resumo.Atrasados.Count, "atrasada", "atrasadas")}" : "")}")</span>
                }
                else
                {
                    <div class="cv-tanque-km">—</div>
                    <span class="rot">Nada marcado para hoje</span>
                }
                @if (!emHoje)
                {
                    <button type="button" class="b-link dv-meta-link" @onclick="() => Abrir(Quadro.Hoje)">Ver as de hoje</button>
                }
            </div>
        </section>

        <section class="card cv-docs">
            <div class="b-cab"><span class="b-ic" style="--c:#FF9500">@Icones.Relogio</span>Próximos prazos<span class="b-dir">próximos 7 dias</span></div>
            @if (proximos.Count > 0)
            {
                @foreach (var c in proximos)
                {
                    var (texto, classe) = TarefasCalculos.Prazo(c, agoraT);
                    <button type="button" class="cv-doc ev-cat tv-prazo" @key="c.Id" @onclick="() => AbrirEdicao(c)" title="Abrir a tarefa">
                        <span class="ev-titulo">@c.Titulo</span>
                        <b class="@(classe is "critical" ? "ruim" : classe is "serious" or "warning" ? "atencao" : "")">@texto</b>
                    </button>
                }
            }
            else
            {
                <p class="b-vazio">Nenhum prazo nos próximos 7 dias.</p>
            }
        </section>
    </div>
</div>

<section class="card tarefas-quadros" @ref="_raiz">
    <div class="quadros-barra">
        <div class="tabs">
            <button type="button" class="tab @(emHoje ? "active" : "")" @onclick="() => Abrir(Quadro.Hoje)">Hoje
                @if (resumo.ParaHoje.Count + resumo.Atrasados.Count > 0)
                {
                    <span class="tab-count @(resumo.Atrasados.Count > 0 ? "alerta" : "")">@(resumo.ParaHoje.Count + resumo.Atrasados.Count)</span>
                }
            </button>
            @foreach (var q in t.Quadros)
            {
                var abertos = t.Cards.Count(c => c.QuadroId == q.Id && TarefasCalculos.Aberto(c));
                var ativo = q.Id == t.Ativo;
                <button type="button" class="tab @(ativo ? "active" : "")" @key="q.Id" data-quadro="@q.Id"
                        title="@(ativo ? "Clique para renomear ou excluir · arraste para mudar a ordem" : "Arraste para mudar a ordem")"
                        aria-haspopup="@(ativo ? "menu" : null)"
                        @onclick="e => ClicouQuadro(q, e)" @oncontextmenu="e => AbrirMenuQuadro(q, e)" @oncontextmenu:preventDefault="true">
                    @TarefasCalculos.NomeQuadro(q)
                    @if (abertos > 0)
                    {
                        <span class="tab-count">@abertos</span>
                    }
                    @if (ativo)
                    {
                        <span class="tab-caret" aria-hidden="true">▾</span>
                    }
                </button>
            }
            <button type="button" class="tab" title="Novo quadro" @onclick="NovoQuadro">+ Quadro</button>
        </div>
        @* Filtros na mesma linha das abas; o que estiver filtrando fica na cor do módulo *@
        <div class="tv-filtros" style="--c:@cor">
            <input class="select @(_filtroTexto.Trim().Length > 0 ? "tv-ativo" : "")" type="search" placeholder="Buscar tarefa..." aria-label="Buscar tarefa" @bind="_filtroTexto" @bind:event="oninput">
            <select class="select @(_filtroPrioridade != "" ? "tv-ativo" : "")" aria-label="Prioridade" @bind="_filtroPrioridade">
                <option value="">Prioridade</option>
                @foreach (var p in PrioridadeTarefa.Todas)
                {
                    <option value="@p.Chave">@p.Nome</option>
                }
            </select>
            @if (etiquetas.Count > 0 || _filtroEtiqueta != "")
            {
                <select class="select @(_filtroEtiqueta != "" ? "tv-ativo" : "")" aria-label="Etiqueta" @bind="_filtroEtiqueta">
                    <option value="">Etiqueta</option>
                    @foreach (var e in etiquetas)
                    {
                        <option value="@e">#@e</option>
                    }
                </select>
            }
            @if (Filtrando)
            {
                <button type="button" class="icon-btn tv-limpar" title="Limpar filtros" aria-label="Limpar filtros" @onclick="LimparFiltros">@Icones.Fechar</button>
            }
        </div>
    </div>

    @* Menu do quadro: clique no quadro aberto ou botão direito em qualquer um *@
    @if (_menuQuadro is { } mq)
    {
        <div class="menu-fundo" @onclick="FecharMenu" @oncontextmenu="FecharMenu" @oncontextmenu:preventDefault="true"></div>
        <div class="menu-flutuante" role="menu" style="left:min(@Px(_menuX), calc(100vw - 200px)); top:@Px(_menuY)">
            <button type="button" role="menuitem" @onclick="() => DoMenu(() => RenomearQuadro(mq))">@Icones.Editar Renomear quadro</button>
            <button type="button" role="menuitem" @onclick="() => DoMenu(() => NovaColuna(mq))">@Icones.Mais Nova coluna</button>
            <button type="button" role="menuitem" class="danger" @onclick="() => DoMenu(() => ExcluirQuadro(mq))">@Icones.Excluir Excluir quadro</button>
        </div>
    }

    @if (emHoje)
    {
        var lista = TarefasCalculos.DeHoje(t, hoje).Where(Passa).ToList();
        // Separada em partes: o que pede atenção primeiro, as concluídas por último
        var partes = new (string Chave, string Titulo, List<CardTarefa> Itens)[]
        {
            ("atrasadas", "Atrasadas", lista.Where(c => c.Concluido is null && c.Prazo < hoje).ToList()),
            ("hoje", "Para hoje", lista.Where(c => c.Concluido is null && c.Prazo == hoje).ToList()),
            ("foco", "Em foco", lista.Where(c => c.Concluido is null && !(c.Prazo <= hoje)).ToList()),
            ("feitas", "Concluídas hoje", lista.Where(c => c.Concluido is not null).ToList()),
        }.Where(p => p.Itens.Count > 0).ToList();
        @if (t.Quadros.Count == 0)
        {
            <div class="chart-empty">Você ainda não tem quadros. Clique em "+ Quadro" para criar o primeiro.</div>
        }
        else if (lista.Count == 0)
        {
            <div class="b-vazio ev-vazio">
                <span>@(Filtrando ? "Nada encontrado com esses filtros." : "Nada para hoje. Cards com prazo até hoje ou marcados como foco (☆) aparecem aqui.")</span>
                @if (Filtrando)
                {
                    <button type="button" class="btn sm" @onclick="LimparFiltros">Limpar filtros</button>
                }
            </div>
        }
        else
        {
            @foreach (var (chave, titulo, itens) in partes)
            {
                <div class="ev-grupo tv-parte tv-@chave" @key="chave">
                    <div class="ev-grupo-cab"><b>@titulo</b><span>@itens.Count</span></div>
                    <div class="lista-hoje">
                        @foreach (var c in itens)
                        {
                            @CardView(c, true)
                        }
                    </div>
                </div>
            }
        }
    }
    else if (quadro is not null)
    {
        @* Barra de rolagem lateral em cima das colunas (a do .kanban fica escondida): o tarefas.js mantém as duas juntas *@
        <div class="kanban-barra" aria-hidden="true"><div></div></div>
        <div class="kanban">
            @foreach (var col in quadro.Colunas)
            {
                var ultima = TarefasCalculos.EhConcluida(quadro, col.Id);
                var daColuna = TarefasCalculos.DaColuna(t, col.Id).Where(Passa).ToList();
                // Na coluna de concluídas, as feitas há mais dias que o da engrenagem ficam escondidas (0 = mostra todas)
                var diasOcultar = t.DiasOcultarConcluidas;
                bool Antiga(CardTarefa c) => diasOcultar > 0 && c.Concluido is DateOnly f && hoje.DayNumber - f.DayNumber > diasOcultar;
                var antigas = ultima ? daColuna.Count(Antiga) : 0;
                var cards = ultima && _ocultarAntigos ? daColuna.Where(c => !Antiga(c)).ToList() : daColuna;
                var recolhida = Recolhida(col.Id);
                if (recolhida)
                {
                    @* Minimizada: a coluna fica no lugar, vazia e apagada, com cara de bloqueada; ainda recebe cards arrastados (vão para o fim) *@
                    <div class="coluna recolhida" @key="col.Id" data-coluna="@col.Id">
                        <div class="coluna-head">
                            <button type="button" class="coluna-seta" title="Expandir coluna" aria-label="Expandir a coluna @col.Nome" aria-expanded="false" @onclick="() => AlternarRecolhida(col.Id)">@SetaColuna(false)</button>
                            <b>@col.Nome</b>
                            <span class="tab-count">@cards.Count</span>
                        </div>
                        <div class="coluna-cards">
                            <button type="button" class="coluna-bloqueada" title="Expandir coluna" @onclick="() => AlternarRecolhida(col.Id)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
                                <span>Coluna minimizada</span>
                                <small>@(cards.Count == 0 ? "Nenhuma tarefa" : $"{cards.Count} {Plural(cards.Count, "tarefa escondida", "tarefas escondidas")}") · clique para mostrar</small>
                            </button>
                        </div>
                    </div>
                    continue;
                }
                <div class="coluna" @key="col.Id" data-coluna="@col.Id">
                    <div class="coluna-head">
                        <button type="button" class="coluna-seta" title="Minimizar coluna" aria-label="Minimizar a coluna @col.Nome" aria-expanded="true" @onclick="() => AlternarRecolhida(col.Id)">@SetaColuna(true)</button>
                        <b>@col.Nome</b>
                        <span class="tab-count">@cards.Count</span>
                        <span class="coluna-acoes">
                            <button type="button" title="Renomear coluna" @onclick="() => RenomearColuna(col)">@Icones.Editar</button>
                            @if (quadro.Colunas.Count > 1)
                            {
                                <button type="button" title="Excluir coluna" @onclick="() => ExcluirColuna(quadro, col)">@Icones.Excluir</button>
                            }
                        </span>
                    </div>
                    <div class="coluna-cards">
                        @foreach (var c in cards)
                        {
                            <div class="card-arrastavel" @key="c.Id" data-id="@c.Id">
                                @CardView(c, false)
                            </div>
                        }
                    </div>
                    @if (_rapidoColuna == col.Id)
                    {
                        @* Adicionar rápido: digita o título e Enter; o campo continua aberto para a próxima. Esc fecha. *@
                        <div class="coluna-rapido">
                            <input class="select" maxlength="140" placeholder="Título da tarefa e Enter" aria-label="Título da nova tarefa" autofocus
                                   @bind="_rapidoTexto" @bind:event="oninput" @onkeydown="e => TeclouRapido(e, quadro, col)" @onfocusout="SaiuDoRapido">
                            <div class="coluna-rapido-acoes">
                                <button type="button" class="btn sm primary" @onmousedown:preventDefault="true" @onclick="() => CriarRapido(quadro, col)">Adicionar</button>
                                <button type="button" class="btn sm" title="Abrir com prazo, prioridade, checklist..." @onmousedown:preventDefault="true" @onclick="() => MaisOpcoes(quadro, col)">Mais opções</button>
                                <button type="button" class="icon-btn" title="Fechar (Esc)" aria-label="Fechar" @onmousedown:preventDefault="true" @onclick="FecharRapido">@Icones.Fechar</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="coluna-add" @onclick="() => AbrirRapido(col.Id)">+ Adicionar tarefa</button>
                    }
                    @if (antigas > 0)
                    {
                        <button type="button" class="coluna-rodape" @onclick="() => _ocultarAntigos = !_ocultarAntigos">
                            @(_ocultarAntigos
                                ? $"Mostrar {antigas} {Plural(antigas, "concluída antiga", "concluídas antigas")}"
                                : $"Ocultar concluídas há mais de {diasOcultar} {Plural(diasOcultar, "dia", "dias")}")
                        </button>
                    }
                </div>
            }
            <button type="button" class="coluna-nova" @onclick="() => NovaColuna(quadro)">@Icones.Mais Nova coluna</button>
        </div>
    }
</section>

@* ---- Editor do card ---- *@
@if (_editando is not null)
{
    var qEd = Dados.Quadros.FirstOrDefault(q => q.Id == _fQuadro) ?? Dados.Quadros[0];
    <div class="modal-backdrop" @onclick="Fechar">
        <form class="card modal modal-largo" autocomplete="off" @onclick:stopPropagation="true" @onsubmit="Salvar">
            <h2>@(_novo ? "Nova tarefa" : "Editar tarefa")</h2>
            <div class="form-grid">
                <label class="field full"><span>Título *</span><input maxlength="140" required @bind="_fTitulo"></label>
                <label class="field"><span>Quadro</span>
                    <select @bind="_fQuadro" @bind:after="AoTrocarQuadro">
                        @foreach (var q in Dados.Quadros)
                        {
                            <option value="@q.Id">@TarefasCalculos.NomeQuadro(q)</option>
                        }
                    </select></label>
                <label class="field"><span>Coluna</span>
                    <select @bind="_fColuna">
                        @foreach (var col in qEd.Colunas)
                        {
                            <option value="@col.Id">@col.Nome</option>
                        }
                    </select></label>
                <div class="field"><span>Prazo</span>
                    <span class="prazo-campos">
                        <input type="date" aria-label="Dia do prazo" @bind="_fPrazo" @bind:after="AoMudarPrazo">
                        <input type="time" step="300" aria-label="Horário de entrega (opcional)" title="Horário de entrega (opcional)"
                               disabled="@(_fPrazo is null)" @bind="_fPrazoHora">
                    </span></div>
                <label class="field"><span>Prioridade</span>
                    <select @bind="_fPrioridade">
                        @foreach (var p in PrioridadeTarefa.Todas)
                        {
                            <option value="@p.Chave">@p.Nome</option>
                        }
                    </select></label>
                <label class="field full"><span>Etiquetas</span><input maxlength="120" placeholder="separadas por vírgula (ex.: cliente, urgente)" @bind="_fEtiquetas"></label>
                <label class="field full"><span>Descrição</span><textarea rows="3" maxlength="2000" @bind="_fDescricao"></textarea></label>
                <div class="field full">
                    <span>Checklist</span>
                    <ul class="checklist">
                        @foreach (var item in _fChecklist)
                        {
                            <li>
                                <input type="checkbox" @bind="item.Feito">
                                <input class="select" maxlength="140" @bind="item.Texto">
                                <button type="button" title="Remover item" @onclick="() => _fChecklist.Remove(item)">@Icones.Excluir</button>
                            </li>
                        }
                    </ul>
                    <div class="busca-linha">
                        <input class="select" maxlength="140" placeholder="Novo item..." @bind="_fNovoItem" @bind:event="oninput" @onkeydown="AoTeclarItem" data-sem-enviar>
                        <button class="btn sm" type="button" @onclick="AdicionarItem">Adicionar</button>
                    </div>
                </div>
                <CampoAnexos Rascunho="_anexos" />
                <label class="check full"><input type="checkbox" @bind="_fFoco"> Mostrar em "Hoje" mesmo sem prazo (foco do dia)</label>
            </div>
            <div class="form-actions">
                @if (!_novo)
                {
                    <button class="btn danger" type="button" @onclick="Excluir">Excluir</button>
                }
                <button class="btn" type="button" @onclick="Fechar">Cancelar</button>
                <button class="btn primary" type="submit">@(_novo ? "Criar tarefa" : "Salvar alterações")</button>
            </div>
        </form>
    </div>
}

<DialogoTexto @ref="_dialogoNome" />

@* ---- Configurações das Tarefas (engrenagem no topo) ---- *@
@if (_configAberta)
{
    <div class="modal-backdrop" @onclick="() => _configAberta = false">
        <form class="card modal" autocomplete="off" @onclick:stopPropagation="true" @onsubmit="SalvarConfig">
            <div><h2>@Icones.Engrenagem Configurações das Tarefas</h2><p class="muted">Valem só para esta seção. As do app ficam em Configurações, no menu.</p></div>
            <label class="check full"><input type="checkbox" @bind="_fOcultar"> Ocultar tarefas concluídas antigas na coluna de concluídas</label>
            @if (_fOcultar)
            {
                <label class="field"><span>Ocultar as concluídas há mais de quantos dias</span>
                    <input type="number" inputmode="numeric" min="1" max="365" required @bind="_fDiasOcultar"></label>
                @if (_fDiasOcultar is >= 1 and <= 365)
                {
                    <p class="muted">Ex.: uma tarefa concluída hoje some da coluna em @DataBR(Hoje.AddDays(_fDiasOcultar + 1)). Ela não é apagada: o rodapé da coluna tem "Mostrar concluídas antigas".</p>
                }
            }
            else
            {
                <p class="muted">Todas as concluídas ficam visíveis na coluna.</p>
            }
            <div class="form-actions">
                <button class="btn" type="button" @onclick="() => _configAberta = false">Cancelar</button>
                <button class="btn primary" type="submit">Salvar</button>
            </div>
        </form>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "quadro")] public string? QuadroDoLink { get; set; }

    /// <summary>Abre o editor deste card (link vindo da Agenda).</summary>
    [SupplyParameterFromQuery(Name = "card")] public string? CardDoLink { get; set; }

    /// <summary>tarefas?novo=1 (ou novo=hoje, com prazo para hoje) abre direto a janela de nova tarefa (Início).</summary>
    [SupplyParameterFromQuery(Name = "novo")] public string? NovoDoLink { get; set; }

    private string? _novoDoLink;

    private string? _cardAberto;

    // Filtros mantidos enquanto o app estiver aberto
    private static string _filtroPrioridade = "", _filtroEtiqueta = "";
    private static bool _ocultarAntigos = true;
    private string _filtroTexto = "";

    // Engrenagem: configurações das Tarefas
    private bool _configAberta, _fOcultar;
    private int _fDiasOcultar;

    private void AbrirConfig()
    {
        var dias = Dados.DiasOcultarConcluidas;
        _fOcultar = dias > 0;
        _fDiasOcultar = dias > 0 ? dias : DadosTarefas.PadraoDiasOcultarConcluidas;
        _configAberta = true;
    }

    private void SalvarConfig()
    {
        if (_fOcultar && _fDiasOcultar is not (>= 1 and <= 365)) { Toast.Erro("Informe de 1 a 365 dias."); return; }
        Dados.DiasOcultarConcluidas = _fOcultar ? _fDiasOcultar : 0;
        _ocultarAntigos = _fOcultar; // aplica já, mesmo se tinha clicado em "Mostrar concluídas antigas"
        Store.Salvar();
        _configAberta = false;
        Toast.Ok(_fOcultar ? $"Concluídas há mais de {_fDiasOcultar} {Plural(_fDiasOcultar, "dia", "dias")} ficam ocultas." : "Todas as concluídas ficam visíveis.");
    }

    private DialogoTexto _dialogoNome = default!;

    // Arrasto de cards e quadros (wwwroot/js/tarefas.js)
    private ElementReference _raiz;
    private TarefasInterop? _interop;
    private DotNetObjectReference<Tarefas>? _ref;

    // Menu do quadro (renomear, nova coluna, excluir), aberto onde a pessoa clicou
    private Quadro? _menuQuadro;
    private double _menuX, _menuY;

    private CardTarefa? _editando;
    private bool _novo;
    private string _fTitulo = "", _fQuadro = "", _fColuna = "", _fPrioridade = "media", _fEtiquetas = "", _fDescricao = "", _fNovoItem = "";
    private DateOnly? _fPrazo;
    private TimeOnly? _fPrazoHora;
    private bool _fFoco;
    private List<ItemChecklist> _fChecklist = [];

    // Anexos do formulário até salvar (cancelar apaga os arquivos novos)
    private readonly RascunhoAnexos _anexos = new();

    private DadosTarefas Dados => Store.Dados.Tarefas;

    protected override void OnParametersSet()
    {
        if (QuadroDoLink is not null && (QuadroDoLink == Quadro.Hoje || Dados.Quadros.Any(q => q.Id == QuadroDoLink)))
            Dados.Ativo = QuadroDoLink;
        if (NovoDoLink != _novoDoLink)
        {
            _novoDoLink = NovoDoLink;
            // No quadro aberto (ou no primeiro, se o aberto for o "Hoje"), na primeira coluna
            var q = Dados.Quadros.FirstOrDefault(x => x.Id == Dados.Ativo) ?? Dados.Quadros.FirstOrDefault();
            if (NovoDoLink is not null && q is { Colunas.Count: > 0 })
            {
                _novo = true;
                _editando = new CardTarefa { Prazo = NovoDoLink == "hoje" ? Hoje : null };
                PreencherForm(_editando, q.Id, q.Colunas[0].Id);
            }
        }
        if (CardDoLink is not null && CardDoLink != _cardAberto && Dados.Cards.FirstOrDefault(c => c.Id == CardDoLink) is { } card)
        {
            _cardAberto = CardDoLink;
            AbrirEdicao(card);
        }
    }

    private bool Filtrando => _filtroTexto.Trim().Length > 0 || _filtroPrioridade != "" || _filtroEtiqueta != "";

    private void LimparFiltros()
    {
        _filtroTexto = _filtroPrioridade = _filtroEtiqueta = "";
    }

    // ---- Colunas minimizadas (guardado só neste aparelho, em ConfigLocal) ----
    private static bool Recolhida(string colunaId) => ConfigLocal.Atual.ColunasRecolhidas.Contains(colunaId);

    private void AlternarRecolhida(string colunaId)
    {
        var lista = ConfigLocal.Atual.ColunasRecolhidas;
        if (!lista.Remove(colunaId)) lista.Add(colunaId);
        // Colunas que já não existem saem da lista
        lista.RemoveAll(id => !Dados.Quadros.Any(q => q.Colunas.Any(c => c.Id == id)));
        ConfigLocal.Atual.Salvar();
        if (_rapidoColuna == colunaId) FecharRapido();
    }

    // Setinha do título da coluna: aberta aponta para a esquerda (minimizar), minimizada para a direita (expandir)
    private static MarkupString SetaColuna(bool aberta) => new(aberta
        ? """<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>"""
        : """<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>""");

    // ---- Adicionar rápido na coluna ----
    private string? _rapidoColuna;
    private string _rapidoTexto = "";

    private void AbrirRapido(string colunaId)
    {
        _rapidoColuna = colunaId;
        _rapidoTexto = "";
    }

    private void FecharRapido()
    {
        _rapidoColuna = null;
        _rapidoTexto = "";
    }

    // Clicou fora com o campo vazio: fecha (com texto, deixa aberto para não perder o que foi digitado)
    private void SaiuDoRapido()
    {
        if (_rapidoTexto.Trim().Length == 0) FecharRapido();
    }

    private void TeclouRapido(KeyboardEventArgs e, Quadro q, ColunaQuadro col)
    {
        if (e.Key == "Enter") CriarRapido(q, col);
        else if (e.Key == "Escape") FecharRapido();
    }

    private void CriarRapido(Quadro q, ColunaQuadro col)
    {
        var titulo = _rapidoTexto.Trim();
        if (titulo.Length == 0) return;
        var c = new CardTarefa { Id = ArmazenamentoService.NovoId(), Titulo = titulo, Criado = Hoje, QuadroId = q.Id };
        Dados.Cards.Add(c);
        TarefasCalculos.Mover(Dados, c, col.Id, null, Hoje);
        Store.Salvar();
        _rapidoTexto = "";
    }

    // "Mais opções": abre a janela completa já com o título digitado
    private void MaisOpcoes(Quadro q, ColunaQuadro col)
    {
        var titulo = _rapidoTexto.Trim();
        FecharRapido();
        AbrirNovo(q, col);
        _fTitulo = titulo;
    }

    private bool Passa(CardTarefa c)
    {
        var termo = _filtroTexto.Trim();
        return (_filtroPrioridade == "" || c.Prioridade == _filtroPrioridade)
            && (_filtroEtiqueta == "" || c.Etiquetas.Contains(_filtroEtiqueta))
            && (termo.Length == 0 || c.Titulo.Contains(termo, StringComparison.CurrentCultureIgnoreCase)
                || (c.Descricao?.Contains(termo, StringComparison.CurrentCultureIgnoreCase) ?? false));
    }

    private RenderFragment CardView(CardTarefa c, bool mostrarQuadro) => __builder =>
    {
        var q = TarefasCalculos.QuadroDe(Dados, c);
        var prio = PrioridadeTarefa.Buscar(c.Prioridade);
        var feitos = c.Checklist.Count(i => i.Feito);
        <div class="tarefa @(c.Concluido is not null ? "feita" : "") prio-@c.Prioridade" @onclick="() => AbrirEdicao(c)">
            <div class="tarefa-topo">
                <button type="button" class="tarefa-check" title="@(c.Concluido is null ? "Marcar como concluída" : "Reabrir")"
                        @onclick="() => AlternarConcluida(c)" @onclick:stopPropagation="true">@(c.Concluido is null ? "" : "✓")</button>
                <span class="tarefa-titulo">@c.Titulo</span>
                <button type="button" class="tarefa-foco @(c.Foco ? "on" : "")" title="Foco do dia"
                        @onclick="() => AlternarFoco(c)" @onclick:stopPropagation="true">@(c.Foco ? "★" : "☆")</button>
            </div>
            @if (!string.IsNullOrEmpty(c.Descricao))
            {
                <p class="tarefa-desc">@c.Descricao</p>
            }
            @if (c.Checklist.Count > 0)
            {
                <div class="tarefa-progresso" title="@feitos de @c.Checklist.Count itens">
                    <span style="width: @((feitos * 100 / c.Checklist.Count).ToString())%"></span>
                </div>
            }
            <div class="tarefa-meta">
                @if (mostrarQuadro && q is not null)
                {
                    <span class="badge">@q.Nome</span>
                }
                @if (c.Concluido is DateOnly f)
                {
                    <span class="badge good">feita @(f == Hoje ? "hoje" : DataCurta(f))</span>
                }
                else if (c.Prazo is not null)
                {
                    var (texto, classe) = TarefasCalculos.Prazo(c, DateTime.Now);
                    <span class="badge @classe">@texto</span>
                }
                @if (c.Prioridade != "media")
                {
                    <span class="badge @prio.Classe">@prio.Nome</span>
                }
                @if (c.Checklist.Count > 0)
                {
                    <span class="badge">☑ @feitos/@c.Checklist.Count</span>
                }
                @if (c.Anexos.Count > 0)
                {
                    <span class="badge" title="@c.Anexos.Count @Plural(c.Anexos.Count, "anexo", "anexos")">📎 @c.Anexos.Count</span>
                }
                @foreach (var e in c.Etiquetas)
                {
                    <span class="etiqueta">#@e</span>
                }
            </div>
        </div>
    };

    private void Abrir(string id)
    {
        Dados.Ativo = id;
        Store.Salvar();
    }

    // ---- Arrastar e soltar (chamado pelo tarefas.js) ----
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        _interop = new TarefasInterop(JS);
        await _interop.IniciarAsync(_raiz, _ref);
    }

    public async ValueTask DisposeAsync()
    {
        if (_editando is not null) Fechar(); // saiu da página com o formulário aberto: descarta os anexos não salvos
        if (_interop is not null) await _interop.DisposeAsync();
        _ref?.Dispose();
    }

    /// <summary>Card solto na coluna <paramref name="colunaId"/>, antes do card <paramref name="antesDeId"/> (null = no fim).</summary>
    [JSInvokable]
    public Task MoveuCard(string id, string colunaId, string? antesDeId) => InvokeAsync(() =>
    {
        if (Dados.Cards.FirstOrDefault(c => c.Id == id) is not { } card) return;
        int? posicao = null;
        if (antesDeId is not null)
        {
            var i = TarefasCalculos.DaColuna(Dados, colunaId).Where(c => c != card).ToList().FindIndex(c => c.Id == antesDeId);
            if (i >= 0) posicao = i;
        }
        TarefasCalculos.Mover(Dados, card, colunaId, posicao, Hoje);
        Store.Salvar();
        StateHasChanged();
    });

    /// <summary>Quadro (aba) solto na posição <paramref name="indice"/> entre os outros.</summary>
    [JSInvokable]
    public Task MoveuQuadro(string id, int indice) => InvokeAsync(() =>
    {
        if (Dados.Quadros.FirstOrDefault(q => q.Id == id) is not { } q) return;
        Dados.Quadros.Remove(q);
        Dados.Quadros.Insert(Math.Clamp(indice, 0, Dados.Quadros.Count), q);
        Store.Salvar();
        StateHasChanged();
    });

    /// <summary>Coluna solta na posição <paramref name="indice"/> entre as do quadro.</summary>
    [JSInvokable]
    public Task MoveuColuna(string id, int indice) => InvokeAsync(() =>
    {
        if (Dados.Quadros.FirstOrDefault(q => q.Colunas.Any(c => c.Id == id)) is not { } q) return;
        var ultimaAntes = q.Colunas[^1];
        TarefasCalculos.MoverColuna(Dados, q, id, indice, Hoje);
        Store.Salvar();
        StateHasChanged();
        // A última coluna é a de concluídas: avisa quando ela muda
        if (q.Colunas[^1] != ultimaAntes) Toast.Ok($"\"{q.Colunas[^1].Nome}\" agora é a coluna de concluídas.");
    });

    private void AlternarConcluida(CardTarefa c)
    {
        TarefasCalculos.AlternarConcluida(Dados, c, Hoje);
        Store.Salvar();
    }

    private void AlternarFoco(CardTarefa c)
    {
        c.Foco = !c.Foco;
        Store.Salvar();
    }

    // ---- Quadros e colunas ----
    private async Task NovoQuadro()
    {
        var nome = await _dialogoNome.Perguntar("Novo quadro", "Nome do quadro (pode começar com um emoji, ex.: 🎓 Faculdade)");
        if (nome is null) return;
        var (emoji, resto) = SepararEmoji(nome);
        var q = TarefasCalculos.NovoQuadro(resto, emoji);
        Dados.Quadros.Add(q);
        Abrir(q.Id);
        Toast.Ok($"Quadro \"{TarefasCalculos.NomeQuadro(q)}\" criado.");
    }

    private async Task RenomearQuadro(Quadro q)
    {
        var nome = await _dialogoNome.Perguntar("Renomear quadro", "Nome do quadro (pode começar com um emoji)", TarefasCalculos.NomeQuadro(q));
        if (nome is null) return;
        (q.Emoji, q.Nome) = SepararEmoji(nome);
        Store.Salvar();
    }

    // Clique no quadro já aberto mostra o menu dele; nos outros, só troca de quadro
    private void ClicouQuadro(Quadro q, MouseEventArgs e)
    {
        if (q.Id == Dados.Ativo) AbrirMenuQuadro(q, e);
        else Abrir(q.Id);
    }

    private void AbrirMenuQuadro(Quadro q, MouseEventArgs e)
    {
        _menuQuadro = q;
        // Teclado (Enter/espaço) não tem posição: ancora no canto
        (_menuX, _menuY) = e.ClientX > 0 || e.ClientY > 0 ? (e.ClientX, e.ClientY + 8) : (24, 160);
    }

    private void FecharMenu() => _menuQuadro = null;

    private Task DoMenu(Func<Task> acao)
    {
        FecharMenu();
        return acao();
    }

    private static string Px(double v) => v.ToString("0", System.Globalization.CultureInfo.InvariantCulture) + "px";

    private async Task ExcluirQuadro(Quadro q)
    {
        var n = Dados.Cards.Count(c => c.QuadroId == q.Id);
        if (!await Dialogo.Confirmar($"Excluir o quadro \"{TarefasCalculos.NomeQuadro(q)}\"?\n{(n > 0 ? $"As {n} tarefas dele também serão apagadas." : "Ele está vazio.")}")) return;
        RascunhoAnexos.ExcluirTodos(Dados.Cards.Where(c => c.QuadroId == q.Id).SelectMany(c => c.Anexos));
        Dados.Cards.RemoveAll(c => c.QuadroId == q.Id);
        Dados.Quadros.Remove(q);
        Abrir(Dados.Quadros.Count > 0 ? Dados.Quadros[0].Id : Quadro.Hoje);
        Toast.Ok("Quadro excluído.");
    }

    private async Task NovaColuna(Quadro q)
    {
        var nome = await _dialogoNome.Perguntar("Nova coluna", "Nome da coluna (ex.: Esperando, Revisão)");
        if (nome is null) return;
        // Entra antes da coluna de concluídos, que continua sendo a última
        q.Colunas.Insert(Math.Max(0, q.Colunas.Count - 1), new ColunaQuadro { Id = ArmazenamentoService.NovoId(), Nome = nome });
        Store.Salvar();
    }

    private async Task RenomearColuna(ColunaQuadro col)
    {
        var nome = await _dialogoNome.Perguntar("Renomear coluna", "Nome da coluna", col.Nome);
        if (nome is null) return;
        col.Nome = nome;
        Store.Salvar();
    }

    private async Task ExcluirColuna(Quadro q, ColunaQuadro col)
    {
        var cards = TarefasCalculos.DaColuna(Dados, col.Id);
        var destino = q.Colunas.First(c => c != col);
        if (!await Dialogo.Confirmar($"Excluir a coluna \"{col.Nome}\"?\n{(cards.Count > 0 ? $"As {cards.Count} tarefas dela vão para \"{destino.Nome}\"." : "Ela está vazia.")}")) return;
        q.Colunas.Remove(col);
        foreach (var c in cards) TarefasCalculos.Mover(Dados, c, destino.Id, null, Hoje);
        // A coluna de concluídos pode ter mudado: acerta as datas de conclusão
        foreach (var c in Dados.Cards.Where(c => c.QuadroId == q.Id))
        {
            if (TarefasCalculos.EhConcluida(q, c.ColunaId)) c.Concluido ??= Hoje;
            else c.Concluido = null;
        }
        Store.Salvar();
    }

    private static (string? Emoji, string Nome) SepararEmoji(string texto)
    {
        var partes = texto.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
        var primeiro = partes[0];
        var ehEmoji = partes.Length == 2 && primeiro.Length <= 8 && !primeiro.Any(char.IsLetterOrDigit);
        return ehEmoji ? (primeiro, partes[1].Trim()) : (null, texto.Trim());
    }

    // ---- Editor ----
    private void AbrirNovo(Quadro q, ColunaQuadro col)
    {
        _novo = true;
        _editando = new CardTarefa();
        PreencherForm(_editando, q.Id, col.Id);
    }

    private void AbrirEdicao(CardTarefa c)
    {
        _novo = false;
        _editando = c;
        PreencherForm(c, c.QuadroId, c.ColunaId);
    }

    private void PreencherForm(CardTarefa c, string quadroId, string colunaId)
    {
        (_fQuadro, _fColuna) = (quadroId, colunaId);
        _fTitulo = c.Titulo;
        _fDescricao = c.Descricao ?? "";
        _fPrazo = c.Prazo;
        _fPrazoHora = c.PrazoHora;
        _fPrioridade = c.Prioridade;
        _fEtiquetas = string.Join(", ", c.Etiquetas);
        _fFoco = c.Foco;
        _fChecklist = c.Checklist.Select(i => new ItemChecklist { Texto = i.Texto, Feito = i.Feito }).ToList();
        _fNovoItem = "";
        _anexos.Iniciar(c.Anexos);
    }

    // Sem dia não há horário de entrega
    private void AoMudarPrazo()
    {
        if (_fPrazo is null) _fPrazoHora = null;
    }

    private void AoTrocarQuadro()
    {
        var q = Dados.Quadros.FirstOrDefault(q => q.Id == _fQuadro);
        if (q is not null && q.Colunas.All(c => c.Id != _fColuna)) _fColuna = q.Colunas[0].Id;
    }

    private void AoTeclarItem(KeyboardEventArgs e)
    {
        // Enter no campo do checklist adiciona o item (o interop.js impede que envie o formulário)
        if (e.Key == "Enter") AdicionarItem();
    }

    private void AdicionarItem()
    {
        if (string.IsNullOrWhiteSpace(_fNovoItem)) return;
        _fChecklist.Add(new ItemChecklist { Texto = _fNovoItem.Trim() });
        _fNovoItem = "";
    }

    /// <summary>Fecha o formulário. Sem salvar, os anexos compactados nele são apagados.</summary>
    private void Fechar()
    {
        _anexos.Descartar();
        _editando = null;
    }

    private void Salvar()
    {
        if (_editando is not { } c) return;
        var titulo = _fTitulo.Trim();
        if (titulo.Length == 0) { Toast.Erro("Informe o título."); return; }
        AdicionarItem();

        c.Titulo = titulo;
        c.Descricao = string.IsNullOrWhiteSpace(_fDescricao) ? null : _fDescricao.Trim();
        c.Prazo = _fPrazo;
        c.PrazoHora = _fPrazo is null ? null : _fPrazoHora;
        c.Prioridade = _fPrioridade;
        c.Foco = _fFoco;
        c.Etiquetas = _fEtiquetas.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(e => e.TrimStart('#').ToLowerInvariant()).Where(e => e.Length > 0).Distinct().ToList();
        c.Checklist = _fChecklist.Where(i => !string.IsNullOrWhiteSpace(i.Texto)).ToList();
        c.Anexos = _anexos.Confirmar(); // agora são do card: Fechar() não os apaga

        if (_novo)
        {
            c.Id = ArmazenamentoService.NovoId();
            c.Criado = Hoje;
            Dados.Cards.Add(c);
        }
        if (_novo || c.QuadroId != _fQuadro || c.ColunaId != _fColuna)
        {
            c.QuadroId = _fQuadro;
            TarefasCalculos.Mover(Dados, c, _fColuna, null, Hoje);
        }
        Store.Salvar();
        Toast.Ok(_novo ? "Tarefa criada." : "Tarefa atualizada.");
        Fechar();
    }

    private async Task Excluir()
    {
        if (_editando is not { } c || !await Dialogo.Confirmar($"Excluir a tarefa \"{c.Titulo}\"?")) return;
        Dados.Cards.Remove(c);
        RascunhoAnexos.ExcluirTodos(c.Anexos);
        Store.Salvar();
        Fechar();
        Toast.Ok("Tarefa excluída.");
    }
}
