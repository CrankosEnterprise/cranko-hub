@* Conta no rodapé da barra lateral: "Entrar" abre o login; logado, o nome abre um menu com a sincronização e Sair *@
@implements IDisposable
@inject ContaService Conta
@inject SincronizacaoService Sincronizacao
@inject IDialogoService Dialogo
@inject ToastService Toast
@inject IJSRuntime JS

<div class="conta" @onkeydown="AoTeclar">
    @if (Conta.Logado)
    {
        @if (_menu)
        {
            <div class="conta-fundo" @onclick="() => _menu = false"></div>
            <div class="conta-menu" role="menu">
                <p class="conta-status @(Sincronizacao.Problema is not null || !ArmazenamentoService.PorConta ? "problema" : "")">@StatusCompleto</p>
                @if (ArmazenamentoService.PorConta)
                {
                    <button class="conta-opcao" type="button" role="menuitem" disabled="@Sincronizacao.Sincronizando" @onclick="SincronizarAgora">@Icones.Sincronizar<span>Sincronizar agora</span></button>
                }
                <button class="conta-opcao perigo" type="button" role="menuitem" @onclick="Sair">@Icones.Sair<span>Sair</span></button>
            </div>
        }
        <button class="conta-btn" type="button" aria-haspopup="menu" aria-expanded="@_menu" @onclick="() => _menu = !_menu">
            <span class="conta-avatar">@Inicial</span>
            <span class="conta-texto"><b>@Conta.Usuario</b><small>@StatusCurto</small></span>
        </button>
    }
    else
    {
        <button class="conta-btn" type="button" @onclick="AbrirLogin">
            <span class="conta-avatar vazio">@Icones.Usuario</span>
            <span class="conta-texto"><b>Entrar</b><small>@(ArmazenamentoService.PorConta ? "Sessão encerrada" : "Sincronize seus dados")</small></span>
        </button>
    }
</div>

@if (_login)
{
    <div class="modal-backdrop" @onclick="FecharLogin">
        <form class="card modal" autocomplete="off" @onclick:stopPropagation="true" @onsubmit="Entrar" @onkeydown="AoTeclar">
            <div class="card-head"><div><h2>Entrar</h2><p>Conta do CrankoHub, para os dados ficarem disponíveis em outros aparelhos.</p></div></div>
            <label class="field"><span>Usuário</span><input @ref="_campoUsuario" maxlength="60" autocapitalize="off" spellcheck="false" @bind="_usuario"></label>
            <label class="field"><span>Senha</span><input type="password" maxlength="200" @bind="_senha"></label>
            @if (_erro is not null)
            {
                <p class="aviso-sincronia">@_erro</p>
            }
            <p class="muted conta-explicacao">
                @(ArmazenamentoService.PorConta
                    ? "A sessão foi encerrada. Entre de novo para voltar a sincronizar."
                    : "Ao entrar, o app reinicia e passa a usar os dados da conta. Se ela estiver vazia, os dados deste computador sobem para ela; se já tiver dados, eles são usados aqui e os atuais ficam guardados. Ao sair, os dados de agora voltam.")
            </p>
            <div class="form-actions">
                <button class="btn" type="button" @onclick="FecharLogin">Cancelar</button>
                <button class="btn primary" type="submit" disabled="@_entrando">@(_entrando ? "Entrando…" : "Entrar")</button>
            </div>
        </form>
    </div>
}

@code {
    private bool _menu, _login, _entrando, _focar;
    private string _usuario = "", _senha = "";
    private string? _erro;
    private ElementReference _campoUsuario;

    private string Inicial => Conta.Usuario is { Length: > 0 } u ? u[..1].ToUpperInvariant() : "?";

    // Linha curta embaixo do nome
    private string StatusCurto =>
        Conta.Offline ? "Sem conexão" :
        !ArmazenamentoService.PorConta ? "Reinicie para usar a conta" :
        Sincronizacao.Problema is not null ? "Não sincronizado" :
        Sincronizacao.Sincronizando ? "Sincronizando…" :
        Sincronizacao.Ultima is DateTime u ? $"Sincronizado às {u:HH:mm}" : "Preparando…";

    // Explicação completa, no topo do menu
    private string StatusCompleto =>
        !ArmazenamentoService.PorConta ? "Reinicie o app para começar a usar os dados da conta." :
        Sincronizacao.Problema ?? (Sincronizacao.Sincronizando ? "Sincronizando…" :
            Sincronizacao.Ultima is DateTime u ? $"Sincronizado às {u:HH:mm}. As mudanças vão sozinhas para os outros aparelhos." : "Preparando a sincronização…");

    // A sessão é renovada em segundo plano ao abrir o app e a sincronização muda o status: redesenha
    private void Mudou() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        Conta.Mudou += Mudou;
        Sincronizacao.Mudou += Mudou;
    }

    public void Dispose()
    {
        Conta.Mudou -= Mudou;
        Sincronizacao.Mudou -= Mudou;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focar) return;
        _focar = false;
        await JS.InvokeVoidAsync("crankohub.focar", _campoUsuario);
    }

    private void AbrirLogin()
    {
        (_usuario, _senha, _erro) = (Conta.Usuario ?? "", "", null);
        _login = _focar = true;
    }

    private void FecharLogin()
    {
        if (_entrando) return;
        _login = false;
        _senha = "";
    }

    private void AoTeclar(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        _menu = false;
        FecharLogin();
    }

    private async Task Entrar()
    {
        _erro = null;
        _entrando = true;
        try
        {
            await Conta.Entrar(_usuario, _senha);
            _senha = "";
            Toast.Ok($"Conectado como {Conta.Usuario}. Reiniciando…");
            AtualizacaoService.Reiniciar();
        }
        catch (InvalidOperationException ex)
        {
            _erro = ex.Message;
        }
        _entrando = false;
    }

    private async Task SincronizarAgora()
    {
        _menu = false;
        await Sincronizacao.Sincronizar();
    }

    private async Task Sair()
    {
        _menu = false;
        if (!await Dialogo.Confirmar("Sair da conta?\nAs mudanças pendentes são enviadas antes. O app reinicia e volta a usar os dados que estavam neste computador antes do login. Os dados da conta continuam na nuvem.")) return;
        await Sincronizacao.Sincronizar();
        await Conta.Sair();
        AtualizacaoService.Reiniciar();
    }
}
