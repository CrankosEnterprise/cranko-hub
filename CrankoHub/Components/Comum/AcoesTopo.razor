@namespace CrankoHub.Components
@* Botões da página (adicionar, configurações da seção...) que aparecem na barra do topo, à direita do título.
   Uso: <AcoesTopo> ...botões... </AcoesTopo>. Os botões com texto usam <span class="rotulo">, que some quando falta espaço. *@
@using Microsoft.AspNetCore.Components.Sections

<SectionContent SectionName="@Nome">@ChildContent</SectionContent>

@code {
    /// <summary>Nome do lugar na barra do topo (Layout/LayoutPrincipal.razor) onde os botões entram.</summary>
    public const string Nome = "acoes-topo";

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
