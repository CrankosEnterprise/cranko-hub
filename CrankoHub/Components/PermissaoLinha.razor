@* Uma permissão do Modo Carro (Configurações → Modo Carro): estado, para que serve e o botão Ativar.
   Lista = true: linha da lista "Permissões do Modo Carro" (mostra também as ativadas); senão, aviso em linha numa seção. *@

@{
    var p = Permissao;
    var (classe, estado) = p.Ativada switch
    {
        true => ("ok", "Ativada"),
        false => (p.Necessaria ? "falta" : "opcional", p.Necessaria ? "Falta ativar" : "Opcional"),
        null => ("conferir", "Confira"),
    };
}

<div class="mc-permissao @classe @(Lista ? "" : "em-linha")">
    <span class="mc-permissao-estado" aria-hidden="true">@(p.Ativada == true ? "✓" : p.Ativada == false && p.Necessaria ? "!" : "?")</span>
    <div class="mc-permissao-texto">
        <b>@p.Nome <span class="mc-permissao-selo">@estado</span></b>
        <span>@p.Motivo</span>
    </div>
    @if (p.Ativada != true)
    {
        <button type="button" class="btn @(p.Ativada == false && p.Necessaria ? "primary" : "")" aria-label="@(p.Ativada is null ? "Abrir" : "Ativar") @p.Nome"
                @onclick="() => AoAtivar.InvokeAsync(p.Id)">@(p.Ativada is null ? "Abrir" : "Ativar")</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public PermissaoCarro Permissao { get; set; } = default!;

    [Parameter] public EventCallback<string> AoAtivar { get; set; }

    [Parameter] public bool Lista { get; set; }
}
