@* Marcador de combustível analógico (janela por cima do formulário de abastecimento).
   O usuário põe o ponteiro como está no painel ANTES de abastecer, em oitavos. Com o tamanho do tanque e o
   nível que sobrou depois do abastecimento anterior, estima os litros gastos (CarroCalculos.GastoPeloMarcador).
   Sem o tanque cadastrado, pede aqui mesmo e grava na ficha do veículo. *@
@inject ArmazenamentoService Store
@inject ToastService Toast

<div class="modal-backdrop" @onclick="Cancelar">
<div class="card modal marcador" role="dialog" aria-modal="true" aria-labelledby="marcador-titulo" @onclick:stopPropagation="true">
    <div>
        <h2 id="marcador-titulo">@Icones.Bomba Marcador de combustível</h2>
        <p class="muted">Coloque o ponteiro como estava no painel <b>antes</b> de abastecer.</p>
    </div>

    @if (TanqueCadastrado is null)
    {
        <label class="field"><span>Seu tanque tem quantos litros? *</span>
            <input inputmode="decimal" placeholder="ex.: 44" @bind="_fTanque" @bind:event="oninput">
            <small class="muted">Fica salvo na ficha do veículo. Está no manual ou na ficha técnica do carro.</small>
        </label>
    }

    <div class="marcador-mostrador">
        <svg class="marcador-svg" width="@L" height="@A" viewBox="0 0 @L @A" role="slider" tabindex="0"
             aria-label="Nível do combustível" aria-valuemin="0" aria-valuemax="@P" aria-valuenow="@_nivel" aria-valuetext="@Fracao(_nivel)"
             @onpointerdown="Pressionar" @onpointermove="Mover" @onpointerup="Soltar" @onpointerleave="Soltar" @onpointercancel="Soltar"
             @onkeydown="Tecla">
            <path class="marcador-reserva" d="@Arco(0, 1, R - 4)" />
            @for (var i = 0; i <= P; i++)
            {
                var (x1, y1) = Ponto(i, R - (i % 4 == 0 ? 20 : 12));
                var (x2, y2) = Ponto(i, R);
                <line class="marcador-traco @(i % 4 == 0 ? "grande" : "") @(i == 0 ? "reserva" : "")" x1="@F(x1)" y1="@F(y1)" x2="@F(x2)" y2="@F(y2)" />
            }
            @{ var (tx8, ty8) = Ponto(P, R - 40); var (tx4, ty4) = Ponto(P / 2, R - 40); var (tx0, ty0) = Ponto(0, R - 34); }
            <text class="marcador-rotulo" x="@F(tx8)" y="@F(ty8 + 5)" text-anchor="middle">1/1</text>
            <text class="marcador-rotulo" x="@F(tx4)" y="@F(ty4 + 5)" text-anchor="middle">1/2</text>
            <text class="marcador-rotulo vazio" x="@F(tx0)" y="@F(ty0 + 5)" text-anchor="middle">0</text>
            <g class="marcador-icone" transform="translate(14 14) scale(1.2)">
                <path d="M4 21V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v16M3 21h13M4 10h11" />
                <path d="M15 8h2a2 2 0 0 1 2 2v6a1.5 1.5 0 0 0 3 0V8l-3-3" />
            </g>
            @{ var (px, py) = Ponto(_nivel, R - 8); }
            <line class="marcador-ponteiro" x1="@F(Cx)" y1="@F(Cy)" x2="@F(px)" y2="@F(py)" />
            <circle class="marcador-eixo" cx="@F(Cx)" cy="@F(Cy)" r="9" />
        </svg>
        <div class="marcador-ajuste">
            <button type="button" class="btn sm" aria-label="Menos combustível" disabled="@(_nivel <= 0)" @onclick="() => Definir(_nivel - 1)">−</button>
            <b>@Fracao(_nivel)</b>
            <button type="button" class="btn sm" aria-label="Mais combustível" disabled="@(_nivel >= P)" @onclick="() => Definir(_nivel + 1)">+</button>
        </div>
    </div>

    @{ var r = Calcular(); }
    <div class="preview marcador-conta @(r.Problema is not null ? "aviso" : "")">
        @if (r.Tanque is not double tanque)
        {
            <span>Informe o tamanho do tanque para calcular.</span>
        }
        else
        {
            <span>Agora: <b>≈ @Num(CarroCalculos.LitrosNoNivel(_nivel, tanque), 1) L</b> no tanque</span>
            @if (r.Base is double b)
            {
                <span>· depois do último: <b>≈ @Num(b, 1) L</b></span>
            }
            @if (r.Gasto is double g && r.Problema is null)
            {
                <span>· gasto <b>≈ @Num(g, 1) L</b></span>
                @if (Km > 0) { <span>· <b>@Num(Km / g, 1) km/l</b></span> }
            }
            @if (r.Mensagem is not null) { <span class="marcador-msg">@r.Mensagem</span> }
            @if (r.Problema is not null) { <span class="marcador-msg">⚠ @r.Problema</span> }
        }
    </div>

    <div class="form-actions">
        <button class="btn" type="button" @onclick="Cancelar">Cancelar</button>
        <button class="btn primary" type="button" disabled="@(r.Tanque is null)" @onclick="Confirmar">
            @(r.Gasto is not null && r.Problema is null ? "Usar ≈ " + Num(r.Gasto, 1) + " L" : "Guardar só o ponteiro")
        </button>
    </div>
</div>
</div>

@code {
    [Parameter, EditorRequired] public Veiculo Veiculo { get; set; } = default!;

    /// <summary>Abastecimento anterior a este (base do cálculo); null se é o primeiro.</summary>
    [Parameter] public Abastecimento? Anterior { get; set; }

    /// <summary>Km rodados digitados no formulário (só para mostrar o km/l).</summary>
    [Parameter] public double? Km { get; set; }

    [Parameter] public int? NivelInicial { get; set; }

    /// <summary>Nível escolhido (oitavos) e o gasto estimado (null quando não deu para calcular).</summary>
    [Parameter] public EventCallback<(int Nivel, double? Gasto)> Confirmado { get; set; }

    [Parameter] public EventCallback Fechado { get; set; }

    private const int P = CarroCalculos.PartesMarcador;

    // Geometria do mostrador: eixo à esquerda e arco à direita, do vazio (embaixo) ao cheio (em cima), como no painel
    private const double L = 240, A = 210, Cx = 70, Cy = 132, R = 112, AnguloVazio = -40, AnguloCheio = 78;

    private int _nivel = 4;
    private bool _arrastando;
    private string _fTanque = "";

    private double? TanqueCadastrado => Veiculo.Ficha?.TanqueLitros is > 0 ? Veiculo.Ficha.TanqueLitros : null;

    protected override void OnInitialized() => _nivel = Math.Clamp(NivelInicial ?? P / 2, 0, P);

    private record Resultado(double? Tanque, double? Base, double? Gasto, string? Mensagem, string? Problema);

    private Resultado Calcular()
    {
        var tanque = TanqueCadastrado ?? (Pf(_fTanque) is > 0 and <= 500 and var t ? t : null);
        if (tanque is not double tq) return new(null, null, null, null, null);
        if (Anterior is null)
            return new(tq, null, null, "Primeiro abastecimento: o ponteiro fica guardado como base para o próximo.", null);
        var depois = CarroCalculos.NivelDepois(Anterior, tq);
        if (depois is null)
            return new(tq, null, null, $"O abastecimento de {DataBR(Anterior.Data)} não tem ponteiro marcado nem tanque cheio, então não há base para calcular. O ponteiro fica guardado para o próximo.", null);
        var gasto = depois.Value - CarroCalculos.LitrosNoNivel(_nivel, tq);
        string? problema = null;
        if (gasto < 0.5)
            problema = "O ponteiro está acima do que sobrou depois do último abastecimento. Confira o ponteiro ou o tamanho do tanque.";
        else if (Km > 0 && Km / gasto > 60)
            problema = $"Daria {Num(Km / gasto, 1)} km/l, acima do possível. Confira o ponteiro, os km ou o tamanho do tanque.";
        return new(tq, depois, gasto, null, problema);
    }

    private async Task Confirmar()
    {
        var r = Calcular();
        if (r.Tanque is not double tanque) { Toast.Erro("Informe quantos litros cabem no tanque."); return; }
        if (TanqueCadastrado is null)
        {
            Veiculo.Ficha ??= new FichaVeiculo();
            Veiculo.Ficha.TanqueLitros = tanque;
            Store.Salvar();
            Toast.Ok($"Tanque de {Num(tanque, 0)} L salvo na ficha do veículo.");
        }
        await Confirmado.InvokeAsync((_nivel, r.Problema is null ? r.Gasto : null));
    }

    private Task Cancelar() => Fechado.InvokeAsync();

    private void Definir(int nivel) => _nivel = Math.Clamp(nivel, 0, P);

    private void Pressionar(PointerEventArgs e) { _arrastando = true; Apontar(e); }

    private void Mover(PointerEventArgs e) { if (_arrastando) Apontar(e); }

    private void Soltar() => _arrastando = false;

    /// <summary>Ângulo do toque em relação ao eixo → oitavo mais próximo.</summary>
    private void Apontar(PointerEventArgs e)
    {
        var angulo = Math.Atan2(Cy - e.OffsetY, e.OffsetX - Cx) * 180 / Math.PI;
        var frac = (angulo - AnguloVazio) / (AnguloCheio - AnguloVazio);
        Definir((int)Math.Round(Math.Clamp(frac, 0, 1) * P));
    }

    private void Tecla(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowUp" or "ArrowRight": Definir(_nivel + 1); break;
            case "ArrowDown" or "ArrowLeft": Definir(_nivel - 1); break;
            case "Home": Definir(0); break;
            case "End": Definir(P); break;
        }
    }

    private static (double X, double Y) Ponto(double nivel, double raio)
    {
        var a = (AnguloVazio + (AnguloCheio - AnguloVazio) * nivel / P) * Math.PI / 180;
        return (Cx + raio * Math.Cos(a), Cy - raio * Math.Sin(a));
    }

    private static string Arco(double de, double ate, double raio)
    {
        var (x1, y1) = Ponto(de, raio);
        var (x2, y2) = Ponto(ate, raio);
        return $"M{F(x1)} {F(y1)} A{F(raio)} {F(raio)} 0 0 0 {F(x2)} {F(y2)}";
    }

    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>"3/8", "1/2" (frações simplificadas), "Vazio" e "Cheio".</summary>
    public static string Fracao(int nivel) => nivel switch
    {
        <= 0 => "Vazio",
        >= P => "Cheio",
        _ => Simplificar(nivel)
    };

    private static string Simplificar(int n)
    {
        int d = P, a = n, b = d;
        while (b != 0) (a, b) = (b, a % b);
        return $"{n / a}/{d / a}";
    }
}
