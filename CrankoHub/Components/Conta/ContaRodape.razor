@namespace CrankoHub.Components
@* Conta: o nome (ou, compacto, só o avatar na barra do topo) abre um menu com Informações (página da Conta),
   a sincronização e Sair (o login é a TelaLogin). Compacto, o menu abre para baixo.
   Fecha no X, clicando fora (crankohub.fecharAoClicarFora) ou com Esc. *@
@implements IAsyncDisposable
@inject ContaService Conta
@inject SincronizacaoService Sincronizacao
@inject IDialogoService Dialogo
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="conta @(Compacto ? "compacta" : "")" @ref="_raiz">
    @if (Conta.Logado)
    {
        @if (_menu)
        {
            <div class="conta-menu" role="menu">
                <button class="conta-fechar" type="button" title="Fechar" aria-label="Fechar o menu" @onclick="() => _menu = false">@Icones.Fechar</button>
                @if (Compacto)
                {
                    <div class="conta-cab"><span class="conta-avatar">@Inicial</span><span class="conta-texto"><b>@Conta.Usuario</b><small>@StatusCurto</small></span></div>
                }
                <p class="conta-status @(Sincronizacao.Problema is not null ? "problema" : "")">@StatusCompleto</p>
                <button class="conta-opcao" type="button" role="menuitem" title="Ver os dados da conta e o que está guardado nela" @onclick="AbrirInformacoes">@Icones.Info<span>Informações</span></button>
                <button class="conta-opcao" type="button" role="menuitem" disabled="@Sincronizacao.Sincronizando" @onclick="SincronizarAgora">@Icones.Sincronizar<span>Sincronizar agora</span></button>
                <button class="conta-opcao perigo" type="button" role="menuitem" @onclick="Sair">@Icones.Sair<span>Sair</span></button>
            </div>
        }
        <button class="conta-btn" type="button" aria-haspopup="menu" aria-expanded="@_menu" title="@(Compacto ? $"{Conta.Usuario} · {StatusCurto}" : null)" @onclick="() => _menu = !_menu">
            <span class="conta-avatar @(Sincronizacao.Problema is not null || Conta.Offline ? "alerta" : "")">@Inicial</span>
            @if (!Compacto)
            {
                <span class="conta-texto"><b>@Conta.Usuario</b><small>@StatusCurto</small></span>
            }
        </button>
    }
</div>

@code {
    /// <summary>Só o avatar (barra do topo); o nome e o status vão para o topo do menu.</summary>
    [Parameter] public bool Compacto { get; set; }

    private bool _menu;
    private ElementReference _raiz;
    private IJSObjectReference? _fora;
    private DotNetObjectReference<ContaRodape>? _ponte;

    private string Inicial => Conta.Usuario is { Length: > 0 } u ? u[..1].ToUpperInvariant() : "?";

    // Linha curta embaixo do nome
    private string StatusCurto =>
        Conta.Offline ? "Sem conexão" :
        Sincronizacao.Problema is not null ? "Não sincronizado" :
        Sincronizacao.Sincronizando ? "Sincronizando…" :
        Sincronizacao.Ultima is DateTime u ? $"Sincronizado às {u:HH:mm}" : "Preparando…";

    // Explicação completa, no topo do menu
    private string StatusCompleto =>
        Sincronizacao.Problema ?? (Sincronizacao.Sincronizando ? "Sincronizando…" :
            Sincronizacao.Ultima is DateTime u ? $"Sincronizado às {u:HH:mm}. As mudanças vão sozinhas para os outros aparelhos." : "Preparando a sincronização…");

    // A sessão é renovada em segundo plano ao abrir o app e a sincronização muda o status: redesenha
    private void Mudou() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        Conta.Mudou += Mudou;
        Sincronizacao.Mudou += Mudou;
    }

    // Menu aberto: escuta o clique fora; fechado: para de escutar
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_menu && _fora is null)
        {
            _ponte ??= DotNetObjectReference.Create(this);
            _fora = await JS.InvokeAsync<IJSObjectReference>("crankohub.fecharAoClicarFora", _raiz, _ponte);
        }
        else if (!_menu && _fora is not null)
            await PararDeEscutar();
    }

    [JSInvokable]
    public void FecharMenu()
    {
        if (!_menu) return;
        _menu = false;
        StateHasChanged();
    }

    private async Task PararDeEscutar()
    {
        var fora = _fora;
        _fora = null;
        if (fora is null) return;
        try
        {
            await fora.InvokeVoidAsync("parar");
            await fora.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        Conta.Mudou -= Mudou;
        Sincronizacao.Mudou -= Mudou;
        await PararDeEscutar();
        _ponte?.Dispose();
    }

    private void AbrirInformacoes()
    {
        _menu = false;
        Nav.NavigateTo("conta");
    }

    private async Task SincronizarAgora()
    {
        _menu = false;
        await Sincronizacao.Sincronizar();
    }

    private async Task Sair()
    {
        _menu = false;
        if (!await Dialogo.Confirmar("Sair da conta?\nAs mudanças pendentes são enviadas antes. O app reinicia na tela de login. Os dados continuam na conta.")) return;
        await Sincronizacao.Sincronizar();
        await Conta.Sair();
        AtualizacaoService.Reiniciar();
    }
}
