@namespace CrankoHub.Components
@* Configurações do Carro (engrenagem no topo da página Carro, só no celular): o aviso de radar do Modo Carro,
   o Bluetooth do carro e "onde estacionei". As permissões do Android ficam em Configurações → Modo Carro. *@
@implements IDisposable
@inject ArmazenamentoService Store
@inject CarroBluetoothService Bluetooth
@inject RadaresSp Radares
@inject ModoCarroService Modo
@inject ToastService Toast

@{
    var cfg = Store.Dados.Config;
    var permissoes = Bluetooth.Permissoes();
    var faltam = permissoes.Where(p => p.Necessaria && p.Ativada == false).ToList();
}

<div class="modal-backdrop" @onclick="Fechar">
    <div class="card modal modal-medio" @onclick:stopPropagation="true">
        <div><h2>@Icones.Engrenagem Configurações do Carro</h2><p class="muted">Valem só para esta seção. As do app ficam em Configurações, no menu.</p></div>

        @if (faltam.Count > 0)
        {
            <div class="mc-cfg-alerta" role="status">
                <b>Falta @(faltam.Count == 1 ? "ativar 1 permissão" : $"ativar {faltam.Count} permissões") do Modo Carro.</b>
                <span>@string.Join(", ", faltam.Select(p => p.Nome)). Veja em <a href="configuracoes?aba=carro#permissoes-carro" @onclick="Fechar">Configurações → Modo Carro</a>.</span>
            </div>
        }

        <section class="cfg-carro-bloco">
            <h3>Aviso de radar</h3>
            <p class="muted">Com o Modo Carro ativo, aparece por cima do Google Maps ou do Waze quando há um radar a até @Distancia(cfg.AvisoRadarDistancia) à frente: a velocidade dele e quantos metros faltam. Fica vermelho se você estiver acima do limite.</p>

            <span class="lc-rotulo">Avisar a partir de</span>
            <div class="chips" role="radiogroup" aria-label="Distância do aviso de radar">
                @foreach (var m in Distancias)
                {
                    var metros = m;
                    <button type="button" role="radio" aria-checked="@(cfg.AvisoRadarDistancia == metros)" class="chip @(cfg.AvisoRadarDistancia == metros ? "active" : "")" @onclick="() => MudarInt(v => cfg.AvisoRadarDistancia = v, metros)">@Distancia(metros)</button>
                }
            </div>

            <span class="lc-rotulo">Tempo na tela</span>
            <div class="chips" role="radiogroup" aria-label="Tempo do aviso de radar na tela">
                @foreach (var (seg, rotulo) in Tempos)
                {
                    var segundos = seg;
                    <button type="button" role="radio" aria-checked="@(cfg.AvisoRadarTempo == segundos)" class="chip @(cfg.AvisoRadarTempo == segundos ? "active" : "")" @onclick="() => MudarInt(v => cfg.AvisoRadarTempo = v, segundos)">@rotulo</button>
                }
            </div>

            <span class="lc-rotulo">Posição na borda esquerda</span>
            <div class="chips" role="radiogroup" aria-label="Posição do aviso de radar">
                @foreach (var (valor, rotulo) in Posicoes)
                {
                    var ativa = PosicoesAvisoRadar.Valida(cfg.AvisoRadarPosicao) == valor;
                    <button type="button" role="radio" aria-checked="@ativa" class="chip @(ativa ? "active" : "")" @onclick="() => MudarPosicao(valor)">@rotulo</button>
                }
            </div>

            <div class="opcoes">
                <label class="check"><input type="checkbox" checked="@cfg.AvisoRadarSom" @onchange="@(e => Mudar(e, v => cfg.AvisoRadarSom = v))"> <span>Tocar um som quando aparece um radar <span class="muted">· não pausa a música</span></span></label>
            </div>
            @if (cfg.AvisoRadarSom)
            {
                var tom = TonsAvisoRadar.Valido(cfg.AvisoRadarTom);
                <div class="chips" role="radiogroup" aria-label="Som do aviso de radar">
                    @foreach (var (valor, nome) in TonsAvisoRadar.Todos)
                    {
                        var opcao = valor;
                        <button type="button" role="radio" aria-checked="@(tom == opcao)" class="chip @(tom == opcao ? "active" : "")" @onclick="() => MudarTom(opcao)">@nome</button>
                    }
                    <button type="button" class="btn" @onclick="() => Modo.TocarAviso(tom)">Testar</button>
                </div>
            }

            <div class="lc-linha">
                <span><b>@(Radares.Total > 0 ? $"{Radares.Total:N0} radares no estado de SP" : "Radares ainda não baixados")</b>
                    <span class="muted">· @(Radares.Baixando ? "baixando…" : string.Join(" · ", FontesRadar.Exibir.Select(Resumo)))</span></span>
                <button type="button" class="btn" disabled="@Radares.Baixando" @onclick="AtualizarRadares">Atualizar agora</button>
            </div>
        </section>

        <section class="cfg-carro-bloco">
            <h3>Bluetooth do carro</h3>
            <p class="muted">Marque a central do carro: o CrankoHub percebe quando o celular conecta (carro ligado) e desconecta (carro desligado).</p>
            @if (Pendente(permissoes, PermissoesCarro.Bluetooth) is { } pb)
            {
                <PermissaoLinha Permissao="pb" AoAtivar="Bluetooth.Ativar" />
            }
            else
            {
                var pareados = Bluetooth.Pareados();
                var antigos = cfg.CarrosBluetooth.Where(c => pareados.All(p => !MesmoEndereco(p.Endereco, c.Endereco))).ToList();
                <div class="opcoes" role="group" aria-label="Aparelhos Bluetooth pareados">
                    @if (pareados.Count == 0 && antigos.Count == 0)
                    {
                        <p class="muted">Nenhum aparelho pareado. Pareie a central nas configurações de Bluetooth do Android e volte aqui.</p>
                    }
                    @foreach (var a in pareados)
                    {
                        var aparelho = a;
                        var marcado = cfg.CarrosBluetooth.Any(c => MesmoEndereco(c.Endereco, aparelho.Endereco));
                        <label class="check" @key="aparelho.Endereco"><input type="checkbox" checked="@marcado" @onchange="e => MarcarCarro(aparelho, e.Value is true)">
                            <span><b>@aparelho.Nome</b> <span class="muted">· @(aparelho.Audio ? "som / central" : "outro aparelho")</span></span></label>
                    }
                    @foreach (var c in antigos)
                    {
                        var carro = c;
                        <div class="lc-linha" @key="carro.Endereco">
                            <span><b>@carro.Nome</b> <span class="muted">· não está mais pareado</span></span>
                            <button type="button" class="btn" aria-label="Remover @carro.Nome" @onclick="() => RemoverCarro(carro)">Remover</button>
                        </div>
                    }
                </div>
            }

            <span class="lc-rotulo">Ao ligar o carro</span>
            <div class="chips" role="radiogroup" aria-label="Ao ligar o carro">
                @foreach (var (valor, rotulo) in AcoesAoConectar)
                {
                    <button type="button" role="radio" aria-checked="@(cfg.AoConectarCarro == valor)" class="chip @(cfg.AoConectarCarro == valor ? "active" : "")" @onclick="() => MudarAoConectar(valor)">@rotulo</button>
                }
            </div>
            <span class="muted">@(cfg.AoConectarCarro switch
            {
                AcoesConexao.Abrir => "Abre a tela do Modo Carro sozinha (escolher o destino). Com o celular bloqueado, espera você desbloquear.",
                AcoesConexao.Notificar => "Aparece a notificação \"Modo Carro pronto\": toque para abrir.",
                _ => "Não faz nada ao ligar o carro.",
            })</span>
            @if (cfg.AoConectarCarro == AcoesConexao.Abrir && Pendente(permissoes, PermissoesCarro.Sobrepor) is { } ps)
            {
                <PermissaoLinha Permissao="ps" AoAtivar="Bluetooth.Ativar" />
            }
            <div class="opcoes">
                <label class="check"><input type="checkbox" checked="@cfg.SairAoDesconectar" @onchange="@(e => Mudar(e, v => cfg.SairAoDesconectar = v))"> <span>Sair do Modo Carro ao desligar o carro <span class="muted">· tira o aviso de radar</span></span></label>
            </div>
        </section>

        <section class="cfg-carro-bloco">
            <h3>Onde estacionei</h3>
            <p class="muted">Quando o Bluetooth do carro desconecta, o CrankoHub guarda onde o carro ficou: aparece numa notificação e no Início, com o caminho a pé no Google Maps.</p>
            <div class="opcoes">
                <label class="check"><input type="checkbox" checked="@cfg.LembrarEstacionado" @onchange="@(e => Mudar(e, v => cfg.LembrarEstacionado = v))"> <span>Lembrar onde estacionei <span class="muted">· usa o GPS com o Modo Carro ativo</span></span></label>
                @if (cfg.LembrarEstacionado)
                {
                    <label class="check"><input type="checkbox" checked="@cfg.EstacionadoComAppFechado" @onchange="@(e => Mudar(e, v => cfg.EstacionadoComAppFechado = v))"> <span>Funcionar também sem o Modo Carro ativo <span class="muted">· precisa da localização "o tempo todo"</span></span></label>
                }
            </div>
            @if (cfg.LembrarEstacionado && cfg.EstacionadoComAppFechado && Pendente(permissoes, PermissoesCarro.LocalizacaoSempre) is { } pl)
            {
                <PermissaoLinha Permissao="pl" AoAtivar="Bluetooth.Ativar" />
            }
            @if (cfg.Estacionado is { } est)
            {
                <div class="lc-linha">
                    <span><b>Carro estacionado</b> <span class="muted">· @(est.Endereco ?? "endereço não encontrado") · @est.Quando.ToString("dd/MM HH:mm")</span></span>
                    <button type="button" class="btn" @onclick="Bluetooth.ComoChegar">Como chegar</button>
                    <button type="button" class="btn" @onclick="Bluetooth.EsquecerEstacionado">Esquecer</button>
                </div>
            }
        </section>

        <div class="form-actions">
            <button class="btn primary" type="button" @onclick="Fechar">Fechar</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback AoFechar { get; set; }

    private static readonly (string Valor, string Rotulo)[] AcoesAoConectar =
        [(AcoesConexao.Nada, "Nada"), (AcoesConexao.Notificar, "Notificação"), (AcoesConexao.Abrir, "Abrir direto")];

    private static readonly int[] Distancias = [300, 500, 1000, 1500, 2000];

    private static readonly (int Segundos, string Rotulo)[] Tempos = [(0, "Até passar pelo radar"), (5, "5 s"), (10, "10 s"), (15, "15 s"), (30, "30 s")];

    private static string Distancia(int metros) => metros >= 1000 ? $"{metros / 1000.0:0.#} km" : $"{metros} m";

    /// <summary>"DER (rodovias) 1.257, 13/11" — ou "não baixado".</summary>
    private string Resumo(string fonte) => fonte == FontesRadar.Piracicaba
        ? $"{FontesRadar.Nome(fonte)} {Radares.Contagem(fonte):N0}, lista do app"
        : $"{FontesRadar.Nome(fonte)} {(Radares.Atualizado(fonte) is { } quando ? $"{Radares.Contagem(fonte):N0}, {quando:dd/MM}" : "não baixado")}";

    private void MudarInt(Action<int> aplicar, int valor)
    {
        aplicar(valor);
        Store.Salvar();
    }

    private void MudarTom(string tom)
    {
        Store.Dados.Config.AvisoRadarTom = tom;
        Store.Salvar();
        Modo.TocarAviso(tom);
    }

    private static readonly (string Valor, string Rotulo)[] Posicoes =
        [(PosicoesAvisoRadar.Cima, "Em cima"), (PosicoesAvisoRadar.Meio, "No meio"), (PosicoesAvisoRadar.Baixo, "Embaixo")];

    // As permissões mudam fora do app (telas do Android) e o carro estacionado chega pelo Bluetooth
    protected override void OnInitialized()
    {
        Bluetooth.Mudou += Redesenhar;
        Radares.Mudou += Redesenhar;
    }

    private void Redesenhar() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Bluetooth.Mudou -= Redesenhar;
        Radares.Mudou -= Redesenhar;
    }

    private Task Fechar() => AoFechar.InvokeAsync();

    /// <summary>A permissão, se ainda falta ativar (null = já ativada ou não dá para conferir).</summary>
    private static PermissaoCarro? Pendente(IReadOnlyList<PermissaoCarro> lista, string id) =>
        lista.FirstOrDefault(p => p.Id == id && p.Ativada == false);

    private static bool MesmoEndereco(string a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    private void MudarPosicao(string posicao)
    {
        Store.Dados.Config.AvisoRadarPosicao = posicao;
        Store.Salvar();
    }

    private async Task AtualizarRadares()
    {
        await Radares.Atualizar(forcar: true);
        var falharam = FontesRadar.Todas.Where(f => Radares.Atualizado(f) is not { } q || DateTime.Now - q > TimeSpan.FromMinutes(2)).ToList();
        if (falharam.Count == 0) Toast.Ok($"{Radares.Total:N0} radares atualizados.");
        else Toast.Erro($"Não deu para baixar agora: {string.Join(", ", falharam.Select(FontesRadar.Nome))}. Os que já estavam continuam valendo.");
    }

    private void MarcarCarro(AparelhoBluetooth aparelho, bool marcado)
    {
        var carros = Store.Dados.Config.CarrosBluetooth;
        carros.RemoveAll(c => MesmoEndereco(c.Endereco, aparelho.Endereco));
        if (marcado) carros.Add(new CarroPareado(aparelho.Endereco, aparelho.Nome));
        Store.Salvar();
        if (marcado) Toast.Ok($"{aparelho.Nome} marcado como o seu carro.");
    }

    private void RemoverCarro(CarroPareado carro)
    {
        Store.Dados.Config.CarrosBluetooth.Remove(carro);
        Store.Salvar();
    }

    private void MudarAoConectar(string valor)
    {
        Store.Dados.Config.AoConectarCarro = valor;
        Store.Salvar();
    }

    private void Mudar(ChangeEventArgs e, Action<bool> aplicar)
    {
        aplicar(e.Value is true);
        Store.Salvar();
    }
}
