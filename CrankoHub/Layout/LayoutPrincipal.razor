@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ArmazenamentoService Store
@inject NavegacaoService Navegacao
@inject JanelaService Janela
@inject ToastService Toast
@inject SincronizacaoService Sincronizacao
@inject BandejaService Bandeja

<div class="app @(_menuAberto ? "menu-open" : "") @(Store.Dados.Config.MenuOculto ? "menu-oculto" : "")">
    <aside class="sidebar">
        <div class="brand">
            <span class="logo">@Icones.Logo</span>
            <span class="brand-name">CrankoHub</span>
        </div>
        <nav class="nav">
            <NavLink href="" Match="NavLinkMatch.All"><span class="tile">@Icones.Inicio</span><span>Início</span></NavLink>
            @if (Modulo.Visiveis(Store.Dados.Config).Any())
            {
                <div class="nav-titulo">Áreas</div>
            }
            @foreach (var m in Modulo.Visiveis(Store.Dados.Config))
            {
                <NavLink @key="m.Id" href="@m.Link"><span class="tile" style="--c:@m.Cor">@m.Icone</span><span>@m.Nome</span></NavLink>
            }
            <div class="nav-sep"></div>
            <NavLink href="configuracoes"><span class="tile" style="--c:#8e8e93">@Icones.Engrenagem</span><span>Configurações</span></NavLink>
        </nav>
        @if (ContaService.Configurado)
        {
            <div class="sidebar-foot"><ContaRodape /></div>
        }
    </aside>
    <div class="backdrop" @onclick="() => _menuAberto = false"></div>

    <div class="main">
        @* O palco é quem rola; a barra de vidro fica fixa no topo dele, com a página passando por baixo *@
        <div class="palco" id="palco">
            <header class="topbar">
                <button class="icon-btn menu-btn" aria-label="Mostrar ou ocultar o menu" title="Mostrar ou ocultar o menu" @onclick="AlternarMenu">@Icones.Menu</button>
                <div class="crumb"><span class="crumb-root">CrankoHub</span><span class="crumb-sep">/</span><span>@TituloDaPagina</span></div>
                <nav class="atalhos" aria-label="Atalhos">
                    <NavLink href="" Match="NavLinkMatch.All" title="Início">@Icones.Inicio</NavLink>
                    @foreach (var m in Modulo.Visiveis(Store.Dados.Config))
                    {
                        <NavLink @key="m.Id" href="@m.Link" title="@m.Nome" style="@($"--c:{m.Cor}")">@m.Icone</NavLink>
                    }
                    <NavLink href="configuracoes" title="Configurações">@Icones.Engrenagem</NavLink>
                </nav>
                <button class="icon-btn" aria-label="Alternar tema claro/escuro" title="Alternar tema" @onclick="AlternarTema">@Icones.Lua@Icones.Sol</button>
            </header>
            @* A chave recria o container a cada navegação, reiniciando a animação de entrada *@
            <main class="content enter" @key="(_caminho, _recarregados)">
                @Body
            </main>
        </div>
    </div>
</div>

<Toasts />
<Confirmacao />

@code {
    private bool _menuAberto;
    private string _caminho = "";

    private string TituloDaPagina => _caminho switch
    {
        "dieta" => "Dieta",
        "carro" => "Carro",
        "assinaturas" => "Assinaturas",
        "entretenimento" => "Entretenimento",
        "tarefas" => "Tarefas",
        "configuracoes" or "dados" => "Configurações",
        _ => "Início",
    };

    protected override void OnInitialized()
    {
        _caminho = CaminhoAtual();
        Nav.LocationChanged += AoNavegar;
        Navegacao.AoNavegar += AbrirPagina;
        Store.ModulosMudaram += AtualizarMenu;
        Sincronizacao.NaTela = acao => InvokeAsync(acao);
        Sincronizacao.Recebeu += RecebeuDaConta;
    }

    // Chegaram mudanças da conta (outro aparelho): os dados já foram aplicados; recria a página e reaplica tema e cor
    private void RecebeuDaConta() => _ = InvokeAsync(async () =>
    {
        _recarregados++;
        StateHasChanged();
        Toast.Ok("Dados atualizados de outro aparelho.");
        await JS.InvokeVoidAsync("crankohub.aplicarTema", Store.Dados.Tema);
        Janela.TemaMudou(Store.Dados.Tema);
        var cor = CorDestaque.DaConfig(Store.Dados.Config.CorDestaque);
        await JS.InvokeVoidAsync("crankohub.aplicarDestaque", cor.Claro, cor.Escuro, cor.Texto);
        Bandeja.AplicarCor(cor.Claro);
    });

    private void AtualizarMenu() => _ = InvokeAsync(StateHasChanged);

    // Muda quando chegam dados de outro aparelho: recria a página aberta
    private int _recarregados;

    // Pedido vindo de fora do Blazor (ex.: clique numa notificação)
    private void AbrirPagina(string link) => _ = InvokeAsync(() => Nav.NavigateTo(link));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await JS.InvokeVoidAsync("crankohub.aplicarTema", Store.Dados.Tema);
        var cor = CorDestaque.DaConfig(Store.Dados.Config.CorDestaque);
        await JS.InvokeVoidAsync("crankohub.aplicarDestaque", cor.Claro, cor.Escuro, cor.Texto);
    }

    private string CaminhoAtual() => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();

    private void AoNavegar(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(async () =>
    {
        _caminho = CaminhoAtual();
        _menuAberto = false;
        StateHasChanged();
        await JS.InvokeVoidAsync("crankohub.rolarParaTopo");
    });

    // Tela estreita (celular): o menu abre por cima e fecha ao navegar. Tela larga: o menu some e a página ocupa o espaço (fica guardado)
    private async Task AlternarMenu()
    {
        if (await JS.InvokeAsync<bool>("crankohub.telaPequena"))
        {
            _menuAberto = !_menuAberto;
            return;
        }
        Store.Dados.Config.MenuOculto = !Store.Dados.Config.MenuOculto;
        Store.Salvar();
    }

    private async Task AlternarTema()
    {
        Store.Dados.Tema = await JS.InvokeAsync<string>("crankohub.alternarTema");
        Janela.TemaMudou(Store.Dados.Tema);
        Store.Salvar();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= AoNavegar;
        Navegacao.AoNavegar -= AbrirPagina;
        Store.ModulosMudaram -= AtualizarMenu;
        Sincronizacao.Recebeu -= RecebeuDaConta;
        Sincronizacao.NaTela = null;
    }
}
